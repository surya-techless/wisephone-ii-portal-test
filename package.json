{
  "name": "wisephone-ii-portal",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --remote",
    "dev:remote": "astro dev --remote",
    "dev:host": "astro dev --remote --host",
    "dev:https": "HTTPS=true astro dev --remote",
    "dev:tunnel": "concurrently \"astro dev --remote\" \"ngrok http 4321 --log stdout\"",
    "tunnel": "ngrok http 4321",
    "update-packages": "npx npm-check-updates -u",
    "start": "astro dev",
    "build": "astro check && astro build --remote",
    "verifydb": "astro db verify --remote --json",
    "migratemysql": "npx drizzle-kit migrate",
    "preview": "astro preview",
    "db:update": "astro db push --remote",
    "format": "prettier -w .",
    "test:e2e": "playwright test",
    "test:gui": "playwright test --ui",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.14.1",
    "@alpinejs/focus": "^3.14.8",
    "@alpinejs/intersect": "^3.14.1",
    "@alpinejs/mask": "^3.14.1",
    "@alpinejs/persist": "^3.14.1",
    "@astrojs/alpinejs": "^0.4.0",
    "@astrojs/check": "^0.9.4",
    "@astrojs/db": "^0.14.3",
    "@astrojs/netlify": "^6.2.2",
    "@astrojs/rss": "^4.0.9",
    "@astrojs/tailwind": "^5.1.2",
    "@astrojs/web-vitals": "^3.0.0",
    "@aws-sdk/client-iot-data-plane": "^3.1037.0",
    "@clerk/astro": "^2.3.1",
    "@clerk/clerk-js": "^5.21.0",
    "@iconify-json/lucide": "^1.2.3",
    "@iconify-json/lucide-lab": "^1.2.0",
    "@netlify/functions": "^3.0.0",
    "@sentry/astro": "^9.2.0",
    "@stripe/stripe-js": "^5.9.2",
    "alpinejs": "^3.14.1",
    "astro": "^5.4.2",
    "astro-iconify": "^1.2.0",
    "astro-integration-lottie": "^0.3.1",
    "astro-seo": "^0.8.4",
    "aws-iot-device-sdk-v2": "1.26.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "0.45.2",
    "groq-sdk": "^0.7.0",
    "htmx.org": "2.0.1",
    "isbot": "^5.1.17",
    "isomorphic-dompurify": "^2.15.0",
    "js-confetti": "^0.12.0",
    "lottie-web": "^5.12.2",
    "marked": "^14.1.2",
    "mysql2": "3.22.5",
    "redis": "5.12.1",
    "stripe": "^17.7.0",
    "trix": "^2.1.6",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@clerk/testing": "^1.4.33",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/alpinejs": "^3.13.10",
    "@types/better-sqlite3": "^7.6.11",
    "concurrently": "^9.2.1",
    "daisyui": "^4.12.10",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^3.4.10",
    "tsx": "4.22.4",
    "typescript": "^5.6.2"
  },
  "private": true,
  "description": "A portal for the Wisephone II",
  "author": "Cameron Pak",
  "homepage": "https://portal.wisephone.com",
  "engines": {
    "node": "=22.22.3",
    "npm": ">=10.9.8"
  }
}
