---
import { SignedIn, SignedOut, SignInButton, SignUpButton } from "@clerk/astro/components";
import WisephoneLogo from "@/components/WisephoneLogo.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";

const { userId } = Astro.locals.auth();

if (userId) {
  return Astro.redirect("/dashboard");
}
---

<Layout
  title="Wisephone II Portal"
  description="Customize your Wisephone II experience for a healthier relationship with technology"
>
  <main class="relative overflow-hidden not-prose">
    <div
      class="container grid grid-rows-[1fr_auto] gap-12 py-12 justify-center items-center min-h-screen h-full mx-auto px-4 sm:px-6 lg:px-8"
    >
      <div class="flex flex-col items-center gap-4">
        <WisephoneLogo class="h-16 text-[var(--charcoal)]" />
        <p class="max-w-sm text-center text-balance">
          Customize your Wisephone II experience for a healthier relationship with technology.
        </p>
        <p class="max-w-sm text-sm text-center text-slate-500 text-balance">
          If this is your first time accessing the portal, please create a new account.
        </p>
        <div class="flex items-center gap-3" x-data="{ showAgeModal: false, isOver18: $persist(false) }">
          <SignedOut>
            <SignInButton mode="modal" forceRedirectUrl="/dashboard" asChild>
              <button
                x-cloak
                x-show="isOver18"
                @click="showAgeModal = false"
                class="btn btn-primary"
                :disabled="!isOver18">Sign in</button
              >
            </SignInButton>
            <SignUpButton mode="modal" forceRedirectUrl="/dashboard" asChild>
              <button
                x-cloak
                x-show="isOver18"
                @click="showAgeModal = false"
                class="btn btn-ghost"
                :disabled="!isOver18">Sign up</button
              >
            </SignUpButton>
            <button x-cloak x-transition x-show="!isOver18" @click="showAgeModal = true" class="btn btn-primary"
              >Get Started</button
            >

            <!-- Age Verification Modal -->
            <dialog id="age_verification_modal" class="modal" :open="showAgeModal">
              <div class="modal-box">
                <h3 class="text-lg font-bold mb-4">Before we get started</h3>

                <form method="dialog" class="space-y-6" @submit.prevent>
                  <div class="form-control">
                    <label class="grid grid-cols-[1fr_auto] cursor-pointer label items-start justify-start gap-3">
                      <input
                        type="checkbox"
                        x-model="isOver18"
                        class="checkbox checkbox-primary border-2 border-slate-200 hover:border-slate-200 [&:checked]:border-[var(--evergreen)]"
                        style="--chkbg: var(--evergreen); --chkfg: white;"
                      />
                      <span class="label-text"
                        >I certify that I am 18 years of age or older and will only add myself and/or my children, who
                        are under 18 and my legal dependents, to this account. I understand that I am responsible for
                        managing all devices on my account.
                      </span>
                    </label>
                  </div>

                  <div class="modal-action flex gap-2">
                    <button class="btn btn-ghost" @click="showAgeModal = false; isOver18 = false">Cancel</button>
                    <button class="btn btn-primary" :disabled="!isOver18" @click="showAgeModal = false; isOver18 = true"
                      >Continue</button
                    >
                  </div>
                </form>
              </div>
              <form method="dialog" class="modal-backdrop bg-[#000000ba]">
                <button @click="showAgeModal = false; isOver18 = false">close</button>
              </form>
            </dialog>
          </SignedOut>
          <SignedIn>
            <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
          </SignedIn>
        </div>
      </div>
      <Footer showLogo={false} />
    </div>
  </main>
</Layout>
