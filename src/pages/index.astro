---
import { SignedIn, SignedOut, SignInButton, SignUpButton } from "@clerk/astro/components";
import WisephoneLogo from "@/components/WisephoneLogo.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Wisephone II Portal"
  description="Customize your Wisephone II experience for a healthier relationship with technology"
>
  <main class="relative overflow-hidden not-prose">
    <div
      class="container grid grid-rows-[1fr_auto] gap-12 py-12 justify-center items-center min-h-screen h-full mx-auto px-4 sm:px-6 lg:px-8"
    >
      <div class="flex flex-col items-center gap-4">
        <WisephoneLogo class="h-16 text-[var(--charcoal)]" />
        <p class="max-w-sm text-center text-balance">
          Customize your Wisephone II experience for a healthier relationship with technology.
        </p>
        <p class="max-w-sm text-sm text-center text-slate-500 text-balance">
          If this is your first time accessing the portal, please create a new account.
        </p>
        <div class="flex items-center gap-3">
          <SignedOut>
            <SignInButton asChild mode="modal" forceRedirectUrl="/dashboard">
              <button class="btn btn-primary">Sign in</button>
            </SignInButton>
            <SignUpButton asChild mode="modal" forceRedirectUrl="/dashboard">
              <button class="btn btn-ghost">Sign up</button>
            </SignUpButton>
          </SignedOut>
          <SignedIn>
            <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
          </SignedIn>
        </div>
      </div>
      <Footer showLogo={false} />
    </div>
  </main>
</Layout>
