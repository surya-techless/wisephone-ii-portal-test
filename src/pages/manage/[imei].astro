                formatPhoneNumber(event: Event) {
                  const input = event.target as HTMLInputElement;
                  const cursorPosition = input.selectionStart || 0;
                  let value = input.value.replace(/\D/g, ""); // Remove all non-digits (accepts both formats)

                  // Limit to 10 digits
                  if (value.length > 10) {
                    value = value.slice(0, 10);
                  }

                  // Format as XXX-XXX-XXXX
                  let formatted = "";
                  if (value.length > 6) {
                    formatted = value.slice(0, 3) + "-" + value.slice(3, 6) + "-" + value.slice(6, 10);
                  } else if (value.length > 3) {
                    formatted = value.slice(0, 3) + "-" + value.slice(3);
                  } else {
                    formatted = value;
                  }

                  this.editPhoneNumber = formatted;

                  // Restore cursor position after formatting
                  // Adjust cursor position based on added dashes
                  let newCursorPosition = cursorPosition;
                  const beforeCursor = input.value.substring(0, cursorPosition);
                  const digitsBeforeCursor = beforeCursor.replace(/\D/g, "").length;

                  // Calculate new position accounting for dashes
                  if (digitsBeforeCursor > 6) {
                    newCursorPosition = digitsBeforeCursor + 2; // Two dashes before
                  } else if (digitsBeforeCursor > 3) {
                    newCursorPosition = digitsBeforeCursor + 1; // One dash before
                  } else {
                    newCursorPosition = digitsBeforeCursor;
                  }

                  // Ensure cursor doesn't exceed formatted length
                  newCursorPosition = Math.min(newCursorPosition, formatted.length);

                  // Use setTimeout to ensure DOM is updated before setting cursor
                  setTimeout(() => {
                    input.setSelectionRange(newCursorPosition, newCursorPosition);
                  }, 0);
                },

                openEditModal() {
                  this.editName = this.deviceName;
                  this.editImei = this.imei;
                  // Format phone number when opening modal
                  const phoneDigits = this.devicePhone.replace(/\D/g, "");
                  if (phoneDigits.length === 10) {
                    this.editPhoneNumber = `${phoneDigits.slice(0, 3)}-${phoneDigits.slice(3, 6)}-${phoneDigits.slice(6)}`;
                  } else {
                    this.editPhoneNumber = this.devicePhone;
                  }
                  this.showEditModal = true;
                },

                closeEditModal() {
                  this.showEditModal = false;
                  // Reset form fields
                  this.editName = "";
                  this.editImei = "";
                  this.editPhoneNumber = "";
                },

                async saveDeviceDetails() {
                  try {
                    // Validate device name length (max 15 characters)
                    const trimmedName = this.editName.trim();
                    if (trimmedName.length > 15) {
                      this.showErrorToast(
                        "The name of the device is too long. Please limit the name to 15 characters."
                      );
                      return;
                    }

                    // Clean phone number (remove dashes, keep only digits)
                    const cleanedPhoneNumber = this.editPhoneNumber.replace(/\D/g, "");

                    // Validate phone number format (should be 10 digits)
                    if (cleanedPhoneNumber.length !== 10 && cleanedPhoneNumber.length > 0) {
                      this.showErrorToast("Phone number must be 10 digits");
                      return;
                    }

                    // Format phone number for API (must be in format 123-456-7890 for validation)
                    const formattedPhoneNumber =
                      cleanedPhoneNumber.length === 10
                        ? `${cleanedPhoneNumber.slice(0, 3)}-${cleanedPhoneNumber.slice(3, 6)}-${cleanedPhoneNumber.slice(6)}`
                        : this.editPhoneNumber;

                    // Create form data for submission
                    const formData = new FormData();
                    formData.append("imei", this.imei);
                    formData.append("nickname", this.editName.trim() || "Device");
                    formData.append("phoneNumber", formattedPhoneNumber);

                    // Submit via fetch to the update action
                    const response = await fetch("/_actions/wisephones.updateWisephone", {
                      method: "POST",
                      body: formData
                    });

                    if (response.ok) {
                      // Format phone number for display
                      const formattedPhone =
                        cleanedPhoneNumber.length === 10
                          ? `${cleanedPhoneNumber.slice(0, 3)}-${cleanedPhoneNumber.slice(3, 6)}-${cleanedPhoneNumber.slice(6)}`
                          : this.editPhoneNumber;

                      // Update local state
                      this.deviceName = this.editName.trim() || "Device";
                      this.devicePhone = formattedPhone;
                      this.originalDeviceName = this.deviceName;
                      this.originalDevicePhone = this.devicePhone;

                      // Close modal
                      this.closeEditModal();

                      // Re-check subscription status with new phone number (reusing same logic as page load)
                      // The page load checks: 1) bypassTechlessSubscription, 2) validateIsSubscribed
                      // We use the validateIsUserSubscribed action which calls validateIsSubscribed
                      console.log("[DEBUG] Re-checking subscription after phone number update", {
                        imei: this.imei,
                        phoneNumber: formattedPhoneNumber
                      });

                      try {
                        // Use the existing action that mirrors the page load subscription check
                        // This action calls validateIsSubscribed (same as page load logic)
                        const subscriptionResult = await actions.wisephones.validateIsUserSubscribed.orThrow({
                          imei: this.imei,
                          phoneNumber: formattedPhoneNumber
                        });

                        const hasSubscription = subscriptionResult?.isSubscribed === true;

                        console.log("[DEBUG] Subscription check result:", {
                          isSubscribed: hasSubscription,
                          subscriptionResult
                        });

                        if (!hasSubscription) {
                          // No subscription found, close manage page and redirect to dashboard immediately
                          // The dashboard will show "Activate Plan" button for this device
                          window.location.href = "/dashboard";
                          return;
                        } else {
                          // Subscription found, update local state
                          this.isSubscribed = true;
                          this.showSuccessToast("Device details updated successfully");
                        }
                      } catch (subscriptionError) {
                        console.error("[DEBUG] Error checking subscription:", subscriptionError);
                        // Continue anyway, subscription check failed but device was updated
                        this.showSuccessToast("Device details updated successfully");
                      }
                    } else {
                      // Try to parse error response for validation messages
                      try {
                        const errorData = await response.json();
                        if (errorData?.error?.message) {
                          this.showErrorToast(errorData.error.message);
                        } else {
                          this.showErrorToast("Failed to update device. Please try again.");
                        }
                      } catch (parseError) {
                        console.error("Failed to update device");
                        this.showErrorToast("Failed to update device. Please try again.");
                      }
                    }
                  } catch (error) {
                    console.error("Error updating device:", error);
                    this.showErrorToast("An error occurred while updating the device.");
                  }
                },

                async toggleFeature(feature: Feature) {
                  try {
                    if (!this.isSubscribed) {
                      throw new Error("Active subscription required");
                    }

                    // Use isFeatureEnabledForFeature to properly handle inverse features and A16 devices
                    const currentEnabled = this.isFeatureEnabledForFeature(feature);
                    const updatedValue = !currentEnabled;

                    // Store the pending feature change
                    this.pendingFeature = feature;
                    this.pendingFeatureEnabled = updatedValue;

                    // Set the confirmation message based on whether we're enabling or disabling
                    this.confirmationMessage = currentEnabled ? feature.disableMessage : feature.enableMessage;

                    // Show the confirmation modal
                    this.showConfirmModal = true;
                  } catch (error) {
                    console.error("Feature toggle failed:", error);
                    this.showErrorToast(error instanceof Error ? error.message : "Feature update failed");
                  }
                },

                async confirmFeatureToggle() {
                  try {
                    const feature = this.pendingFeature;
                    const updatedValue = this.pendingFeatureEnabled;

                    // Safety check
                    if (!feature) {
                      console.error("No pending feature found");
                      this.showConfirmModal = false;
                      return;
                    }

                    // Close modal
                    this.showConfirmModal = false;

                    // For inverse features, we need to invert the enabled value when calling the API
                    // because the knoxManageId represents a "disable" group
                    // - To enable the feature (allow hotspot/reset), we remove the disable group (enabled: false)
                    // - To disable the feature (block hotspot/reset), we add the disable group (enabled: true)
                    const isInverse = feature.isInverse || false;
                    const apiEnabled = isInverse ? !updatedValue : updatedValue;

                    // Determine device type and use appropriate group ID
                    const isA16 = this.isA16Device();

                    await featureManagement.toggleFeature({
                      imei: this.imei,
                      feature,
                      enabled: apiEnabled,
                      isA16Device: isA16
                    });

                    // Update local features array
                    // For inverse features: when enabling, remove from array; when disabling, add to array
                    // For normal features: when enabling, add to array; when disabling, remove from array
                    // Use the correct group ID based on device type (A16 or A15)
                    const correctGroupId =
                      isA16 && feature.a16KnoxManageId ? feature.a16KnoxManageId : feature.knoxManageId;

                    if (isInverse) {
                      if (updatedValue) {
                        // Enabling: remove both regular and A16 disable groups from the array
                        this.features = this.features.filter(
                          (id) => id !== feature.knoxManageId && id !== feature.a16KnoxManageId
                        );
                      } else {
                        // Disabling: add the correct disable group to the array based on device type
                        if (!this.features.includes(correctGroupId)) {
                          this.features.push(correctGroupId);
                        }
                      }
                    } else {
                      // Normal feature logic
                      if (!updatedValue) {
                        // Disabling: remove both regular and A16 IDs from the array
                        this.features = this.features.filter(
                          (id) => id !== feature.knoxManageId && id !== feature.a16KnoxManageId
                        );
                      } else {
                        // Enabling: add the correct feature group to the array based on device type
                        if (!this.features.includes(correctGroupId)) {
                          this.features.push(correctGroupId);
                        }
                      }
                    }

                    this.showSuccessToast(
                      updatedValue
                        ? `Your device is being updated. ${feature.name} will be enabled shortly.`
                        : `Your device is being updated. ${feature.name} will be disabled shortly.`
                    );

                    // Reset pending feature
                    this.pendingFeature = null;
                    this.pendingFeatureEnabled = false;
                  } catch (error) {
                    console.error("Feature toggle failed:", error);
                    this.showErrorToast(error instanceof Error ? error.message : "Feature update failed");
                    // Reset pending feature
                    this.pendingFeature = null;
                    this.pendingFeatureEnabled = false;
                  }
                },

                cancelFeatureToggle() {
                  this.showConfirmModal = false;
                  this.pendingFeature = null;
                  this.pendingFeatureEnabled = false;
                  this.confirmationMessage = "";
                },

                async installApp(packageName: string) {
                  try {
                    if (!packageName) {
                      throw new Error("Invalid app selected");
                    }

                    // Store pending app info
                    this.pendingAppToInstall = packageName;
                    this.pendingAppName = this.appsList[packageName]?.name || packageName;

                    // Show confirmation modal
                    this.showAppInstallModal = true;
                  } catch (error) {
                    console.error("Failed to show install confirmation:", error);
                    this.showErrorToast("Failed to show install confirmation");
                  }
                },

                async confirmAppInstall() {
                  try {
                    const packageName = this.pendingAppToInstall;

                    console.log("[DEBUG] confirmAppInstall called", {
                      packageName,
                      imei: this.imei,
                      imeiType: typeof this.imei,
                      imeiLength: this.imei?.length,
                      pendingAppToInstall: this.pendingAppToInstall,
                      appsListHasApp: packageName ? !!this.appsList[packageName] : false
                    });

                    if (!packageName) {
                      console.error("[DEBUG] No pending app to install");
                      this.showAppInstallModal = false;
                      return;
                    }

                    if (!this.imei) {
                      console.error("[DEBUG] IMEI is not set!", {
                        imei: this.imei,
                        imeiType: typeof this.imei
                      });
                      this.showErrorToast("IMEI is not set. Please refresh the page.");
                      this.showAppInstallModal = false;
                      return;
                    }

                    // Close modal
                    this.showAppInstallModal = false;

                    // If app is not in appsList yet, add it
                    if (!this.appsList[packageName]) {
                      console.log("[DEBUG] App not in appsList, adding it:", packageName);
                      this.appsList[packageName] = {
                        source: "Tool Drawer",
                        installed: false,
                        name: packageName
                      };
                    }

                    console.log("[DEBUG] Calling appManagement.installApp", {
                      imei: this.imei,
                      packageName: packageName
                    });

                    await appManagement.installApp(this.imei, packageName);

                    console.log("[DEBUG] appManagement.installApp completed successfully");

                    this.appsList[packageName].installed = true;

                    // Add to installedApps array if not already there
                    if (!this.installedApps.some((app) => app.packageName === packageName)) {
                      this.installedApps.push({
                        packageName,
                        appName: this.appsList[packageName].name,
                        isGoogleManaged: "Y"
                      });
                    }

                    // Update cached total apps count
                    this.updateCachedTotalApps();

                    this.showSuccessToast(`${this.appsList[packageName].name} will be installed shortly`);

                    // Clear pending app
                    this.pendingAppToInstall = null;
                    this.pendingAppName = "";
                  } catch (error) {
                    console.error("[DEBUG] App installation failed:", {
                      error,
                      errorMessage: error instanceof Error ? error.message : String(error),
                      errorStack: error instanceof Error ? error.stack : undefined,
                      imei: this.imei,
                      packageName: this.pendingAppToInstall
                    });
                    this.showErrorToast("Failed to install app");
                  }
                },

                cancelAppInstall() {
                  this.showAppInstallModal = false;
                  this.pendingAppToInstall = null;
                  this.pendingAppName = "";
                },

                async uninstallApp(packageName: string) {
                  try {
                    if (!packageName) {
                      throw new Error("Invalid app selected");
                    }

                    // Get the app name
                    const appName =
                      this.appsList[packageName]?.name ||
                      this.installedApps.find((app) => app.packageName === packageName)?.appName ||
                      packageName;

                    // Store pending app info
                    this.pendingAppToUninstall = packageName;
                    this.pendingAppToUninstallName = appName;

                    // Show confirmation modal
                    this.showAppUninstallModal = true;
                  } catch (error) {
                    console.error("Failed to show uninstall confirmation:", error);
                    this.showErrorToast("Failed to show uninstall confirmation");
                  }
                },

                async confirmAppUninstall() {
                  try {
                    const packageName = this.pendingAppToUninstall;

                    if (!packageName) {
                      console.error("No pending app to uninstall");
                      this.showAppUninstallModal = false;
                      return;
                    }

                    // Close modal
                    this.showAppUninstallModal = false;

                    await appManagement.uninstallApp(this.imei, packageName);
                    if (this.appsList[packageName]) {
                      this.appsList[packageName].installed = false;
                    }
                    // Update installedApps array
                    this.installedApps = this.installedApps.filter((app) => app.packageName !== packageName);

                    // Update cached total apps count
                    this.updateCachedTotalApps();

                    this.showSuccessToast(`App will be uninstalled shortly`);

                    // Clear pending app
                    this.pendingAppToUninstall = null;
                    this.pendingAppToUninstallName = "";
                  } catch (error) {
                    console.error("App uninstallation failed:", error);
                    this.showErrorToast("Failed to uninstall app");
                  }
                },

                cancelAppUninstall() {
                  this.showAppUninstallModal = false;
                  this.pendingAppToUninstall = null;
                  this.pendingAppToUninstallName = "";
                },

                // Load Tool Drawer apps from API (similar to device/[imei].astro)
                async loadToolDrawer() {
                  if (this.isToolDrawerLoaded || this.isToolDrawerLoading) {
                    return;
                  }

                  try {
                    this.isToolDrawerLoading = true;
                    const response = await fetch("/api/ottogrid.json");

                    if (!response.ok) {
                      throw new Error("Failed to load Tool Drawer data");
                    }

                    const data = await response.json();

                    // Process the data and update the appsList
                    if (data && data.rows && data.rows.length) {
                      const updatedAppsList = { ...this.appsList };

                      data.rows
                        .filter((row: any) => row && row.cells && row.cells["Tool Drawer"] === "Yes")
                        .forEach((row: any) => {
                          try {
                            const packageName = getPackageNameFromPlayStoreUrl(row.cells["Play Store URL"]);
                            if (!packageName) return;

                            // If the app is already in the list, preserve the installed status
                            const isInstalled = this.installedApps.some((app) => app.packageName === packageName);

                            updatedAppsList[packageName] = {
                              source: "Tool Drawer",
                              installed: isInstalled,
                              name: row.cells["Tool Name"] || "Unknown App"
                            };
                          } catch (error) {
                            console.error("Error processing app row:", error);
                          }
                        });

                      this.appsList = updatedAppsList;
                      this.isToolDrawerLoaded = true;
                    }
                  } catch (error) {
                    console.error("Error loading Tool Drawer:", error);
                    this.showErrorToast("Failed to load Tool Drawer apps");
                  } finally {
                    this.isToolDrawerLoading = false;
                  }
                },

                get completeSetupUrl() {
                  // Clean phone number (remove dashes) for the deeplink
                  const cleanedPhone = this.devicePhone.replace(/\D/g, "");
                  return `http://localhost?imei=${this.imei}&phone=${cleanedPhone}&subscription=done`;
                },

                get isToolDrawerEnabled() {
                  return (
                    this.isSubscribed &&
                    Array.isArray(this.features) &&
                    (this.features.includes(KNOX_USER_GROUPS.ADD_ON_TOOL_DRAWER) ||
                      this.features.includes(KNOX_USER_GROUPS.A16_ADD_ON_TOOL_DRAWER))
                  );
                },
                get isFaithToolsEnabled() {
                  return this.isSubscribed && this.features.includes(KNOX_USER_GROUPS.ADD_ON_FAITH_TOOLS);
                },

                isFeatureEnabled(knoxManageId: string, isInverse = false) {
                  const isEnabled = this.features.includes(knoxManageId);
                  return isInverse ? !isEnabled : isEnabled;
                },

                isFeatureEnabledForFeature(feature: Feature) {
                  // Check both regular and A16 IDs to support both device types
                  const hasRegularId = this.features.includes(feature.knoxManageId);
                  const hasA16Id = feature.a16KnoxManageId ? this.features.includes(feature.a16KnoxManageId) : false;
                  const isEnabled = hasRegularId || hasA16Id;
                  return feature.isInverse ? !isEnabled : isEnabled;
                },

                async init() {
                  // Load cached total apps count on initialization
                  this.loadCachedTotalApps();

                  // Watch for IMEI to be set before fetching features (same pattern as device/[imei].astro)
                  this.$watch("imei", async (value) => {
                    try {
                      if (this.imei) {
                        // Reload cached total apps when IMEI changes
                        this.loadCachedTotalApps();
                        await this.getFeatures();
                      }
                    } catch (error) {
                      console.error("Failed to load features:", error);
                      this.isLoading = false;
                    }
                  });

                  // Watch for currentTab changes - load apps when App Management tab is clicked
                  this.$watch("currentTab", async (newTab) => {
                    if (newTab === "app-management") {
                      // Open installed apps section by default when entering this tab
                      this.installedOpen = true;
                      // Load available apps immediately (fast, no API call)
                      if (!this.isAvailableAppsLoaded) {
                        this.loadAvailableApps();
                      }
                      // Fetch installed apps from API (slow, async)
                      if (!this.isAppsLoaded && !this.isAppsLoading) {
                        await this.getInstalledApps();
                      }
                    }
                  });

                  // Watch for appSearchQuery changes - collapse/expand installed apps section
                  this.$watch("appSearchQuery", (query) => {
                    if (query && query.trim().length > 0) {
                      // User is searching - collapse installed apps section
                      this.installedOpen = false;
                    } else {
                      // Search is cleared - reopen installed apps section
                      this.installedOpen = true;
                    }
                  });

                  // Watch for features changes to manage Knox groups and load Tool Drawer
                  this.$watch("features", async (userGroups: string[]) => {
                    // Check if device is subscribed but doesn't have any subscription group
                    if (this.isSubscribed) {
                      const hasSubscribedGroup =
                        userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                        userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                      if (!hasSubscribedGroup) {
                        // Assign appropriate subscription group based on device model
                        await this.assignSubscriptionGroupByDeviceModel();
                      }
                    }

                    // Ensure no conflicting Knox groups
                    await this.removeExclusiveGroups(userGroups);

                    // Load Tool Drawer data client-side when Tool Drawer feature is enabled
                    if (this.isToolDrawerEnabled && !this.isToolDrawerLoaded) {
                      this.loadToolDrawer();
                    }
                  });

                  // Watch for installedApps changes
                  this.$watch("installedApps", (apps) => {
                    this.logGoogleManagedApps();
                  });

                  // If IMEI is already set, fetch features immediately (but not apps - wait for tab click)
                  // This is the main blocking operation - keep loading until it completes
                  if (this.imei) {
                    try {
                      // getFeatures() will set isLoading = false when done
                      await this.getFeatures();
                    } catch (error) {
                      console.error("Failed to load features:", error);
                      this.isLoading = false;
                    }
                  } else {
                    // If no IMEI, don't show loading
                    this.isLoading = false;
                  }

                  // Log all Google-managed apps excluding system apps
                  this.logGoogleManagedApps();
                },

                logGoogleManagedApps() {
                  // Logging removed - function kept for compatibility
                }
              };
            });

            // Stripe subscription handler for "I have a data plan with my own carrier" button
            Alpine.data("stripeSubscription", function () {
              return {
                customerEmail: "",
                deviceIMEI: "",
                isSubscribed: false,
                isStripeLoaded: false,
                isEmbedded: false,
                stripeInstance: undefined as Stripe | undefined,
                sessionClientSecret: undefined as string | undefined,
                async handleStripeClick() {
                  if (!this.sessionClientSecret) {
                    const data = await actions.stripe.createSubscriptionPage.orThrow({
                      customerEmail: this.customerEmail,
                      deviceIMEI: this.deviceIMEI
                    });
                    this.sessionClientSecret = data.session.client_secret as string;
                  }

                  if (!this.isEmbedded) {
                    const checkout = await this.stripeInstance?.initEmbeddedCheckout({
                      clientSecret: this.sessionClientSecret
                    });
                    checkout?.mount("#stripe-subscription-element");
                    this.isEmbedded = true;
                  }

                  (this.$refs.stripeDialog as HTMLDialogElement).showModal();
                },
                async initializeStripe() {
                  const stripe = await loadStripe(STRIPE_PUBLIC_KEY);
                  if (!stripe) {
                    throw new Error("Stripe is not loaded");
                  }

                  this.stripeInstance = stripe;
                  this.isStripeLoaded = true;
                },
                init() {
                  this.initializeStripe();
                }
              };
            });
          </script>
        </div>
      </div>
    </main>
  </div>
</Layout>
