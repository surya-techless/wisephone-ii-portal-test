---
// src/pages/manage/[imei].astro
import {
  BypassTechlessSubscription,
  Wisephone,
  DeviceScreenTimeMetrics,
  DeviceDataUsage,
  DeviceFeatureFlags,
  sql,
  and,
  eq,
  db
} from "astro:db";
import { getUser } from "@/libs/clerk";
import type { UserResource } from "@clerk/types";
import type { User } from "@clerk/astro/server";
import { actions } from "astro:actions";
import Icon from "astro-iconify";
import { validateIsSubscribed } from "@/libs/stripe";
import { SamsungKnoxService } from "@/libs/samsung-knox-service";
import Layout from "@/layouts/Layout.astro";
import TechlessSubscriptionButton from "@/components/TechlessSubscriptionButton.astro";
import DashboardSidebar from "@/components/DashboardSidebar.astro";
import ScreenTimeStats from "@/components/ScreenTimeStats.astro";
import { FEATURES, getPackageNameFromPlayStoreUrl, isValidIMEI, type Feature, devLog } from "@/libs/utils";
import { isAdmin } from "@/lib/auth/permissions";
import type { AppsList } from "@/types/apps";
import { DEFAULT_SYSTEM_APPS, getSystemAppPackageNames } from "@/utils/system-apps";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { isFeatureEnabled } from "@/config/feature-flags";

// Initialize variables
let imei: string | undefined = Astro.params.imei;
let wisephone: any = null;
let features = Object.entries(FEATURES).map(([key, feature]) => ({ ...feature, featureKey: key }));
let isSubscribed = false;
let error = "";
let installedApps: any[] = [];
let appsList: AppsList = {};
let sortedAppsList = {};
let user: UserResource | User | null = null;
let enableScreenTime = false;
let screenTimeData: any[] = [];
let dataUsageData: { cycleStartDate?: Date; usageDetail?: any; lastSyncedAt?: Date } | null = null;
let dbShowScreenTime: boolean = false;

// Load apps.json file
let appsJsonData: any = { rows: [] };
try {
  const appsJsonPath = join(process.cwd(), "apps.json");
  const appsJsonContent = readFileSync(appsJsonPath, "utf-8");
  appsJsonData = JSON.parse(appsJsonContent);
  devLog.log(`✅ Loaded ${appsJsonData.rows?.length || 0} apps from apps.json`);
} catch (error) {
  devLog.error("❌ Failed to load apps.json:", error);
  // Continue with empty apps list
}

// Check if a device was just deleted successfully - must happen before any device lookup
const deleteActionResult = Astro.getActionResult(actions.wisephones.deleteWisephone);
if (deleteActionResult && !deleteActionResult.error) {
  return Astro.redirect("/dashboard?message=" + encodeURIComponent("Wisephone successfully removed from account."));
}

// Auth check
if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}

user = await Astro.locals.currentUser();

if (!user) {
  return Astro.redirect("/");
}

try {
  if (!imei || !isValidIMEI(imei)) {
    return Astro.redirect("/dashboard?error=" + encodeURIComponent("A Wisephone II with that IMEI was not found."));
  }

  const userId = Astro.locals.auth().userId;
  const userIsAdmin = await isAdmin(user.id);

  if (userIsAdmin) {
    const wisephones = await db
      .select()
      .from(Wisephone)
      .where(sql`${Wisephone.imei} = ${imei}`)
      .limit(1);

    if (wisephones.length > 0) {
      wisephone = wisephones[0];
    }
  } else {
    features = features.filter((feature) => !feature.isAdminOnly && !feature.isPortalOnly);

    const wisephones = await db
      .select()
      .from(Wisephone)
      .where(and(sql`${Wisephone.imei} = ${imei}`, eq(Wisephone.userId, user.id)))
      .limit(1);

    if (wisephones.length > 0) {
      wisephone = wisephones[0];
    }
  }

  if (!wisephone) {
    return Astro.redirect("/dashboard?error=" + encodeURIComponent("Device not found"));
  }

  // Check subscription status
  devLog.log("PAY DEBUG: [S1] Server-side subscription check for IMEI:", imei);
  devLog.log("PAY DEBUG: [S1.0] Full URL:", Astro.url.toString());
  devLog.log("PAY DEBUG: [S1.0.1] All URL params:", Object.fromEntries(Astro.url.searchParams.entries()));

  // Check if this is a Stripe redirect (session_id in URL)
  const sessionIdParam = Astro.url.searchParams.get("session_id");
  const paymentStatusParam = Astro.url.searchParams.get("payment_status");

  devLog.log("PAY DEBUG: [S1.0.2] Raw session_id param:", sessionIdParam);
  devLog.log("PAY DEBUG: [S1.0.3] Is placeholder?", sessionIdParam === "{CHECKOUT_SESSION_ID}");
  devLog.log("PAY DEBUG: [S1.0.4] payment_status param:", paymentStatusParam);

  if (sessionIdParam && sessionIdParam !== "{CHECKOUT_SESSION_ID}") {
    devLog.log("PAY DEBUG: [S1.0.5] ✅ Valid session_id found - validating payment");
    devLog.log("PAY DEBUG: [S1.0.6] session_id:", sessionIdParam);

    try {
      // Validate subscription using session_id (direct validation, no metadata search needed)
      const validationResult = await actions.stripe.validateSubscription.orThrow({
        sessionId: sessionIdParam,
        imei: imei
      });

      devLog.log("PAY DEBUG: [S1.0.3] Validation result:", validationResult);
      devLog.log("PAY DEBUG: [S1.0.4] isSubscribed from validation:", validationResult?.isSubscribed);

      if (validationResult?.isSubscribed) {
        // Payment succeeded, subscription is active
        devLog.log("PAY DEBUG: [S1.0.5] ✅ Payment successful, subscription is active");
        isSubscribed = true;
      } else {
        // Payment failed, cancelled, or subscription not active
        devLog.log("PAY DEBUG: [S1.0.6] ❌ Payment not completed or subscription not active");
        devLog.log("PAY DEBUG: [S1.0.7] Redirecting to dashboard with error");
        return Astro.redirect("/dashboard?error=" + encodeURIComponent("Payment was not completed. Please try again."));
      }
    } catch (validationError) {
      devLog.error("PAY DEBUG: [S1.0.8] ERROR validating Stripe session:", validationError);
      // On error, redirect to dashboard with error message
      return Astro.redirect(
        "/dashboard?error=" + encodeURIComponent("Unable to verify payment. Please try again or contact support.")
      );
    }
  } else {
    // Normal flow: no Stripe redirect, check subscription normally
    if (sessionIdParam) {
      devLog.log("PAY DEBUG: [S1.1] session_id is placeholder or invalid - running normal subscription check");
      devLog.log("PAY DEBUG: [S1.1.0] session_id value:", sessionIdParam);
      devLog.log("PAY DEBUG: [S1.1.1] This means Stripe hasn't replaced the placeholder yet or payment was cancelled");
    } else {
      devLog.log("PAY DEBUG: [S1.1] No Stripe session_id in URL - running normal subscription check");
    }

    const bypassTechlessSubscription = await db
      .select()
      .from(BypassTechlessSubscription)
      .where(eq(BypassTechlessSubscription.imei, Number(imei)))
      .limit(1);

    isSubscribed = bypassTechlessSubscription.length > 0;
    devLog.log("PAY DEBUG: [S1.2] Bypass subscription check result:", isSubscribed);
    devLog.log("PAY DEBUG: [S1.2.1] wisephone exists:", !!wisephone);
    devLog.log("PAY DEBUG: [S1.2.2] wisephone phoneNumber:", wisephone?.phoneNumber);

    if (!isSubscribed && wisephone?.phoneNumber) {
      try {
        const imeiForCheck = String(wisephone?.imei || "");
        const phoneForCheck = `${wisephone?.phoneNumber?.replace(/[^0-9+]/g, "") || ""}`;
        devLog.log("PAY DEBUG: [S1.3] ✅ Running validateIsSubscribed");
        devLog.log("PAY DEBUG: [S1.4]   - IMEI:", imeiForCheck);
        devLog.log("PAY DEBUG: [S1.5]   - Phone:", phoneForCheck);
        devLog.log("PAY DEBUG: [S1.5.1] Calling validateIsSubscribed function...");

        const startTime = Date.now();
        isSubscribed = await validateIsSubscribed({
          imei: imeiForCheck,
          phoneNumber: phoneForCheck
        });
        const endTime = Date.now();
        const duration = endTime - startTime;

        devLog.log("PAY DEBUG: [S1.6] ✅ validateIsSubscribed completed");
        devLog.log("PAY DEBUG: [S1.6.1] Result:", isSubscribed);
        devLog.log("PAY DEBUG: [S1.6.2] Duration:", duration, "ms");
      } catch (subscriptionError) {
        devLog.error("PAY DEBUG: [S1.7] ❌ ERROR checking subscription status:", subscriptionError);
        devLog.error(
          "PAY DEBUG: [S1.7.1] Error details:",
          subscriptionError instanceof Error ? subscriptionError.message : subscriptionError
        );
      }
    } else {
      devLog.log("PAY DEBUG: [S1.3] ⚠️ Skipping validateIsSubscribed");
      if (isSubscribed) {
        devLog.log("PAY DEBUG: [S1.3.1] Reason: Bypass subscription found");
      }
      if (!wisephone?.phoneNumber) {
        devLog.log("PAY DEBUG: [S1.3.2] Reason: No phone number available");
        devLog.log("PAY DEBUG: [S1.3.3] wisephone:", wisephone ? "exists" : "null");
      }
    }
  }

  devLog.log("PAY DEBUG: [S1.8] Final server-side isSubscribed:", isSubscribed);

  // const formData = new FormData();
  // formData.append("imei", String(wisephone?.imei || ""));
  // try {
  //   const getInstalledAppsResult = await Astro.callAction(actions.wisephones.getInstalledApps, formData);
  //   installedApps = getInstalledAppsResult?.data?.apps || [];
  //   devLog.log("[DEBUG] getInstalledApps installed Appsresult", installedApps);
  //   // Printing every item in the installedApps array
  //   installedApps.forEach((app) => {
  //     devLog.log("[DEBUG] getInstalledApps installed Appsitem", app.packageName);
  //   });
  // } catch (appsError) {
  //   devLog.error("Error getting installed apps:", appsError);
  // }

  // Check feature flag for screen time
  enableScreenTime = isFeatureEnabled("ENABLE_SCREEN_TIME");

  // Fetch device screentime from DeviceScreenTimeMetrics (one row per IMEI)
  if (enableScreenTime) {
    devLog.log("📊 Fetching device screentime for IMEI:", imei);
    try {
      const metricsRow = await db
        .select()
        .from(DeviceScreenTimeMetrics)
        .where(eq(DeviceScreenTimeMetrics.imei, imei))
        .get();

      if (metricsRow?.screenTimeDetail) {
        const detail = metricsRow.screenTimeDetail as {
          weeks?: Array<{
            weekStartDate: string;
            weekEndDate: string;
            totalScreenTimeMs: number;
            dailyAverageMs: number;
            days?: Array<{
              date: string;
              totalScreenTimeMs: number;
              apps?: Array<{ packageName: string; appName: string; totalTimeMs: number }>;
            }>;
            apps?: Array<{
              packageName: string;
              appName: string;
              totalTimeMs: number;
              dailyAverageMs: number;
            }>;
          }>;
        };
        const weeksArr = detail?.weeks ?? [];
        devLog.log("📊 DeviceScreenTimeMetrics weeks found:", weeksArr.length);

        screenTimeData = weeksArr.slice(0, 4).map((week, idx) => {
          const weekStartDate = new Date(week.weekStartDate + "T00:00:00.000Z");
          const weekEndDate = new Date(week.weekEndDate + "T23:59:59.999Z");
          const totalScreenTimeMs = week.totalScreenTimeMs ?? 0;
          const dailyAverageMs = week.dailyAverageMs ?? (totalScreenTimeMs > 0 ? Math.round(totalScreenTimeMs / 7) : 0);

          const apps = (week.apps ?? [])
            .filter((app) => (app.totalTimeMs ?? 0) >= 60 * 1000) // only show apps with >= 1 minute
            .map((app) => ({
              id: null,
              screenTimeId: null,
              imei: imei ?? "",
              packageName: app.packageName ?? "",
              appName: app.appName ?? "",
              totalTimeMs: app.totalTimeMs ?? 0,
              dailyAverageMs: app.dailyAverageMs ?? 0,
              weekStartDate
            }));

          const days = (week.days ?? []).map((day) => ({
            id: null,
            date: new Date(day.date + "T00:00:00.000Z"),
            totalScreenTimeMs: day.totalScreenTimeMs ?? 0,
            apps: (day.apps ?? []).map((app) => ({
              id: null,
              packageName: app.packageName ?? "",
              appName: app.appName ?? "",
              totalTimeMs: app.totalTimeMs ?? 0
            }))
          }));

          return {
            id: null,
            imei: imei ?? "",
            weekStartDate,
            weekEndDate,
            totalScreenTimeMs,
            dailyAverageMs,
            syncedAt: metricsRow.syncedAt ?? new Date(),
            deviceName: metricsRow.deviceName ?? null,
            deviceManufacturer: metricsRow.deviceManufacturer ?? null,
            apps,
            days
          };
        });
        devLog.log("📊 Device Screentime Details: built", screenTimeData.length, "weeks from one row");
      } else {
        devLog.log("📊 No screentime data found for IMEI:", imei);
      }
    } catch (error: any) {
      if (error?.code === "SQLITE_UNKNOWN" || error?.message?.includes("no such table")) {
        devLog.warn("⚠️ DeviceScreenTimeMetrics table does not exist — run: astro db push");
        screenTimeData = [];
      } else {
        throw error;
      }
    }

    // Fetch data usage for this device (same feature flag as screen time)
    try {
      const dataUsageRow = await db
        .select()
        .from(DeviceDataUsage)
        .where(eq(DeviceDataUsage.imei, imei))
        .get();
      if (dataUsageRow) {
        dataUsageData = {
          cycleStartDate: dataUsageRow.cycleStartDate ?? undefined,
          usageDetail: dataUsageRow.usageDetail ?? undefined,
          lastSyncedAt: dataUsageRow.lastSyncedAt ?? undefined
        };
        devLog.log("📊 Data usage loaded for IMEI:", imei);
      }
    } catch (e: any) {
      if (e?.message?.includes("no such table")) {
        devLog.warn("⚠️ DeviceDataUsage table does not exist");
      } else {
        throw e;
      }
    }
  } else {
    devLog.log("📊 Screen time feature is disabled (ENABLE_SCREEN_TIME=false)");
    screenTimeData = [];
  }

  // Read DeviceFeatureFlags — DB is source of truth (SHOW_SCREEN_TIME + Knox-backed flags)
  try {
    devLog.log("\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    devLog.log("🚩 [manage page] DeviceFeatureFlags check for IMEI:", imei);
    devLog.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

    let flagsRow = await db
      .select()
      .from(DeviceFeatureFlags)
      .where(eq(DeviceFeatureFlags.imei, imei))
      .get();

    if (flagsRow) {
      devLog.log("   Status: PRESENT");
      devLog.log(
        "   Row:",
        JSON.stringify(
          {
            imei: flagsRow.imei,
            TOOL_DRAWER: flagsRow.TOOL_DRAWER,
            TOOL_DRAWER_IN_PHONE: flagsRow.TOOL_DRAWER_IN_PHONE,
            GOOGLE_APPS: flagsRow.GOOGLE_APPS,
            NO_HOTSPOT: flagsRow.NO_HOTSPOT,
            ALLOW_FACTORY_RESET: flagsRow.ALLOW_FACTORY_RESET,
            WISEOS_PROTECT: flagsRow.WISEOS_PROTECT,
            SHOW_SCREEN_TIME: flagsRow.SHOW_SCREEN_TIME,
            updatedAt:
              flagsRow.updatedAt instanceof Date
                ? flagsRow.updatedAt.toISOString()
                : String(flagsRow.updatedAt)
          },
          null,
          2
        )
      );
      dbShowScreenTime = flagsRow.SHOW_SCREEN_TIME === 1;
    } else {
      devLog.log("   Status: NOT PRESENT — creating row with schema defaults");

      const newFlags = {
        imei,
        TOOL_DRAWER: 0,
        TOOL_DRAWER_IN_PHONE: 0,
        GOOGLE_APPS: 0,
        NO_HOTSPOT: 1,
        ALLOW_FACTORY_RESET: 1,
        WISEOS_PROTECT: 0,
        SHOW_SCREEN_TIME: 0,
        updatedAt: new Date()
      } as const;

      devLog.log("   Inserting:", JSON.stringify({ ...newFlags, updatedAt: newFlags.updatedAt.toISOString() }, null, 2));

      try {
        await db.insert(DeviceFeatureFlags).values({ ...newFlags });
      } catch (insertErr: unknown) {
        // Race: another request may have inserted the same IMEI
        devLog.warn("   ⚠️ Insert raced or failed; re-selecting:", insertErr);
      }

      flagsRow = await db
        .select()
        .from(DeviceFeatureFlags)
        .where(eq(DeviceFeatureFlags.imei, imei))
        .get();

      if (flagsRow) {
        devLog.log("   Status after insert: OK");
        devLog.log(
          "   Row:",
          JSON.stringify(
            {
              imei: flagsRow.imei,
              TOOL_DRAWER: flagsRow.TOOL_DRAWER,
              TOOL_DRAWER_IN_PHONE: flagsRow.TOOL_DRAWER_IN_PHONE,
              GOOGLE_APPS: flagsRow.GOOGLE_APPS,
              NO_HOTSPOT: flagsRow.NO_HOTSPOT,
              ALLOW_FACTORY_RESET: flagsRow.ALLOW_FACTORY_RESET,
              WISEOS_PROTECT: flagsRow.WISEOS_PROTECT,
              SHOW_SCREEN_TIME: flagsRow.SHOW_SCREEN_TIME,
              updatedAt:
                flagsRow.updatedAt instanceof Date
                  ? flagsRow.updatedAt.toISOString()
                  : String(flagsRow.updatedAt)
            },
            null,
            2
          )
        );
        dbShowScreenTime = flagsRow.SHOW_SCREEN_TIME === 1;
      } else {
        devLog.error("   ❌ DeviceFeatureFlags row still missing after insert attempt");
      }
    }

    devLog.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
  } catch (flagsErr) {
    devLog.error("❌ [manage page] DeviceFeatureFlags read/seed failed:", flagsErr);
  }

  // Installed apps will be fetched client-side asynchronously
  // Initialize as empty - will be populated after page loads
  installedApps = [];
  appsList = {};
  sortedAppsList = {};
} catch (error) {
  devLog.error("Unexpected error in manage page:", error);
  return Astro.redirect(
    "/dashboard?error=" + encodeURIComponent("An unexpected error occurred while loading the device. Please try again.")
  );
}
---

<Layout
  title={`Device Dashboard → ${wisephone?.nickname || "Device"}`}
  description="Manage your Wisephone device settings, features, and apps."
>
  <div
    class="flex h-screen bg-[#f7f6f2] relative"
    x-data="manageDevice"
    x-init={`
      mobileMenuOpen = false;
      installedApps = ${JSON.stringify(installedApps || [])};
      appsList = ${JSON.stringify(sortedAppsList || {})};
      availableFeatures = ${JSON.stringify(features || [])};
      imei = \`${imei || ""}\`;
      isSubscribed = ${Boolean(isSubscribed)};
      deviceName = \`${(wisephone?.nickname || "").replace(/`/g, "'")}\`;
      devicePhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      originalDeviceName = \`${(wisephone?.nickname || "").replace(/`/g, "'")}\`;
      originalDevicePhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      enableScreenTime = ${enableScreenTime};
      showScreenTimeComponent = ${dbShowScreenTime};
      dataUsageFormatted = \`${String((dataUsageData?.usageDetail as any)?.totalFormatted ?? "").replace(/`/g, "'")}\`;
      userName = \`${user?.firstName || ""} ${user?.lastName || ""}\`;
      userPhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      userEmail = \`${user?.emailAddresses?.[0]?.emailAddress || ""}\`;
      isLoading = true;
    `}
  >
    <progress
      x-show="isLoading || isToolDrawerLoading"
      x-cloak
      x-transition
      class="absolute top-0 left-0 right-0 w-full progress"
      style="--progress-color: var(--evergreen);"></progress>

    <!-- Sidebar -->
    <DashboardSidebar activeLink="devices" />

    <!-- Main Content Area -->
    <main
      x-show="!isLoading"
      x-cloak
      class="device-dashboard-main-container relative flex-1 overflow-y-auto overflow-x-hidden md:rounded-xl md:mt-4 md:mb-4 md:mr-4 bg-[#ffffff] w-full pt-3 md:pt-0"
    >
      <!-- Mobile Menu Button -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="md:hidden fixed top-2 right-4 z-30 p-2 bg-white rounded-lg shadow-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <div class="w-full h-full">
        <!-- Close Button -->
        <button
          @click="window.location.href = '/dashboard'"
          class="hidden md:flex absolute top-4 right-4 md:top-6 md:right-6 w-8 h-8 items-center justify-center hover:bg-gray-100 rounded-full z-10"
        >
          <Icon name="lucide:x" class="w-5 h-5 text-gray-600" />
        </button>

        <div class="p-4 md:p-8 overflow-x-hidden">
          <!-- Header -->
          <div class="mb-4">
            <h2 class="text-xl md:text-2xl font-semibold text-gray-900 mb-1">
              <span class="md:hidden" x-text="deviceName"></span>
              <span class="hidden md:inline">Device Dashboard → <span x-text="deviceName"></span></span>
            </h2>
            <p class="text-gray-600 text-sm">
              <span class="md:inline"
                >This dashboard allows you to manage <span x-text="deviceName"></span>'s Wisephone.</span
              >
              <!-- <span class="hidden md:inline"
                >This dashboard allows you to manage settings for this Wisephone. View usage statistics, update
                subscription or billing information, and decide which features and apps you'd like on the Wisephone.</span
              > -->
            </p>
          </div>

          <!-- Two Column Layout: 2 cols only at 2xl (1536px+) to ensure enough space for both columns; below 2xl stack vertically -->
          <div class="grid grid-cols-1 2xl:grid-cols-2 gap-5 2xl:gap-10 max-2xl:gap-y-0">
            <!-- Left Column: Tabs and Tab Content (min-w-0 so grid can shrink it; overflow-x-hidden to prevent overlap) -->
            <div class="max-2xl:mb-0 2xl:mb-6 min-w-0 overflow-x-hidden 2xl:max-w-[500px]" :class="currentTab === 'app-management' ? '2xl:col-span-2 2xl:max-w-none' : ''">
              <!-- Tabs -->
              <div class="relative mb-6 max-w-full md:-ml-2 md:w-[500px]">
                <!-- Tabs container - no border -->
                <div class="flex flex-nowrap gap-0 pr-0 max-w-full md:w-[500px] relative z-10">
                  <button
                    @click="currentTab = 'device-info'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
                    :class="currentTab === 'device-info' ? 'bg-[#DBD5CD] text-gray-900' : 'text-gray-600 hover:text-gray-900'"
                  >
                    Device Info
                    <span
                      x-show="currentTab === 'device-info'"
                      class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#DBD5CD] -mb-[2px]"></span>
                    <span
                      x-show="currentTab === 'device-info'"
                      class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C07F53] -mb-[2px]"></span>
                  </button>
                  <button
                    @click="currentTab = 'features'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
                    :class="currentTab === 'features' ? 'bg-[#DBD5CD] text-gray-900' : 'text-gray-600 hover:text-gray-900'"
                  >
                    Features
                    <span
                      x-show="currentTab === 'features'"
                      class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#DBD5CD] -mb-[2px]"></span>
                    <span
                      x-show="currentTab === 'features'"
                      class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C07F53] -mb-[2px]"></span>
                  </button>
                  <button
                    x-show="isSubscribed && isToolDrawerEnabled"
                    x-cloak
                    @click="currentTab = 'app-management'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
