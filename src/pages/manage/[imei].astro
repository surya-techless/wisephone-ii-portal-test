---
// src/pages/manage/[imei].astro
import {
  BypassTechlessSubscription,
  Wisephone,
  DeviceScreenTime,
  DeviceAppUsage,
  DeviceDailyScreenTime,
  DeviceDailyAppUsage,
  sql,
  and,
  eq,
  desc,
  db
} from "astro:db";
import { getUser } from "@/libs/clerk";
import type { UserResource } from "@clerk/types";
import type { User } from "@clerk/astro/server";
import { actions } from "astro:actions";
import Icon from "astro-iconify";
import { validateIsSubscribed } from "@/libs/stripe";
import { SamsungKnoxService } from "@/libs/samsung-knox-service";
import Layout from "@/layouts/Layout.astro";
import TechlessSubscriptionButton from "@/components/TechlessSubscriptionButton.astro";
import DashboardSidebar from "@/components/DashboardSidebar.astro";
import ScreenTimeStats from "@/components/ScreenTimeStats.astro";
import { FEATURES, getPackageNameFromPlayStoreUrl, isValidIMEI, type Feature } from "@/libs/utils";
import { isAdmin } from "@/lib/auth/permissions";
import type { AppsList } from "@/types/apps";
import { DEFAULT_SYSTEM_APPS, getSystemAppPackageNames } from "@/utils/system-apps";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { isFeatureEnabled } from "@/config/feature-flags";

// Helper function to create screen time tables if they don't exist
async function createScreenTimeTables() {
  console.log("🔨 Creating DeviceScreenTime table...");
  await db.run(sql`
    CREATE TABLE IF NOT EXISTS DeviceScreenTime (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      imei TEXT NOT NULL,
      weekStartDate TEXT NOT NULL,
      weekEndDate TEXT NOT NULL,
      totalScreenTimeMs INTEGER NOT NULL,
      dailyAverageMs INTEGER NOT NULL,
      syncedAt TEXT NOT NULL DEFAULT (datetime('now')),
      deviceName TEXT,
      deviceManufacturer TEXT
    )
  `);

  console.log("🔨 Creating DeviceAppUsage table...");
  await db.run(sql`
    CREATE TABLE IF NOT EXISTS DeviceAppUsage (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      screenTimeId INTEGER NOT NULL,
      imei TEXT NOT NULL,
      packageName TEXT NOT NULL,
      appName TEXT NOT NULL,
      totalTimeMs INTEGER NOT NULL,
      dailyAverageMs INTEGER NOT NULL,
      weekStartDate TEXT NOT NULL
    )
  `);

  console.log("🔨 Creating indexes...");
  await db.run(sql`CREATE INDEX IF NOT EXISTS idx_device_app_usage_screen_time_id ON DeviceAppUsage(screenTimeId)`);
  await db.run(sql`CREATE INDEX IF NOT EXISTS idx_device_app_usage_imei_week ON DeviceAppUsage(imei, weekStartDate)`);

  console.log("✅ Screen time tables created");
}

// Initialize variables
let imei: string | undefined = Astro.params.imei;
let wisephone: any = null;
let features = Object.values(FEATURES);
let isSubscribed = false;
let error = "";
let installedApps: any[] = [];
let appsList: AppsList = {};
let sortedAppsList = {};
let user: UserResource | User | null = null;
let enableScreenTime = false;
let screenTimeData: any[] = [];

// Load apps.json file
let appsJsonData: any = { rows: [] };
try {
  const appsJsonPath = join(process.cwd(), "apps.json");
  const appsJsonContent = readFileSync(appsJsonPath, "utf-8");
  appsJsonData = JSON.parse(appsJsonContent);
  console.log(`✅ Loaded ${appsJsonData.rows?.length || 0} apps from apps.json`);
} catch (error) {
  console.error("❌ Failed to load apps.json:", error);
  // Continue with empty apps list
}

// Check if a device was just deleted successfully - must happen before any device lookup
const deleteActionResult = Astro.getActionResult(actions.wisephones.deleteWisephone);
if (deleteActionResult && !deleteActionResult.error) {
  return Astro.redirect("/dashboard?message=" + encodeURIComponent("Wisephone successfully removed from account."));
}

// Auth check
if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}

user = await Astro.locals.currentUser();

if (!user) {
  return Astro.redirect("/");
}

try {
  if (!imei || !isValidIMEI(imei)) {
    return Astro.redirect("/dashboard?error=" + encodeURIComponent("A Wisephone II with that IMEI was not found."));
  }

  const userId = Astro.locals.auth().userId;
  const userIsAdmin = await isAdmin(user.id);

  if (userIsAdmin) {
    const wisephones = await db
      .select()
      .from(Wisephone)
      .where(sql`${Wisephone.imei} = ${imei}`)
      .limit(1);

    if (wisephones.length > 0) {
      wisephone = wisephones[0];
    }
  } else {
    features = features.filter((feature) => !feature.isAdminOnly);

    const wisephones = await db
      .select()
      .from(Wisephone)
      .where(and(sql`${Wisephone.imei} = ${imei}`, eq(Wisephone.userId, user.id)))
      .limit(1);

    if (wisephones.length > 0) {
      wisephone = wisephones[0];
    }
  }

  if (!wisephone) {
    return Astro.redirect("/dashboard?error=" + encodeURIComponent("Device not found"));
  }

  // Check subscription status
  const bypassTechlessSubscription = await db
    .select()
    .from(BypassTechlessSubscription)
    .where(eq(BypassTechlessSubscription.imei, Number(imei)))
    .limit(1);

  isSubscribed = bypassTechlessSubscription.length > 0;

  if (!isSubscribed && wisephone?.phoneNumber) {
    try {
      isSubscribed = await validateIsSubscribed({
        imei: String(wisephone?.imei || ""),
        phoneNumber: `${wisephone?.phoneNumber?.replace(/[^0-9+]/g, "") || ""}`
      });
    } catch (subscriptionError) {
      console.error("Error checking subscription status:", subscriptionError);
    }
  }

  // const formData = new FormData();
  // formData.append("imei", String(wisephone?.imei || ""));
  // try {
  //   const getInstalledAppsResult = await Astro.callAction(actions.wisephones.getInstalledApps, formData);
  //   installedApps = getInstalledAppsResult?.data?.apps || [];
  //   console.log("[DEBUG] getInstalledApps installed Appsresult", installedApps);
  //   // Printing every item in the installedApps array
  //   installedApps.forEach((app) => {
  //     console.log("[DEBUG] getInstalledApps installed Appsitem", app.packageName);
  //   });
  // } catch (appsError) {
  //   console.error("Error getting installed apps:", appsError);
  // }

  // Check feature flag for screen time
  enableScreenTime = isFeatureEnabled("ENABLE_SCREEN_TIME");

  // Fetch device screentime details from DB (only if feature flag is enabled)
  let screenTimeRecords: any[] = [];

  if (enableScreenTime) {
    console.log("📊 Fetching device screentime for IMEI:", imei);

    // Check which database we're using
    const dbUrl = import.meta.env.ASTRO_DB_REMOTE_URL || import.meta.env.TURSO_DATABASE_URL;
    if (dbUrl) {
      console.log("🌍 Using REMOTE database (Turso)");
    } else {
      console.log("⚠️ Using LOCAL database - data may not be synced!");
      console.log("💡 To use remote DB, run: npm run dev:remote");
    }
    try {
      screenTimeRecords = await db
        .select()
        .from(DeviceScreenTime)
        .where(eq(DeviceScreenTime.imei, imei))
        .orderBy(desc(DeviceScreenTime.weekStartDate))
        .limit(4); // Limit to 4 most recent weeks
    } catch (error: any) {
      // Handle case where table doesn't exist yet - create tables automatically
      if (error?.code === "SQLITE_UNKNOWN" || error?.message?.includes("no such table")) {
        console.warn("⚠️ DeviceScreenTime table does not exist yet. Creating tables...");
        try {
          await createScreenTimeTables();
          console.log("✅ Screen time tables created successfully");
          // Retry the query after creating tables
          screenTimeRecords = await db
            .select()
            .from(DeviceScreenTime)
            .where(eq(DeviceScreenTime.imei, imei))
            .orderBy(desc(DeviceScreenTime.weekStartDate));
        } catch (createError) {
          console.error("❌ Failed to create tables:", createError);
          screenTimeRecords = [];
        }
      } else {
        throw error;
      }
    }

    console.log("📊 DeviceScreenTime records found:", screenTimeRecords.length);

    // Log raw records to see what we're getting from DB
    if (screenTimeRecords.length > 0) {
      console.log("📊 Raw first record from DB:", JSON.stringify(screenTimeRecords[0], null, 2));
      screenTimeRecords.forEach((record, idx) => {
        console.log(`📊 Raw record ${idx}:`, {
          id: record.id,
          imei: record.imei,
          dailyAverageMs: record.dailyAverageMs,
          totalScreenTimeMs: record.totalScreenTimeMs,
          dailyAverageMsType: typeof record.dailyAverageMs,
          dailyAverageMsIsNull: record.dailyAverageMs === null,
          dailyAverageMsIsUndefined: record.dailyAverageMs === undefined
        });
      });
    }

    if (screenTimeRecords.length > 0) {
      // Fetch app usage for each week and ensure all fields are properly set
      screenTimeData = await Promise.all(
        screenTimeRecords.map(async (record) => {
          const apps = await db
            .select()
            .from(DeviceAppUsage)
            .where(eq(DeviceAppUsage.screenTimeId, record.id))
            .orderBy(desc(DeviceAppUsage.totalTimeMs));

          // Explicitly map all fields to ensure they exist and handle null values
          // CRITICAL: Ensure dailyAverageMs is NEVER null/undefined
          let dailyAverageMs = record.dailyAverageMs;
          if (dailyAverageMs === null || dailyAverageMs === undefined) {
            console.warn(`⚠️ Record ${record.id} has null/undefined dailyAverageMs, attempting to calculate...`);
            // Try to calculate from totalScreenTimeMs if available
            if (record.totalScreenTimeMs && record.totalScreenTimeMs > 0) {
              dailyAverageMs = Math.round(record.totalScreenTimeMs / 7);
              console.log(`✅ Calculated dailyAverageMs from totalScreenTimeMs: ${dailyAverageMs}`);
            } else {
              dailyAverageMs = 0;
              console.warn(`⚠️ Could not calculate dailyAverageMs, defaulting to 0`);
            }
          }

          // Ensure totalScreenTimeMs is also never null
          const totalScreenTimeMs = record.totalScreenTimeMs ?? 0;

          // Fetch daily screen time data for this week
          const dailyRecords = await db
            .select()
            .from(DeviceDailyScreenTime)
            .where(eq(DeviceDailyScreenTime.screenTimeId, record.id))
            .orderBy(DeviceDailyScreenTime.date);

          // Fetch daily app usage for each day
          const daysWithApps = await Promise.all(
            dailyRecords.map(async (dailyRecord) => {
              const dailyApps = await db
                .select()
                .from(DeviceDailyAppUsage)
                .where(eq(DeviceDailyAppUsage.dailyScreenTimeId, dailyRecord.id))
                .orderBy(desc(DeviceDailyAppUsage.totalTimeMs));

              return {
                id: dailyRecord.id,
                date: dailyRecord.date,
                totalScreenTimeMs: dailyRecord.totalScreenTimeMs ?? 0,
                apps: dailyApps
                  .filter((app) => (app.totalTimeMs ?? 0) > 0)
                  .map((app) => ({
                    id: app.id,
                    packageName: app.packageName,
                    appName: app.appName,
                    totalTimeMs: app.totalTimeMs ?? 0
                  }))
              };
            })
          );

          const weekData = {
            id: record.id ?? null,
            imei: record.imei ?? imei ?? "",
            weekStartDate: record.weekStartDate ?? null,
            weekEndDate: record.weekEndDate ?? null,
            totalScreenTimeMs: totalScreenTimeMs,
            dailyAverageMs: dailyAverageMs, // This is now guaranteed to be a number
            syncedAt: record.syncedAt ?? new Date(),
            deviceName: record.deviceName ?? null,
            deviceManufacturer: record.deviceManufacturer ?? null,
            apps: apps
              .filter((app) => (app.totalTimeMs ?? 0) > 0)
              .map((app) => ({
                id: app.id ?? null,
                screenTimeId: app.screenTimeId ?? record.id ?? null,
                imei: app.imei ?? imei ?? "",
                packageName: app.packageName ?? "",
                appName: app.appName ?? "",
                totalTimeMs: app.totalTimeMs ?? 0,
                dailyAverageMs: app.dailyAverageMs ?? 0,
                weekStartDate: app.weekStartDate ?? record.weekStartDate ?? null
              })),
            days: daysWithApps // Add daily breakdown
          };

          // Final validation - this should never fail now
          if (weekData.dailyAverageMs === null || weekData.dailyAverageMs === undefined) {
            console.error(
              `❌ CRITICAL: Record ${record.id} STILL has null/undefined dailyAverageMs after processing!`,
              {
                original: record.dailyAverageMs,
                processed: weekData.dailyAverageMs,
                record: record
              }
            );
            // Force it to 0 as last resort
            weekData.dailyAverageMs = 0;
          }

          console.log(
            `✅ Processed week ${record.id}: dailyAverageMs = ${weekData.dailyAverageMs} (type: ${typeof weekData.dailyAverageMs})`
          );

          return weekData;
        })
      );

      console.log("📊 Device Screentime Details:", JSON.stringify(screenTimeData, null, 2));

      // Final validation check
      screenTimeData.forEach((week, index) => {
        console.log(`📊 Week ${index} final check:`, {
          id: week?.id,
          imei: week?.imei,
          weekStartDate: week?.weekStartDate,
          weekEndDate: week?.weekEndDate,
          totalScreenTimeMs: week?.totalScreenTimeMs,
          dailyAverageMs: week?.dailyAverageMs,
          syncedAt: week?.syncedAt,
          deviceName: week?.deviceName,
          deviceManufacturer: week?.deviceManufacturer,
          appsCount: week?.apps?.length || 0
        });

        if (week.dailyAverageMs === null || week.dailyAverageMs === undefined) {
          console.error(`❌ Week ${index} STILL has null/undefined dailyAverageMs after processing:`, week);
        }
        if (week.totalScreenTimeMs === null || week.totalScreenTimeMs === undefined) {
          console.warn(`⚠️ Week ${index} has null/undefined totalScreenTimeMs:`, week);
        }
      });
    } else {
      console.log("📊 No screentime data found for IMEI:", imei);
    }
  } else {
    console.log("📊 Screen time feature is disabled (ENABLE_SCREEN_TIME=false)");
    screenTimeData = [];
  }

  // Installed apps will be fetched client-side asynchronously
  // Initialize as empty - will be populated after page loads
  installedApps = [];
  appsList = {};
  sortedAppsList = {};
} catch (error) {
  console.error("Unexpected error in manage page:", error);
  return Astro.redirect(
    "/dashboard?error=" + encodeURIComponent("An unexpected error occurred while loading the device. Please try again.")
  );
}
---

<Layout
  title={`Device Dashboard → ${wisephone?.nickname || "Device"}`}
  description="Manage your Wisephone device settings, features, and apps."
>
  <div
    class="flex h-screen bg-[#f7f6f2] relative"
    x-data="manageDevice"
    x-init={`
      mobileMenuOpen = false;
      installedApps = ${JSON.stringify(installedApps || [])};
      appsList = ${JSON.stringify(sortedAppsList || {})};
      availableFeatures = ${JSON.stringify(features || [])};
      imei = \`${imei || ""}\`;
      isSubscribed = ${Boolean(isSubscribed)};
      deviceName = \`${(wisephone?.nickname || "").replace(/`/g, "'")}\`;
      devicePhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      originalDeviceName = \`${(wisephone?.nickname || "").replace(/`/g, "'")}\`;
      originalDevicePhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      enableScreenTime = ${enableScreenTime};
      userName = \`${user?.firstName || ""} ${user?.lastName || ""}\`;
      userPhone = \`${wisephone?.phoneNumber || "(111) 111-1111"}\`;
      userEmail = \`${user?.emailAddresses?.[0]?.emailAddress || ""}\`;
      isLoading = true;
    `}
  >
    <progress
      x-show="isLoading || isToolDrawerLoading"
      x-cloak
      x-transition
      class="absolute top-0 left-0 right-0 w-full progress"
      style="--progress-color: var(--evergreen);"></progress>

    <!-- Sidebar -->
    <DashboardSidebar activeLink="devices" />

    <!-- Main Content Area -->
    <main
      x-show="!isLoading"
      x-cloak
      class="device-dashboard-main-container relative flex-1 overflow-y-auto overflow-x-hidden md:rounded-xl md:mt-4 md:mb-4 md:mr-4 bg-[#ffffff] w-full pt-3 md:pt-0"
    >
      <!-- Mobile Menu Button -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="md:hidden fixed top-4 right-4 z-30 p-2 bg-white rounded-lg shadow-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <div class="w-full h-full">
        <!-- Close Button -->
        <button
          @click="window.location.href = '/dashboard'"
          class="hidden md:flex absolute top-4 right-4 md:top-6 md:right-6 w-8 h-8 items-center justify-center hover:bg-gray-100 rounded-full z-10"
        >
          <Icon name="lucide:x" class="w-5 h-5 text-gray-600" />
        </button>

        <div class="p-4 md:p-8 overflow-x-hidden">
          <!-- Header -->
          <div class="mb-4">
            <h2 class="text-xl md:text-2xl font-semibold text-gray-900 mb-1">
              <span class="md:hidden" x-text="deviceName"></span>
              <span class="hidden md:inline">Device Dashboard → <span x-text="deviceName"></span></span>
            </h2>
            <p class="text-gray-600 text-sm">
              <span class="md:inline"
                >This dashboard allows you to manage <span x-text="deviceName"></span>'s Wisephone.</span
              >
              <!-- <span class="hidden md:inline"
                >This dashboard allows you to manage settings for this Wisephone. View usage statistics, update
                subscription or billing information, and decide which features and apps you'd like on the Wisephone.</span
              > -->
            </p>
          </div>

          <!-- Two Column Layout: Tabs + Tab Content (Left) and Screen Time (Right) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Tabs and Tab Content -->
            <div class="mb-6" :class="currentTab === 'app-management' ? 'lg:col-span-2' : ''">
              <!-- Tabs -->
              <div class="relative mb-6 md:-ml-2 md:w-[500px]">
                <!-- Tabs container - no border -->
                <div class="flex flex-nowrap gap-0 pr-0 md:w-[500px] relative z-10">
                  <button
                    @click="currentTab = 'device-info'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
                    :class="currentTab === 'device-info' ? 'bg-[#DBD5CD] text-gray-900' : 'text-gray-600 hover:text-gray-900'"
                  >
                    Device Info
                    <span
                      x-show="currentTab === 'device-info'"
                      class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#DBD5CD] -mb-[2px]"></span>
                    <span
                      x-show="currentTab === 'device-info'"
                      class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C07F53] -mb-[2px]"></span>
                  </button>
                  <button
                    @click="currentTab = 'features'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
                    :class="currentTab === 'features' ? 'bg-[#DBD5CD] text-gray-900' : 'text-gray-600 hover:text-gray-900'"
                  >
                    Features
                    <span
                      x-show="currentTab === 'features'"
                      class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#DBD5CD] -mb-[2px]"></span>
                    <span
                      x-show="currentTab === 'features'"
                      class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C07F53] -mb-[2px]"></span>
                  </button>
                  <button
                    x-show="isSubscribed && isToolDrawerEnabled"
                    x-cloak
                    @click="currentTab = 'app-management'"
                    class="px-2 md:px-6 py-3 text-sm font-medium transition-colors relative flex-1 whitespace-nowrap"
                    :class="currentTab === 'app-management' ? 'bg-[#DBD5CD] text-gray-900' : 'text-gray-600 hover:text-gray-900'"
                  >
                    Tool Management
                    <span
                      x-show="currentTab === 'app-management'"
                      class="absolute bottom-0 left-0 right-0 h-[3px] bg-[#DBD5CD] -mb-[2px]"></span>
                    <span
                      x-show="currentTab === 'app-management'"
                      class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#C07F53] -mb-[2px]"></span>
                  </button>
                </div>
                <!-- Blue border line - same length as tabs container -->
                <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gray-200 md:w-[500px] z-0"></div>
              </div>
              <!-- Device Info Tab -->
              <div x-show="currentTab === 'device-info'" x-cloak class="md:max-w-[500px]">
                <div class="mb-6">
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-12 h-12 rounded-full bg-teal-600 flex items-center justify-center text-white text-lg font-semibold flex-shrink-0"
                    >
                      <span x-text="deviceName.charAt(0) || 'D'">D</span>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-2">
                        <h3 class="text-base font-semibold text-gray-900" x-text="deviceName">Device Name</h3>
                        <button
                          class="p-1 hover:bg-gray-100 rounded flex-shrink-0"
                          @click="openEditModal()"
                          aria-label="Edit device info"
                        >
                          <Icon name="lucide:pencil" class="w-4 h-4 text-gray-500" />
                        </button>
                      </div>
                      <p class="text-sm text-gray-600" x-text="devicePhone">(111) 111-1111</p>
                      <p class="text-xs text-gray-500">IMEI: <span x-text="imei"></span></p>
                    </div>
                  </div>

                  <template x-if="isSubscribed">
                    <div class="stats-container">
                      <!-- Stats Grid -->
                      <div class="flex gap-2 mb-6 max-w-[26rem]">
                        <div class="text-center bg-[#f7f6f2] rounded-lg p-3 w-[250px]">
                          <p class="text-xs text-gray-600 mb-1">Apps</p>
                          <p class="text-xl font-semibold text-gray-900" x-text="totalAppsCount">0</p>
                        </div>
                      </div>

                      <!-- Subscription & Billing -->
                      <div class="subscription-container mb-4 pb-4 max-w-[26rem] md:max-w-[500px]">
                        <hr class="border-gray-200 mb-4 w-full md:w-[500px]" />
                        <h4 class="text-sm font-semibold text-gray-900 mb-4">Manage My Subscription</h4>
                        <div class="flex flex-col md:flex-row gap-3">
                          <a
                            href="https://plans.techless.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="px-3 py-1.5 border border-black rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 w-fit inline-flex items-center gap-1"
                          >
                            I have a Wisephone data plan
                            <Icon name="lucide:external-link" class="w-3 h-3" />
                          </a>
                          <div
                            x-data="stripeSubscription"
                            x-init={`
                              customerEmail = \`${user?.emailAddresses?.[0]?.emailAddress || ""}\`;
                              deviceIMEI = \`${wisephone?.imei || ""}\`;
                              isSubscribed = ${Boolean(isSubscribed)};
                            `}
                          >
                            <!-- Show link when subscribed -->
                            <a
                              x-show="isSubscribed"
                              x-cloak
                              href="https://getwisephone.com/my-subscription"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="px-3 py-1.5 border border-black rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 w-fit inline-flex items-center gap-1"
                            >
                              I have a data plan with my own carrier
                              <Icon name="lucide:external-link" class="w-3 h-3" />
                            </a>
                            <!-- Show button when not subscribed -->
                            <button
                              x-show="!isSubscribed"
                              x-cloak
                              type="button"
                              :disabled="!isStripeLoaded"
                              @click="handleStripeClick"
                              class="px-3 py-1.5 border border-black rounded-lg text-xs font-medium text-gray-700 hover:bg-gray-50 w-fit inline-flex items-center gap-1 disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                              I have a data plan with my own carrier
                              <Icon name="lucide:external-link" class="w-3 h-3" />
                            </button>
                            <!-- Modal only shown when not subscribed -->
                            <dialog
                              x-show="!isSubscribed"
                              x-ref="stripeDialog"
                              id="stripe-subscription-dialog"
                              class="modal"
                            >
                              <div style="background-color: rgb(247, 246, 242)" class="modal-box">
                                <div id="stripe-subscription-element"></div>
                              </div>
                              <form method="dialog" class="modal-backdrop">
                                <button>close</button>
