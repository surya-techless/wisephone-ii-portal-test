                        class="sr-only peer"
                        :checked="toolDrawerInPhoneFeature && isFeatureEnabledForFeature(toolDrawerInPhoneFeature)"
                        @click.prevent="toolDrawerInPhoneFeature && toggleFeature(toolDrawerInPhoneFeature)"
                        :disabled="!isSubscribed"
                      />
                      <div
                        class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-teal-600"
                      ></div>
                    </label>
                  </div>
                </div>
              </div>
            </div>


              <!-- Right Column: Screen Time (divider above when stacked below subscription; hidden at 2xl+ side-by-side) -->
              <div
                class="max-2xl:mb-4 2xl:mb-6 w-full min-w-0 max-w-full md:max-w-[500px] 2xl:max-w-[600px] 2xl:ml-5 h-full order-2 2xl:order-none max-2xl:border-t max-2xl:border-gray-200 max-2xl:pt-4 max-2xl:mt-0"
                x-show="currentTab === 'device-info' && enableScreenTime && showScreenTimeComponent"
                x-cloak
              >
                <ScreenTimeStats imei={imei || ""} screenTimeData={enableScreenTime ? screenTimeData : []} />
              </div>


              <!-- Device Removal (shown when stacked layout, below Screen Time; same max width as tabs) -->
              <div class="mb-6 w-full max-w-full md:max-w-[500px] 2xl:hidden max-2xl:mt-0 2xl:mt-4 order-3" x-show="currentTab === 'device-info' && enableScreenTime" x-cloak>
                <div class="pt-4 border-t border-gray-200">
                  <h4 class="text-sm font-semibold text-gray-900 mb-2">Device Removal</h4>
                  <p class="text-sm text-gray-600 mb-2">
                    Remove this device from this list of managed devices. Perform this action if you want to manage this
