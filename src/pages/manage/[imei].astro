                    devLog.error("App uninstallation failed:", error);
                    this.showErrorToast("Failed to uninstall app");
                  }
                },

                cancelAppUninstall() {
                  this.showAppUninstallModal = false;
                  this.pendingAppToUninstall = null;
                  this.pendingAppToUninstallName = "";
                },

                // Load Tool Drawer apps from API (similar to device/[imei].astro)
                async loadToolDrawer() {
                  if (this.isToolDrawerLoaded || this.isToolDrawerLoading) {
                    return;
                  }

                  try {
                    this.isToolDrawerLoading = true;
                    const response = await fetch("/api/ottogrid.json");

                    if (!response.ok) {
                      throw new Error("Failed to load Tool Drawer data");
                    }

                    const data = await response.json();

                    // Process the data and update the appsList
                    if (data && data.rows && data.rows.length) {
                      const updatedAppsList = { ...this.appsList };

                      data.rows
                        .filter((row: any) => row && row.cells && row.cells["Tool Drawer"] === "Yes")
                        .forEach((row: any) => {
                          try {
                            const packageName = getPackageNameFromPlayStoreUrl(row.cells["Play Store URL"]);
                            if (!packageName) return;

                            // If the app is already in the list, preserve the installed status
                            const isInstalled = this.installedApps.some((app) => app.packageName === packageName);

                            updatedAppsList[packageName] = {
                              source: "Tool Drawer",
                              installed: isInstalled,
                              name: row.cells["Tool Name"] || "Unknown App"
                            };
                          } catch (error) {
                            devLog.error("Error processing app row:", error);
                          }
                        });

                      this.appsList = updatedAppsList;
                      this.isToolDrawerLoaded = true;
                    }
                  } catch (error) {
                    devLog.error("Error loading Tool Drawer:", error);
                    this.showErrorToast("Failed to load Tool Drawer apps");
                  } finally {
                    this.isToolDrawerLoading = false;
                  }
                },

                get completeSetupUrl() {
                  // Clean phone number (remove dashes) for the deeplink
                  const cleanedPhone = this.devicePhone.replace(/\D/g, "");
                  // Use localhost for webview (triggers automatic closing)
                  // The appUrlOpen listener will also handle custom scheme URLs for direct app opens
                  return `http://localhost?imei=${this.imei}&phone=${cleanedPhone}&subscription=done`;
                },

                get completeSetupDeepLink() {
                  // Custom scheme URL for direct app opens (not from webview)
                  const cleanedPhone = this.devicePhone.replace(/\D/g, "");
                  return `com.techless.wiseos://setup?imei=${this.imei}&phone=${cleanedPhone}&subscription=done`;
                },

                get isToolDrawerEnabled() {
                  return (
                    this.isSubscribed &&
                    Array.isArray(this.features) &&
                    (this.features.includes(KNOX_USER_GROUPS.ADD_ON_TOOL_DRAWER) ||
                      this.features.includes(KNOX_USER_GROUPS.A16_ADD_ON_TOOL_DRAWER))
                  );
                },
                get isFaithToolsEnabled() {
                  return this.isSubscribed && this.features.includes(KNOX_USER_GROUPS.ADD_ON_FAITH_TOOLS);
                },

                isFeatureEnabled(knoxManageId: string, isInverse = false) {
                  const isEnabled = this.features.includes(knoxManageId);
                  return isInverse ? !isEnabled : isEnabled;
                },

                isFeatureEnabledForFeature(feature: Feature) {
                  if (feature.isPortalOnly) return false;
                  const hasRegularId = feature.knoxManageId ? this.features.includes(feature.knoxManageId) : false;
                  const hasA16Id = feature.a16KnoxManageId ? this.features.includes(feature.a16KnoxManageId) : false;
                  const isEnabled = hasRegularId || hasA16Id;
                  return feature.isInverse ? !isEnabled : isEnabled;
                },

                /**
                 * Computes the value of a feature against a given features array.
                 * Mirrors isFeatureEnabledForFeature but accepts a custom array
                 * so we can calculate default values without mutating this.features.
                 */
                getFeatureValueForArray(feature: Feature, featuresArray: string[]): boolean {
                  if (feature.isPortalOnly) return false; // portal-only defaults handled separately
                  const hasRegularId = feature.knoxManageId ? featuresArray.includes(feature.knoxManageId) : false;
                  const hasA16Id = feature.a16KnoxManageId ? featuresArray.includes(feature.a16KnoxManageId) : false;
                  const isEnabled = hasRegularId || hasA16Id;
                  return feature.isInverse ? !isEnabled : isEnabled;
                },

                /**
                 * Builds and logs a map of all feature flags and their current values.
                 * When unsubscribed, values reflect the default state: subscribed with
                 * no flags manually changed (i.e. only the subscription group and
                 * ADD_ON_BLOCK_TOOL_DRAWER are present).
                 */
                logFeatureFlagMap() {
                  // Default features array representing a freshly subscribed, untouched device.
                  // Includes both A15 and A16 block-tool-drawer IDs so the check works
                  // regardless of device model when unsubscribed.
                  const defaultFeaturesArray = [
                    KNOX_USER_GROUPS.SUBSCRIBED,
                    KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER,
                    KNOX_USER_GROUPS.A16_SUBSCRIBED,
                    KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER
                  ];

                  const featuresArray = this.isSubscribed ? this.features : defaultFeaturesArray;

                  const featureFlagMap = new Map<string, { index: number; name: string; value: boolean }>();

                  this.availableFeatures.forEach((feature: Feature, index: number) => {
                    featureFlagMap.set(feature.featureKey || feature.knoxManageId || "", {
                      index,
                      name: feature.name,
                      value: this.getFeatureValueForArray(feature, featuresArray)
                    });
                  });

                  // Add portal-only SHOW_SCREEN_TIME from showScreenTimeComponent state
                  featureFlagMap.set("SHOW_SCREEN_TIME", {
                    index: featureFlagMap.size,
                    name: "Screen Time",
                    value: this.showScreenTimeComponent
                  });

                  // Build compact JSON keyed by stable FEATURES record key: { TOOL_DRAWER: 1 | 0 }
                  const json: Record<string, 0 | 1> = {};
                  featureFlagMap.forEach(({ index: _i, name: _n, value }, key) => {
                    json[key] = value ? 1 : 0;
                  });

                  devLog.log("[FeatureFlags] isSubscribed:", this.isSubscribed);
                  devLog.log("[FeatureFlags]", JSON.stringify(json, null, 2));

                  return featureFlagMap;
                },

                /**
                 * Always upserts DeviceFeatureFlags from live Knox groups (this.features).
                 * Knox is the source of truth for all Knox-backed flags.
                 * SHOW_SCREEN_TIME is sourced from showScreenTimeComponent (loaded from localStorage
                 * before this runs), so no API fetch is needed.
                 * Called once on page load after getFeatures() completes.
                 */
                async syncFeatureFlagsToDb() {
                  if (!this.imei) return;
                  try {
                    const flagMap = this.logFeatureFlagMap();
                    const flags: any = {};
                    flagMap.forEach(({ value }: { value: boolean }, key: string) => {
                      flags[key] = value ? 1 : 0;
                    });
                    await actions.features.upsertFeatureFlags({ imei: this.imei, flags });
                    devLog.log("[FeatureFlags] Synced to DB from Knox for IMEI:", this.imei);
                  } catch (err) {
                    devLog.error("[FeatureFlags] Failed to sync to DB:", err);
                  }
                },

                async checkSubscriptionByImei() {
                  devLog.log(
                    "PAY DEBUG: [M0.5] checkSubscriptionByImei called - checking subscription directly by IMEI"
                  );
                  devLog.log("PAY DEBUG: [M0.5.1] IMEI:", this.imei);
                  devLog.log("PAY DEBUG: [M0.5.2] Device Phone:", this.devicePhone);

                  if (!this.imei) {
                    devLog.log("PAY DEBUG: [M0.5.3] No IMEI available, skipping check");
                    return;
                  }

                  try {
                    // Format phone number for API (must be exactly 12 characters: 123-456-7890)
                    const cleanedPhone = this.devicePhone.replace(/[^0-9]/g, "");
                    const formattedPhoneNumber =
                      cleanedPhone.length === 10
                        ? `${cleanedPhone.slice(0, 3)}-${cleanedPhone.slice(3, 6)}-${cleanedPhone.slice(6)}`
                        : cleanedPhone;

                    devLog.log("PAY DEBUG: [M0.5.4] Formatted phone number:", formattedPhoneNumber);
                    devLog.log("PAY DEBUG: [M0.5.5] Calling validateIsUserSubscribed action");

                    const subscriptionResult = await actions.wisephones.validateIsUserSubscribed.orThrow({
                      imei: this.imei,
                      phoneNumber: formattedPhoneNumber
                    });

                    devLog.log("PAY DEBUG: [M0.5.6] Subscription check result:", subscriptionResult);
                    devLog.log("PAY DEBUG: [M0.5.7] isSubscribed from result:", subscriptionResult?.isSubscribed);

                    const hasSubscription = subscriptionResult?.isSubscribed === true;
                    devLog.log("PAY DEBUG: [M0.5.8] Final hasSubscription:", hasSubscription);

                    if (hasSubscription) {
                      devLog.log("PAY DEBUG: [M0.5.9] ✅ SUBSCRIPTION FOUND! Updating isSubscribed to true");
                      this.isSubscribed = true;

                      // Assign subscription group
                      await this.assignSubscriptionGroupByDeviceModel();
                      devLog.log("PAY DEBUG: [M0.5.10] Subscription group assigned");

                      return true;
                    } else {
                      devLog.log("PAY DEBUG: [M0.5.11] ❌ No subscription found for IMEI");
                      return false;
                    }
                  } catch (error) {
                    devLog.error("PAY DEBUG: [M0.5.12] ERROR checking subscription by IMEI:", error);
                    return false;
                  }
                },

                async validateStripeSession() {
                  devLog.log("PAY DEBUG: [M1] validateStripeSession called on device page");
                  devLog.log("PAY DEBUG: [M1.0] Current IMEI in component:", this.imei);

                  const urlParams = new URLSearchParams(window.location.search);
                  const validatedParam = urlParams.get("validated");
                  let sessionId = urlParams.get("session_id");
                  devLog.log("PAY DEBUG: [M1.1] validated param:", validatedParam, "session_id from URL:", sessionId);

                  // Ensure IMEI is available - extract from URL if still missing
                  if (!this.imei) {
                    const pathMatch = window.location.pathname.match(/\/manage\/([^/?]+)/);
                    if (pathMatch && pathMatch[1]) {
                      this.imei = pathMatch[1];
                      devLog.log("PAY DEBUG: [M1.1.1] Extracted IMEI from URL in validateStripeSession:", this.imei);
                    } else {
                      devLog.log("PAY DEBUG: [M1.1.1] ERROR: Cannot extract IMEI from URL, cannot validate");
                      return;
                    }
                  }

                  // Priority 1: If validated=true is present, trust it and set isSubscribed immediately
                  if (validatedParam === "true") {
                    devLog.log(
                      "PAY DEBUG: [M1.2] ✅ validated=true found in URL - subscription already validated on dashboard"
                    );
                    devLog.log("PAY DEBUG: [M1.2.1] Current isSubscribed before update:", this.isSubscribed);
                    this.isSubscribed = true;
                    devLog.log("PAY DEBUG: [M1.2.2] Updated isSubscribed to:", this.isSubscribed);

                    // Still need to get session_id for group assignment if not already present
                    if (!sessionId || sessionId === "{CHECKOUT_SESSION_ID}") {
                      devLog.log("PAY DEBUG: [M1.2.1] session_id missing, checking sessionStorage");
                      const storedSessionId = sessionStorage.getItem("stripeCheckoutSessionId");
                      const storedImei = sessionStorage.getItem("stripeCheckoutImei");

                      if (storedSessionId && storedImei === this.imei) {
                        devLog.log("PAY DEBUG: [M1.2.2] Found session ID in sessionStorage:", storedSessionId);
                        sessionId = storedSessionId;
                      }
                    }

                    // Assign subscription group
                    await this.assignSubscriptionGroupByDeviceModel();
                    devLog.log("PAY DEBUG: [M1.2.3] Subscription group assigned");

                    // Clean up URL params and sessionStorage
                    const cleanUrl = new URL(window.location.href);
                    cleanUrl.searchParams.delete("validated");
                    cleanUrl.searchParams.delete("session_id");
                    window.history.replaceState({}, "", cleanUrl.toString());
                    devLog.log("PAY DEBUG: [M1.2.4] Cleaned up URL params");

                    // Clear sessionStorage after successful validation
                    if (sessionId) {
                      sessionStorage.removeItem("stripeCheckoutSessionId");
                      sessionStorage.removeItem("stripeCheckoutImei");
                      devLog.log("PAY DEBUG: [M1.2.5] Cleared sessionStorage after validation");
                    }

                    // Final verification - ensure isSubscribed is true before returning
                    devLog.log("PAY DEBUG: [M1.2.6] Final isSubscribed check before return:", this.isSubscribed);
                    if (!this.isSubscribed) {
                      devLog.log(
                        "PAY DEBUG: [M1.2.7] ERROR: isSubscribed should be true but is false! Forcing to true"
                      );
                      this.isSubscribed = true;
                    }
                    devLog.log(
                      "PAY DEBUG: [M1.2.8] Returning from validateStripeSession with isSubscribed:",
                      this.isSubscribed
                    );
                    return;
                  }

                  // Priority 2: Check for session_id in URL
                  // If session_id is missing or is the placeholder, try to get it from sessionStorage
                  if (!sessionId || sessionId === "{CHECKOUT_SESSION_ID}") {
                    devLog.log("PAY DEBUG: [M1.3] session_id missing or is placeholder, checking sessionStorage");
                    const storedSessionId = sessionStorage.getItem("stripeCheckoutSessionId");
                    const storedImei = sessionStorage.getItem("stripeCheckoutImei");

                    if (storedSessionId && storedImei === this.imei) {
                      devLog.log("PAY DEBUG: [M1.3.1] Found session ID in sessionStorage:", storedSessionId);
                      sessionId = storedSessionId;

                      // Update URL with actual session_id
                      const url = new URL(window.location.href);
                      url.searchParams.set("session_id", sessionId);
                      window.history.replaceState({}, "", url.toString());
                    } else {
                      devLog.log("PAY DEBUG: [M1.3.2] No matching session ID in sessionStorage");
                    }
                  }

                  if (!sessionId || sessionId === "{CHECKOUT_SESSION_ID}") {
                    devLog.log("PAY DEBUG: [M1.4] No valid session_id found, skipping validation");
                    return;
                  }

                  // Remove the session_id url param before validation
                  const url = new URL(window.location.href);
                  url.searchParams.delete("session_id");
                  window.history.replaceState({}, "", url.toString());
                  devLog.log("PAY DEBUG: [M1.5] Removed session_id from URL");

                  try {
                    devLog.log("PAY DEBUG: [M1.6] Validating Stripe subscription with session_id:", sessionId);
                    const session = await actions.stripe.validateSubscription.orThrow({
                      sessionId,
                      imei: this.imei
                    });

                    devLog.log("PAY DEBUG: [M1.7] Validation result:", session);
                    devLog.log("PAY DEBUG: [M1.8] isSubscribed:", session?.isSubscribed);

                    if (session?.isSubscribed) {
                      devLog.log(
                        "PAY DEBUG: [M1.9] ✅ Subscription validated via session_id! Updating isSubscribed to true"
                      );
                      devLog.log("PAY DEBUG: [M1.9.1] Current isSubscribed before update:", this.isSubscribed);
                      this.isSubscribed = true;
                      devLog.log("PAY DEBUG: [M1.9.2] Updated isSubscribed to:", this.isSubscribed);
                      // Assign appropriate subscription group based on device model
                      await this.assignSubscriptionGroupByDeviceModel();
                      devLog.log("PAY DEBUG: [M1.10] Subscription group assigned");

                      // Clear sessionStorage only after successful validation
                      sessionStorage.removeItem("stripeCheckoutSessionId");
                      sessionStorage.removeItem("stripeCheckoutImei");
                      devLog.log("PAY DEBUG: [M1.11] Cleared sessionStorage after successful validation");
                    } else {
                      devLog.log("PAY DEBUG: [M1.12] Subscription validation returned false");
                    }
                  } catch (error) {
                    devLog.error("PAY DEBUG: [M1.13] ERROR validating Stripe session:", error);
                  }
                },

                fallbackPollingInterval: null as number | null,

                startFallbackPolling() {
                  devLog.log("PAY DEBUG: [M2] Starting fallback polling for subscription status");

                  // Clear any existing polling
                  this.stopFallbackPolling();

                  const maxAttempts = 5; // Poll for up to 10 seconds (5 * 2s)
                  let attempts = 0;

                  const poll = async () => {
                    attempts++;
                    devLog.log(`PAY DEBUG: [M2.1] Fallback polling attempt ${attempts}/${maxAttempts}`);

                    if (!this.imei || !this.devicePhone) {
                      devLog.log("PAY DEBUG: [M2.2] Missing IMEI or phone number, stopping polling");
                      this.stopFallbackPolling();
                      return;
                    }

                    try {
                      // Format phone number for API (must be exactly 12 characters: 123-456-7890)
                      const cleanedPhone = this.devicePhone.replace(/[^0-9]/g, "");
                      const formattedPhoneNumber =
                        cleanedPhone.length === 10
                          ? `${cleanedPhone.slice(0, 3)}-${cleanedPhone.slice(3, 6)}-${cleanedPhone.slice(6)}`
                          : cleanedPhone;

                      // Use the same action that checks subscription status
                      const subscriptionResult = await actions.wisephones.validateIsUserSubscribed.orThrow({
                        imei: this.imei,
                        phoneNumber: formattedPhoneNumber
                      });

                      const hasSubscription = subscriptionResult?.isSubscribed === true;
                      devLog.log("PAY DEBUG: [M2.3] Poll result - isSubscribed:", hasSubscription);

                      if (hasSubscription) {
                        devLog.log("PAY DEBUG: [M2.4] Subscription detected via polling! Updating status");
                        this.isSubscribed = true;
                        this.stopFallbackPolling();

                        // Assign subscription group
                        this.assignSubscriptionGroupByDeviceModel();
                        devLog.log("PAY DEBUG: [M2.5] Subscription group assigned");

                        // Clear sessionStorage
                        sessionStorage.removeItem("stripeCheckoutSessionId");
                        sessionStorage.removeItem("stripeCheckoutImei");
                        devLog.log("PAY DEBUG: [M2.6] Cleared sessionStorage");
                        return;
                      }

                      if (attempts >= maxAttempts) {
                        devLog.log("PAY DEBUG: [M2.7] Fallback polling timeout reached");
                        this.stopFallbackPolling();
                        // Don't reload - just show the current state
                        devLog.log("PAY DEBUG: [M2.8] Subscription not detected after polling, keeping current state");
                        return;
                      }

                      // Continue polling
                      this.fallbackPollingInterval = window.setTimeout(poll, 2000);
                    } catch (error) {
                      devLog.error("PAY DEBUG: [M2.9] ERROR during fallback polling:", error);
                      this.stopFallbackPolling();
                    }
                  };

                  // Start polling after 2 seconds
                  this.fallbackPollingInterval = window.setTimeout(poll, 2000);
                },

                stopFallbackPolling() {
                  if (this.fallbackPollingInterval !== null) {
                    clearTimeout(this.fallbackPollingInterval);
                    this.fallbackPollingInterval = null;
                    devLog.log("PAY DEBUG: [M2.10] Stopped fallback polling");
                  }
                },

                async init() {
                  devLog.log("PAY DEBUG: [M0] Device page init() called");
                  devLog.log("PAY DEBUG: [M0.1] Initial isSubscribed (from server):", this.isSubscribed);
                  devLog.log("PAY DEBUG: [M0.2] IMEI (from x-init):", this.imei);
                  devLog.log("PAY DEBUG: [M0.3] Device Phone (from x-init):", this.devicePhone);
                  devLog.log("PAY DEBUG: [M0.4] Current URL:", window.location.href);

                  // Extract IMEI from URL pathname as fallback if not set by x-init
                  if (!this.imei) {
                    const pathMatch = window.location.pathname.match(/\/manage\/([^/?]+)/);
                    if (pathMatch && pathMatch[1]) {
                      this.imei = pathMatch[1];
                      devLog.log("PAY DEBUG: [M0.5] Extracted IMEI from URL pathname:", this.imei);
                    } else {
                      devLog.log("PAY DEBUG: [M0.5] Could not extract IMEI from URL pathname");
                    }
                  }

                  // Extract phone number from URL or use fallback if not set
                  if (!this.devicePhone || this.devicePhone === "(111) 111-1111") {
                    // Try to get from URL params (if passed)
                    const urlParams = new URLSearchParams(window.location.search);
                    const phoneParam = urlParams.get("phone");
                    if (phoneParam) {
                      this.devicePhone = phoneParam;
                      devLog.log("PAY DEBUG: [M0.6] Extracted phone from URL params:", this.devicePhone);
                    } else {
                      devLog.log(
                        "PAY DEBUG: [M0.6] Phone not in URL params, will use fallback or skip phone-based checks"
                      );
                    }
                  }

                  devLog.log("PAY DEBUG: [M0.7] Final IMEI after extraction:", this.imei);
                  devLog.log("PAY DEBUG: [M0.8] Final Device Phone after extraction:", this.devicePhone);


                  // Check URL params to determine flow
                  const urlParams = new URLSearchParams(window.location.search);
                  const sessionId = urlParams.get("session_id");
                  const paymentStatus = urlParams.get("payment_status");

                  // If session_id is in URL, server already validated - trust server value
                  if (sessionId && sessionId !== "{CHECKOUT_SESSION_ID}") {
                    devLog.log("PAY DEBUG: [M0.9] Stripe redirect detected - server already validated subscription");
                    devLog.log("PAY DEBUG: [M0.9.1] session_id:", sessionId);
                    devLog.log("PAY DEBUG: [M0.9.2] payment_status:", paymentStatus);
                    devLog.log("PAY DEBUG: [M0.9.3] Trusting server-side isSubscribed value:", this.isSubscribed);

                    // Clean up URL params (remove session_id and payment_status)
                    const cleanUrl = new URL(window.location.href);
                    cleanUrl.searchParams.delete("session_id");
                    cleanUrl.searchParams.delete("payment_status");
                    window.history.replaceState({}, "", cleanUrl.toString());
                    devLog.log("PAY DEBUG: [M0.9.4] Cleaned up URL params");

                    // Clear sessionStorage if present
                    sessionStorage.removeItem("stripeCheckoutSessionId");
                    sessionStorage.removeItem("stripeCheckoutImei");
                    devLog.log("PAY DEBUG: [M0.9.5] Cleared sessionStorage");

                    // If subscribed, assign subscription group (if not already assigned)
                    if (this.isSubscribed && this.imei) {
                      devLog.log("PAY DEBUG: [M0.9.6] Subscription confirmed, assigning subscription group");
                      await this.assignSubscriptionGroupByDeviceModel();
                      devLog.log("PAY DEBUG: [M0.9.7] Subscription group assigned");
                    }
                  } else if (sessionId === "{CHECKOUT_SESSION_ID}" && paymentStatus === "checking") {
                    // Stripe redirect with placeholder session_id (embedded checkout doesn't replace it)
                    // Use stored session_id from sessionStorage to validate
                    devLog.log("PAY DEBUG: [M0.9] Stripe redirect detected but session_id is placeholder");
                    devLog.log("PAY DEBUG: [M0.9.1] Reading real session_id from sessionStorage");

                    const storedSessionId = sessionStorage.getItem("stripeCheckoutSessionId");
                    const storedImei = sessionStorage.getItem("stripeCheckoutImei");

                    if (storedSessionId && this.imei && storedImei === this.imei) {
                      devLog.log("PAY DEBUG: [M0.9.2] Found matching session_id in sessionStorage:", storedSessionId);
                      devLog.log("PAY DEBUG: [M0.9.3] Calling validateSubscription action to set customer metadata");

                      try {
                        // Call validateSubscription action to:
                        // 1. Validate the subscription
                        // 2. Set IMEI on customer metadata (so future searches work)
                        const validationResult = await actions.stripe.validateSubscription.orThrow({
                          sessionId: storedSessionId,
                          imei: this.imei
                        });

                        devLog.log("PAY DEBUG: [M0.9.4] Validation result:", validationResult);
                        devLog.log("PAY DEBUG: [M0.9.5] isSubscribed from validation:", validationResult?.isSubscribed);

                        if (validationResult?.isSubscribed) {
                          devLog.log("PAY DEBUG: [M0.9.6] ✅ Payment successful, subscription is active");
                          this.isSubscribed = true;

                          // Assign subscription group
                          await this.assignSubscriptionGroupByDeviceModel();
                          devLog.log("PAY DEBUG: [M0.9.7] Subscription group assigned");
                        } else {
                          devLog.log("PAY DEBUG: [M0.9.6] ❌ Payment not completed or subscription not active");
                        }
                      } catch (validationError) {
                        devLog.error("PAY DEBUG: [M0.9.8] ERROR validating Stripe session:", validationError);
                        // Continue with normal flow - don't block the page
                      }

                      // Clean up URL params and sessionStorage
                      const cleanUrl = new URL(window.location.href);
                      cleanUrl.searchParams.delete("session_id");
                      cleanUrl.searchParams.delete("payment_status");
                      window.history.replaceState({}, "", cleanUrl.toString());
                      devLog.log("PAY DEBUG: [M0.9.9] Cleaned up URL params");

                      sessionStorage.removeItem("stripeCheckoutSessionId");
                      sessionStorage.removeItem("stripeCheckoutImei");
                      devLog.log("PAY DEBUG: [M0.9.10] Cleared sessionStorage");
                    } else {
                      devLog.log("PAY DEBUG: [M0.9.2] No matching session_id in sessionStorage");
                      devLog.log("PAY DEBUG: [M0.9.2.1] storedSessionId:", storedSessionId ? "exists" : "missing");
                      devLog.log("PAY DEBUG: [M0.9.2.2] this.imei:", this.imei);
                      devLog.log("PAY DEBUG: [M0.9.2.3] storedImei:", storedImei);
                      devLog.log("PAY DEBUG: [M0.9.2.4] IMEI match:", storedImei === this.imei);

                      // Clean up URL params even if sessionStorage doesn't have it
                      const cleanUrl = new URL(window.location.href);
                      cleanUrl.searchParams.delete("session_id");
                      cleanUrl.searchParams.delete("payment_status");
                      window.history.replaceState({}, "", cleanUrl.toString());
                    }
                  } else {
                    // Normal flow: no Stripe redirect
                    devLog.log("PAY DEBUG: [M0.9] Normal navigation - no Stripe redirect");

                    // Check subscription directly by IMEI if phone number is available
                    if (this.imei && this.devicePhone && this.devicePhone !== "(111) 111-1111") {
                      devLog.log("PAY DEBUG: [M0.10] Running IMEI-based subscription check");
                      const subscriptionFound = await this.checkSubscriptionByImei();
                      devLog.log("PAY DEBUG: [M0.11] IMEI check result - subscriptionFound:", subscriptionFound);
                      devLog.log("PAY DEBUG: [M0.12] isSubscribed after IMEI check:", this.isSubscribed);
                    } else {
                      devLog.log("PAY DEBUG: [M0.10] Skipping IMEI check - missing IMEI or valid phone number");
                    }

                    // Check for any leftover session_id in sessionStorage (edge case)
                    const storedSessionId = sessionStorage.getItem("stripeCheckoutSessionId");
                    if (storedSessionId && this.imei) {
                      devLog.log("PAY DEBUG: [M0.13] Found leftover session_id in sessionStorage, cleaning up");
                      sessionStorage.removeItem("stripeCheckoutSessionId");
                      sessionStorage.removeItem("stripeCheckoutImei");
                    }
                  }

                  devLog.log("PAY DEBUG: [M0.15] Final isSubscribed state after all checks:", this.isSubscribed);

                  // Load cached total apps count on initialization
                  this.loadCachedTotalApps();

                  // Watch for IMEI to be set before fetching features (same pattern as device/[imei].astro)
                  this.$watch("imei", async (value) => {
                    try {
                      if (this.imei) {
                        // Reload cached total apps when IMEI changes
                        this.loadCachedTotalApps();
                        await this.getFeatures();
                      }
                    } catch (error) {
                      devLog.error("Failed to load features:", error);
                      this.isLoading = false;
                    }
                  });

                  // Watch for currentTab changes - load apps when Tool Management tab is clicked
                  this.$watch("currentTab", async (newTab) => {
                    if (newTab === "app-management") {
                      // Open installed apps section by default when entering this tab
                      this.installedOpen = true;
                      // Load available apps immediately (fast, no API call)
                      if (!this.isAvailableAppsLoaded) {
                        this.loadAvailableApps();
                      }
                      // Fetch installed apps from API (slow, async)
                      if (!this.isAppsLoaded && !this.isAppsLoading) {
                        await this.getInstalledApps();
                      }
                    }
                  });

                  // Watch for appSearchQuery changes - collapse/expand installed apps section
                  this.$watch("appSearchQuery", (query) => {
                    if (query && query.trim().length > 0) {
                      // User is searching - collapse installed apps section
                      this.installedOpen = false;
                    } else {
                      // Search is cleared - reopen installed apps section
                      this.installedOpen = true;
                    }
                  });

                  // Watch for features changes to manage Knox groups and load Tool Drawer
                  this.$watch("features", async (userGroups: string[]) => {
                    // Check if device is subscribed but doesn't have any subscription group
                    if (this.isSubscribed) {
                      const hasSubscribedGroup =
                        userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                        userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                      if (!hasSubscribedGroup) {
                        // Assign appropriate subscription group based on device model
                        await this.assignSubscriptionGroupByDeviceModel();
                      }
                    }

                    // Ensure no conflicting Knox groups
                    await this.removeExclusiveGroups(userGroups);

                    // Load Tool Drawer data client-side when Tool Drawer feature is enabled
                    if (this.isToolDrawerEnabled && !this.isToolDrawerLoaded) {
                      this.loadToolDrawer();
                    }
                  });

                  // Watch for installedApps changes
                  this.$watch("installedApps", (apps) => {
                    this.logGoogleManagedApps();
                  });

                  // If IMEI is already set, fetch features immediately (but not apps - wait for tab click)
                  // This is the main blocking operation - keep loading until it completes
                  if (this.imei) {
                    try {
                      // getFeatures() will set isLoading = false when done
                      await this.getFeatures();
                    } catch (error) {
                      devLog.error("Failed to load features:", error);
                      this.isLoading = false;
                    }
                  } else {
                    // If no IMEI, don't show loading
                    this.isLoading = false;
                  }

                  // Log feature flag map after features are loaded
                  this.logFeatureFlagMap();

                  // Sync feature flags to DB (write if no record exists yet)
                  await this.syncFeatureFlagsToDb();

                  // Log all Google-managed apps excluding system apps
                  this.logGoogleManagedApps();

                  // Auto-trigger completeSetup if device is subscribed and not set up (mobile only)
                  const isMobile = window.innerWidth < 640; // Tailwind sm breakpoint
                  devLog.log("PAY DEBUG: [M0.16] Checking deeplink trigger conditions:");
                  devLog.log("PAY DEBUG: [M0.16.0] isMobile:", isMobile);
                  devLog.log("PAY DEBUG: [M0.16.1] isSubscribed:", this.isSubscribed);
                  devLog.log("PAY DEBUG: [M0.16.2] isPhoneSetUp:", this.isPhoneSetUp);
                  devLog.log("PAY DEBUG: [M0.16.3] devicePhone:", this.devicePhone);
                  devLog.log("PAY DEBUG: [M0.16.4] devicePhone is placeholder?", this.devicePhone === "(111) 111-1111");

                  const condition1 = isMobile;
                  const condition2 = this.isSubscribed;
                  const condition3 = !this.isPhoneSetUp;
                  const condition4 = !!this.devicePhone;
                  const condition5 = this.devicePhone !== "(111) 111-1111";

                  devLog.log("PAY DEBUG: [M0.16.5] Condition 1 (isMobile):", condition1);
                  devLog.log("PAY DEBUG: [M0.16.6] Condition 2 (isSubscribed):", condition2);
                  devLog.log("PAY DEBUG: [M0.16.7] Condition 3 (!isPhoneSetUp):", condition3);
                  devLog.log("PAY DEBUG: [M0.16.8] Condition 4 (devicePhone exists):", condition4);
                  devLog.log("PAY DEBUG: [M0.16.9] Condition 5 (devicePhone not placeholder):", condition5);

                  if (condition1 && condition2 && condition3 && condition4 && condition5) {
                    devLog.log("PAY DEBUG: [M0.16.10] ✅ All conditions passed - triggering deeplink");
                    this.completeSetup();
                  } else {
                    devLog.log("PAY DEBUG: [M0.16.10] ❌ Conditions not met - deeplink not triggered");
                    if (!condition1) devLog.log("PAY DEBUG: [M0.16.11] Reason: Not mobile view (desktop/web)");
                    if (!condition2) devLog.log("PAY DEBUG: [M0.16.12] Reason: Device is not subscribed");
                    if (!condition3) devLog.log("PAY DEBUG: [M0.16.13] Reason: Phone is already set up");
                    if (!condition4) devLog.log("PAY DEBUG: [M0.16.14] Reason: Phone number is missing");
                    if (!condition5) devLog.log("PAY DEBUG: [M0.16.15] Reason: Phone number is placeholder");
                  }
                },

                logGoogleManagedApps() {
                  // Logging removed - function kept for compatibility
                }
              };
            });

            // Stripe subscription handler for "I have a data plan with my own carrier" button
            Alpine.data("stripeSubscription", function () {
              return {
                customerEmail: "",
                deviceIMEI: "",
                isSubscribed: false,
                isStripeLoaded: false,
                isEmbedded: false,
                stripeInstance: undefined as Stripe | undefined,
                sessionClientSecret: undefined as string | undefined,
                async handleStripeClick() {
                  if (!this.sessionClientSecret) {
                    const data = await actions.stripe.createSubscriptionPage.orThrow({
                      customerEmail: this.customerEmail,
                      deviceIMEI: this.deviceIMEI
                    });
                    this.sessionClientSecret = data.session.client_secret as string;
                  }

                  if (!this.isEmbedded) {
                    const checkout = await this.stripeInstance?.initEmbeddedCheckout({
                      clientSecret: this.sessionClientSecret
                    });
                    checkout?.mount("#stripe-subscription-element");
                    this.isEmbedded = true;
                  }

                  (this.$refs.stripeDialog as HTMLDialogElement).showModal();
                },
                async initializeStripe() {
                  const stripe = await loadStripe(STRIPE_PUBLIC_KEY);
                  if (!stripe) {
                    throw new Error("Stripe is not loaded");
                  }

                  this.stripeInstance = stripe;
                  this.isStripeLoaded = true;
                },
                init() {
                  this.initializeStripe();
                }
              };
            });

            // Console test function: testFeatureFlags("350XXXXXXXXXXXX")
            (window as any).testFeatureFlags = async (imei: string) => {
              const res = await fetch(`/api/device-features/${imei}.json`);
              if (!res.ok) {
                console.error(`[testFeatureFlags] Error ${res.status}:`, await res.text());
                return null;
              }
              const data = await res.json();
              console.log(`[testFeatureFlags] IMEI: ${data.imei}`);
              console.log(`[testFeatureFlags] Updated: ${data.updatedAt}`);
              console.log("[testFeatureFlags] Flags:", JSON.stringify(data.flags, null, 2));
              return data;
            };
          </script>
        </div>
      </div>
    </main>
  </div>
</Layout>
