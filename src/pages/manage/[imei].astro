                <div class="px-6 pb-6 space-y-7">
                  <div>
                    <label class="block text-base text-gray-700">Name</label>
                    <input
                      type="text"
                      x-model="editName"
                      maxlength="15"
                      class="w-full mt-3 pl-6 pb-3 pt-1 text-m text-gray-700 tracking-wide"
                    />
                  </div>

                  <div>
                    <label class="block text-base text-gray-700">IMEI</label>
                    <input
                      type="text"
                      x-model="editImei"
                      readonly
                      class="w-full mt-3 pl-6 pb-3 pt-1 text-m text-gray-700 tracking-wide"
                    />
                  </div>

                  <div>
                    <label class="block text-base text-gray-700">Phone Number</label>
                    <input
                      type="text"
                      x-model="editPhoneNumber"
                      @input="formatPhoneNumber($event)"
                      placeholder="222-222-2222"
                      maxlength="12"
                      class="w-full mt-3 pl-6 pb-3 pt-1 text-m text-gray-700 tracking-wide"
                    />
                  </div>
                </div>

                <!-- Footer -->
                <div class="px-6 pb-6 flex justify-end gap-4">
                  <button
                    @click="closeEditModal()"
                    class="px-8 py-3 text-base font-semibold text-gray-900 bg-white
                     border-2 border-gray-900 rounded-md hover:bg-gray-50"
                  >
                    Cancel
                  </button>
                  <button
                    @click="saveDeviceDetails()"
                    class="px-8 py-3 text-base font-semibold text-white bg-gray-700
                     rounded-md hover:bg-gray-800"
                  >
                    Update
                  </button>
                </div>
              </div>
            </div>

            <!-- Remove Device Modal -->
            <div
              x-show="showRemoveModal"
              x-cloak
              @click.self="showRemoveModal = false"
              class="absolute inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4"
            >
              <div @click.stop class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">Remove Device?</h3>

                <p class="text-sm text-gray-700 leading-relaxed">
                  Are you sure you want to remove this device from your account? You can re-add it later by selecting
                  "Add Device" on the Devices page.
                </p>

                <form action={actions.wisephones.deleteWisephone} method="POST">
                  <input type="hidden" name="imei" x-bind:value="imei" />
                  <div class="flex justify-end gap-3 pt-2">
                    <button
                      type="button"
                      @click="showRemoveModal = false"
                      class="px-4 py-2 text-sm font-medium text-white bg-gray-800 rounded hover:bg-gray-700 transition-colors"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors"
                    >
                      Remove Device
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <script is:inline define:vars={{ appsJsonData }}>
            window.APPS_JSON_DATA = appsJsonData;
          </script>
          <script>
            import Alpine from "alpinejs";
            import { actions } from "astro:actions";
            import {
              KNOX_USER_GROUPS,
              updateUnreachableAlpineState,
              getPackageNameFromPlayStoreUrl,
              STRIPE_PUBLIC_KEY,
              type Feature
            } from "@/libs/utils";
            import { loadStripe, type Stripe } from "@stripe/stripe-js";
            import { AppManagementService } from "@/services/AppManagementService";
            import { FeatureManagementService } from "@/services/FeatureManagementService";
            import type { AppEntry } from "@/types/apps";
            import { DEFAULT_SYSTEM_APPS, getInstalledSystemApps, getSystemAppPackageNames } from "@/utils/system-apps";

            const appManagement = new AppManagementService();
            const featureManagement = new FeatureManagementService();

            Alpine.data("manageDevice", function () {
              return {
                currentTab: "device-info",
                appsList: {} as Record<string, Omit<AppEntry, "packageName">>,
                installedApps: [] as {
                  packageName: string;
                  appName: string;
                  isGoogleManaged: "Y" | "N";
                  systemApp?: string;
                }[],
                appSearchQuery: "",
                features: [] as string[],
                availableFeatures: [] as Feature[],
                isSubscribed: false,
                imei: "",
                deviceName: "",
                userName: "",
                userPhone: "",
                userEmail: "",
                enableScreenTime: false,
                deviceInfo: null as { resultValue?: { [key: string]: any } } | null,

                isEditing: false,
                devicePhone: "",
                originalDeviceName: "",
                originalDevicePhone: "",
                isLoading: true,
                isToolDrawerLoading: false,
                isToolDrawerLoaded: false,
                isAppsLoading: false,
                isAppsLoaded: false,
                isAvailableAppsLoaded: false,
                mobileMenuOpen: false,
                showAccountMenu: false,
                showConfirmModal: false,
                pendingFeature: null as Feature | null,
                pendingFeatureEnabled: false,
                confirmationMessage: "",
                showDisclosureFor: null as string | null,
                showAppInstallModal: false,
                pendingAppToInstall: null as string | null,
                pendingAppName: "",
                showAppUninstallModal: false,
                pendingAppToUninstall: null as string | null,
                pendingAppToUninstallName: "",
                showEditModal: false,
                editName: "",
                editImei: "",
                editPhoneNumber: "",
                showRemoveModal: false,
                cachedTotalApps: 0,
                installedOpen: false,
                // @ts-ignore
                isPhoneSetUp: this.$persist(false),
                // TODO :  Not a todo, but note to the future dev : all apps are embedded inside apps.json file,
                // TODO :since ottogrid support is not available and Healthy Tech Index is not yet integrated
                // TODO : apps in apps.json  from line 4 to 2537 are faith tools apps and the rest are from ottogrid (approved apps)
                get totalAppsCount() {
                  // Use cached value if available, otherwise calculate from current state
                  if (this.cachedTotalApps > 0) {
                    return this.cachedTotalApps;
                  }
                  return this.systemApps.length + this.installedFilteredApps.length;
                },
                updateCachedTotalApps() {
                  const total = this.systemApps.length + this.installedFilteredApps.length;
                  this.cachedTotalApps = total;
                  // Save to localStorage with IMEI as key
                  if (this.imei) {
                    try {
                      localStorage.setItem(`totalApps_${this.imei}`, String(total));
                    } catch (error) {
                      console.error("Failed to save total apps to localStorage:", error);
                    }
                  }
                },
                loadCachedTotalApps() {
                  if (this.imei) {
                    try {
                      const cached = localStorage.getItem(`totalApps_${this.imei}`);
                      if (cached) {
                        this.cachedTotalApps = parseInt(cached, 10) || 0;
                      }
                    } catch (error) {
                      console.error("Failed to load total apps from localStorage:", error);
                    }
                  }
                },
                get availableApps() {
                  // Only show apps that are NOT installed
                  // Also double-check against installedApps array to ensure no installed apps slip through
                  let apps = Object.entries(this.appsList)
                    .filter(([packageName, app]) => {
                      // First check: app.installed flag must be false
                      if (app.installed) {
                        return false;
                      }
                      // Second check: verify it's not in installedApps array (defensive check)
                      const isInInstalledApps = (this.installedApps || []).some(
                        (installedApp: { packageName: string }) =>
                          installedApp && installedApp.packageName && installedApp.packageName === packageName
                      );
                      return !isInInstalledApps;
                    })
                    .map(([packageName, app]) => ({ packageName, ...app }));

                  // Filter by search query (searches both name and category)
                  if (this.appSearchQuery) {
                    const query = this.appSearchQuery.toLowerCase();
                    apps = apps.filter(
                      (app) =>
                        app.name.toLowerCase().includes(query) ||
                        (app.category && app.category.toLowerCase().includes(query))
                    );
                  }

                  return apps;
                },

                get systemApps() {
                  // Get installed system apps based on the device model
                  const deviceModel = this.deviceName || ""; // Use device name/model if available
                  // Filter out null/undefined values from installedApps before processing
                  const validInstalledApps = (this.installedApps || []).filter((app) => app && app.packageName);
                  const result = getInstalledSystemApps(validInstalledApps, deviceModel);
                  // Ensure result doesn't contain null values
                  let filteredResult = result.filter((app) => app && app.packageName);

                  // Enrich with icon URLs from appsList if available
                  filteredResult = filteredResult.map((app) => {
                    const appFromList = this.appsList?.[app.packageName];
                    return {
                      ...app,
                      iconUrl: appFromList?.iconUrl || undefined
                    };
                  });

                  return filteredResult;
                },

                get installedFilteredApps() {
                  // Filter out null/undefined values first
                  const validInstalledApps = (this.installedApps || []).filter(
                    (app) => app && (app.packageName || app.appName)
                  );

                  // Show all installed apps from the device (filtered by isGoogleManaged === "Y")
                  let apps = validInstalledApps
                    .filter((app) => app && app.isGoogleManaged === "Y")
                    .map((app) => ({
                      packageName: app.packageName || app.appName || "unknown",
                      name: app.appName || app.packageName || "Unknown App",
                      installed: true,
                      source: "Tool Drawer" as const
                    }))
                    .filter((app) => app && app.packageName && app.packageName !== "unknown");

                  // Also include apps from appsList that are marked as installed
                  const appsListInstalled = Object.entries(this.appsList || {})
                    .filter(([packageName, app]) => app && app.installed && packageName)
                    .map(([packageName, app]) => ({ packageName, ...app }))
                    .filter((app) => app && app.packageName);

                  // Merge and deduplicate by packageName, prioritizing appsList data (which has icons)
                  const appsMap = new Map();
                  apps.forEach((app) => {
                    if (app && app.packageName) {
                      appsMap.set(app.packageName, app);
                    }
                  });
                  appsListInstalled.forEach((app) => {
                    if (app && app.packageName) {
                      // If already exists, merge to preserve iconUrl from appsList
                      const existing = appsMap.get(app.packageName);
                      if (existing) {
                        appsMap.set(app.packageName, { ...existing, ...app, iconUrl: app.iconUrl || existing.iconUrl });
                      } else {
                        appsMap.set(app.packageName, app);
                      }
                    }
                  });
                  apps = Array.from(appsMap.values()).filter((app) => app && app.packageName);

                  // Filter out system apps (they're shown in a separate section)
                  const systemAppPackages = getSystemAppPackageNames();
                  apps = apps.filter((app) => app && app.packageName && !systemAppPackages.includes(app.packageName));

                  // Sort by name
                  apps.sort((a, b) => {
                    if (!a || !b || !a.name || !b.name) return 0;
                    return a.name.localeCompare(b.name);
                  });

                  // Final filter to ensure no null values
                  const finalApps = apps.filter((app) => app && app.packageName && app.name);

                  return finalApps;
                },

                async getFeatures() {
                  if (!this.imei) {
                    console.error("IMEI is not set, cannot fetch features");
                    this.isLoading = false;
                    return;
                  }

                  // Ensure loading is true at the start
                  this.isLoading = true;

                  try {
                    const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                    url.searchParams.set("action", "get-device-groups");
                    url.searchParams.set("imei", this.imei);

                    const res = await fetch(url, { method: "GET" });

                    if (!res.ok) {
                      throw new Error(`Failed to fetch features: ${res.status} ${res.statusText}`);
                    }

                    const data = await res.json();

                    // Handle both old format (array) and new format (object with groups and deviceInfo)
                    if (Array.isArray(data)) {
                      // Old format - backward compatibility
                      this.features = data;
                      this.deviceInfo = null;
                    } else {
                      // New format - includes device info
                      this.features = data.groups || [];
                      this.deviceInfo = data.deviceInfo || null;
                    }
                  } catch (error) {
                    console.error("Error fetching features:", error);
                    this.showErrorToast("Failed to load device features. Please try again.");
                  } finally {
                    // Set loading to false after all operations complete
                    this.isLoading = false;
                  }
                },

                getDeviceModel(): string {
                  if (!this.deviceInfo?.resultValue) return "";

                  // Try different possible field names for device model
                  const resultValue = this.deviceInfo.resultValue;
                  return (
                    resultValue.modelName ||
                    resultValue.deviceModel ||
                    resultValue.model ||
                    resultValue.deviceName ||
                    resultValue.modelNumber ||
                    ""
                  );
                },

                isA16Device(): boolean {
                  const model = this.getDeviceModel();
                  if (!model) return false;

                  // Check if model contains "A16" (case insensitive)
                  return model.toUpperCase().includes("A16");
                },

                /**
                 * Fetches device model directly from Knox API
                 */
                async getDeviceModelFromKnox(): Promise<string | null> {
                  try {
                    const deviceInfoUrl = new URL(`/api/samsung-knox.json`, window.location.origin);
                    deviceInfoUrl.searchParams.set("action", "get-device-info");
                    deviceInfoUrl.searchParams.set("imei", this.imei);

                    const deviceInfoRes = await fetch(deviceInfoUrl, { method: "GET" });
                    if (!deviceInfoRes.ok) {
                      return null;
                    }

                    const deviceInfo = await deviceInfoRes.json();
                    const rv = deviceInfo?.resultValue;
                    if (!rv) {
                      return null;
                    }

                    const model =
                      rv.deviceModelName ||
                      rv.modelName ||
                      rv.deviceModel ||
                      rv.model ||
                      rv.deviceName ||
                      rv.name ||
                      null;

                    return model;
                  } catch (error) {
                    console.error("Error fetching device model:", error);
                    return null;
                  }
                },

                /**
                 * Gets the appropriate group ID for a feature based on device model
                 */
                getGroupIdForFeature(feature: Feature): string {
                  if (this.isA16Device() && feature.a16KnoxManageId) {
                    return feature.a16KnoxManageId;
                  }
                  return feature.knoxManageId;
                },

                /**
                 * Checks device model and assigns appropriate subscription group
                 * - A16 devices -> A16_SUBSCRIBED group
                 * - A15 and other devices -> SUBSCRIBED group (default)
                 */
                async assignSubscriptionGroupByDeviceModel() {
                  try {
                    const deviceModel = await this.getDeviceModelFromKnox();
                    if (!deviceModel) {
                      console.warn("Could not determine device model, using default SUBSCRIBED group");
                      // Default to SUBSCRIBED if we can't determine model
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                      return;
                    }

                    const modelUpper = deviceModel.toUpperCase();

                    // Check if device is A16
                    if (modelUpper.includes("A16") || modelUpper.includes("SM-A16")) {
                      console.log(`Device model detected as A16: ${deviceModel}, assigning to A16_SUBSCRIBED group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                    } else {
                      // Default to SUBSCRIBED for A15 and all other devices
                      console.log(`Device model: ${deviceModel}, assigning to SUBSCRIBED group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                    }
                  } catch (error) {
                    console.error("Error assigning subscription group by device model:", error);
                    // Fallback to default SUBSCRIBED group on error
                    await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                    this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                  }
                },

                /**
                 * Checks device model and assigns appropriate unpaid group
                 * - A16 devices -> A16_UNPAID group
                 * - A15 and other devices -> UNPAID group (default)
                 */
                async assignUnpaidGroupByDeviceModel() {
                  try {
                    const deviceModel = await this.getDeviceModelFromKnox();
                    if (!deviceModel) {
                      console.warn("Could not determine device model, using default UNPAID group");
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                      this.features.push(KNOX_USER_GROUPS.UNPAID);
                      return;
                    }

                    const modelUpper = deviceModel.toUpperCase();

                    if (modelUpper.includes("A16") || modelUpper.includes("SM-A16")) {
                      console.log(`A16 device detected, assigning to A16_UNPAID group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_UNPAID);
                      this.features.push(KNOX_USER_GROUPS.A16_UNPAID);
                    } else {
                      // Default to UNPAID for A15 and all other devices
                      console.log(`Non-A16 device, assigning to UNPAID group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                      this.features.push(KNOX_USER_GROUPS.UNPAID);
                    }
                  } catch (error) {
                    console.error("Error assigning unpaid group by device model:", error);
                    // Fallback to default UNPAID group on error
                    await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                    this.features.push(KNOX_USER_GROUPS.UNPAID);
                  }
                },

                /**
                 * Ensures a device has the correct Knox user group configuration
                 */
                async removeExclusiveGroups(userGroups: string[]) {
                  const exclusiveGroups = this.getExclusiveGroups(userGroups);
                  if (!this.hasMultipleExclusiveGroups(exclusiveGroups)) {
                    await this.ensureBaseGroup(userGroups);
                  } else {
                    await this.removeIncompatibleFeatures(userGroups);
                  }
                },

                /**
                 * Gets the list of exclusive groups from the user's current groups
                 */
                getExclusiveGroups(userGroups: string[]): string[] {
                  return userGroups.filter(
                    (group) =>
                      group === KNOX_USER_GROUPS.UNPAID ||
                      group === KNOX_USER_GROUPS.SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_UNPAID
                  );
                },

                /**
                 * Checks if the device has more than one exclusive group assigned
                 */
                hasMultipleExclusiveGroups(exclusiveGroups: string[]): boolean {
                  return exclusiveGroups.length > 1;
                },

                /**
                 * Ensures the device has at least one base group
                 */
                async ensureBaseGroup(userGroups: string[]) {
                  const hasBaseGroup = userGroups.some(
                    (group) =>
                      group === KNOX_USER_GROUPS.UNPAID ||
                      group === KNOX_USER_GROUPS.SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_UNPAID
                  );
                  if (!hasBaseGroup) {
                    if (this.isSubscribed) {
                      await this.assignSubscriptionGroupByDeviceModel();
                    } else {
                      await this.assignUnpaidGroupByDeviceModel();
                    }
                  }
                },

                /**
                 * Removes incompatible feature combinations from the device
                 */
                async removeIncompatibleFeatures(userGroups: string[]) {
                  const featuresToRemove = this.getIncompatibleFeatures(userGroups);
                  for (const knoxManageId of featuresToRemove) {
                    await this.removeFeatureFromDevice(knoxManageId);
                  }
                  window.location.reload();
                },

                /**
                 * Determines which features need to be removed to resolve conflicts
                 */
                getIncompatibleFeatures(userGroups: string[]): string[] {
                  const featuresToRemove: string[] = [];

                  // Remove UNPAID if present with any subscription group
                  if (userGroups.includes(KNOX_USER_GROUPS.UNPAID)) {
                    if (
                      userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                      userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                    ) {
                      featuresToRemove.push(KNOX_USER_GROUPS.UNPAID);
                    }
                  }

                  // Remove A16_UNPAID if present with any subscription group
                  if (userGroups.includes(KNOX_USER_GROUPS.A16_UNPAID)) {
                    if (
                      userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                      userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                    ) {
                      featuresToRemove.push(KNOX_USER_GROUPS.A16_UNPAID);
                    }
                  }

                  // Remove SUBSCRIBED if A16_SUBSCRIBED is present
                  if (
                    userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) &&
                    userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                  ) {
                    featuresToRemove.push(KNOX_USER_GROUPS.SUBSCRIBED);
                  }

                  // Remove UNPAID if A16_UNPAID is present
                  if (
                    userGroups.includes(KNOX_USER_GROUPS.UNPAID) &&
                    userGroups.includes(KNOX_USER_GROUPS.A16_UNPAID)
                  ) {
                    featuresToRemove.push(KNOX_USER_GROUPS.UNPAID);
                  }

                  return featuresToRemove;
                },

                /**
                 * Adds a feature to the device using the Knox API
                 */
                async addFeatureToDevice(knoxManageId: string) {
                  const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                  url.searchParams.set("action", "apply-feature");
                  url.searchParams.set("imei", this.imei);
                  url.searchParams.set("knoxManageId", knoxManageId);
                  await fetch(url, { method: "POST" });
                },

                /**
                 * Removes a feature from the device using the Knox API
                 */
                async removeFeatureFromDevice(knoxManageId: string) {
                  const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                  url.searchParams.set("action", "remove-feature");
                  url.searchParams.set("imei", this.imei);
                  url.searchParams.set("knoxManageId", knoxManageId);
                  await fetch(url, { method: "POST" });
                },

                // Load available apps from apps.json - both Tool Drawer and Faith Tools
                // This should be called immediately when App Management tab is clicked
                loadAvailableApps() {
                  if (this.isAvailableAppsLoaded) {
                    return;
                  }

                  try {
                    console.log("[DEBUG] Loading available apps from apps.json...");
                    const updatedAppsList: Record<string, Omit<AppEntry, "packageName">> = {};

                    // Load apps from apps.json - filter for apps where "Tool Drawer" === "Yes" OR "faith.tools"
                    const appsJsonData = (window as any).APPS_JSON_DATA || { rows: [] };
                    const appsFromJson = (appsJsonData.rows || []).filter((row: any) => {
                      const toolDrawer = row.cells && row.cells["Tool Drawer"];
                      return toolDrawer === "Yes" || toolDrawer === "faith.tools";
                    });

                    appsFromJson.forEach((row: any) => {
                      try {
                        const cells = row.cells || {};
                        const playStoreUrl = cells["Play Store URL"];
                        const toolName = cells["Tool Name"]?.trim() || "Unknown App";
                        const iconUrl = cells["Play Store Icon URL"] || "";

                        if (!playStoreUrl || playStoreUrl === "n/a") return;

                        const packageName = getPackageNameFromPlayStoreUrl(playStoreUrl);
                        if (!packageName) return;

                        // Skip if already added (deduplication)
                        if (updatedAppsList[packageName]) return;

                        // Check if app is installed by comparing with installedApps
                        const isInstalled = (this.installedApps || []).some(
                          (installedApp: { packageName: string }) =>
                            installedApp && installedApp.packageName === packageName
                        );

                        // Determine source based on Tool Drawer value
                        const toolDrawerValue = cells["Tool Drawer"];
                        const source = toolDrawerValue === "faith.tools" ? "faith.tools" : "Tool Drawer";

                        const category = cells["Play Store Category"] || "";

                        updatedAppsList[packageName] = {
                          source: source as "faith.tools" | "Tool Drawer",
                          installed: isInstalled,
                          name: toolName,
                          iconUrl: iconUrl || undefined,
                          category: category || undefined
                        };
                      } catch (appError) {
                        console.error("Error processing app from apps.json:", appError);
                      }
                    });

                    // Sort apps by name
                    this.appsList = Object.fromEntries(
                      Object.entries(updatedAppsList).sort(([, a], [, b]) => a.name.localeCompare(b.name))
                    );

                    this.isAvailableAppsLoaded = true;
                    console.log(
                      `[DEBUG] Loaded ${Object.keys(this.appsList).length} available apps from apps.json (Tool Drawer + Faith Tools)`
                    );
                  } catch (error) {
                    console.error("Error loading available apps:", error);
                  }
                },

                // Fetch installed apps from Samsung Knox API when App Management tab is clicked
                // Flow:
                // 1. User clicks "App Management" tab -> currentTab watcher triggers
                // 2. loadAvailableApps() is called immediately (fast, no API call)
                // 3. This function fetches installed apps from Samsung Knox API (async, slow)
                // 4. Updates installedApps array
                // 5. Updates appsList to mark which available apps are installed
                // 6. System apps are automatically classified via systemApps getter (reactive)
                // 7. Installed apps are automatically filtered via installedFilteredApps getter (reactive)
                // 8. UI updates automatically via Alpine.js reactivity
                async getInstalledApps() {
                  if (!this.imei || this.isAppsLoading || this.isAppsLoaded) {
                    return;
                  }

                  try {
                    this.isAppsLoading = true;

                    const formData = new FormData();
                    formData.append("imei", String(this.imei));

                    console.log("[TESTING] non-blocking implementation");
                    const response = await fetch("/_actions/wisephones.getInstalledApps", {
                      method: "POST",
                      body: formData
                    });

                    if (!response.ok) {
                      throw new Error(`Failed to fetch installed apps: ${response.status} ${response.statusText}`);
                    }

                    // Check the raw response text first to see what we're actually getting
