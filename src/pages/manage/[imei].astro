            </div>

            <!-- App Uninstall Confirmation Modal -->
            <div
              x-show="showAppUninstallModal"
              x-cloak
              @click.self="cancelAppUninstall()"
              class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4"
            >
              <div @click.stop class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">
                  Are you sure you want to uninstall <span x-text="pendingAppToUninstallName"></span>?
                </h3>

                <p class="text-sm text-gray-700 leading-relaxed">
                  All app data will be permanently deleted. This cannot be undone.
                </p>

                <div class="flex justify-end gap-3 pt-2">
                  <button
                    @click="cancelAppUninstall()"
                    class="px-4 py-2 text-sm font-medium text-white bg-gray-800 rounded hover:bg-gray-700 transition-colors"
                  >
                    Cancel
                  </button>
                  <button
                    @click="confirmAppUninstall()"
                    class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors"
                  >
                    Uninstall
                  </button>
                </div>
              </div>
            </div>

            <!-- Screen Time Confirmation Modal -->
            <div
              x-show="showScreenTimeConfirmModal"
              x-cloak
              @click.self="cancelScreenTimeToggle()"
              class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4"
            >
              <div @click.stop class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">Are you sure?</h3>

                <p class="text-sm text-gray-700 leading-relaxed" x-text="pendingScreenTimeValue ? 'I acknowledge turning on this feature will enable screen time metrics to be shown in the Wisephone Portal.' : 'I acknowledge turning off this feature will disable screen time metrics to be shown in the Wisephone Portal.'"></p>

                <div class="flex justify-end gap-3 pt-2">
                  <button
                    @click="cancelScreenTimeToggle()"
                    class="px-4 py-2 text-sm font-medium text-white bg-gray-800 rounded hover:bg-gray-700 transition-colors"
                  >
                    Cancel
                  </button>
                  <button
                    @click="confirmScreenTimeToggle()"
                    class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors"
                    x-text="pendingScreenTimeValue ? 'Turn On' : 'Turn Off'"
