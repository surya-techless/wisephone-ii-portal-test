                    // Try to parse the JSON
                    let result;
                    try {
                      result = JSON.parse(responseText);
                    } catch (parseError) {
                      console.error("[DEBUG] Failed to parse JSON:", parseError);
                      console.error("[DEBUG] Response text:", responseText);
                      throw new Error("Failed to parse response as JSON");
                    }

                    console.log("[DEBUG] Raw result from fetch:", {
                      resultType: typeof result,
                      isArray: Array.isArray(result),
                      resultLength: Array.isArray(result) ? result.length : null,
                      resultKeys: result && !Array.isArray(result) ? Object.keys(result) : [],
