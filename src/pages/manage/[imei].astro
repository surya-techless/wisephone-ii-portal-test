                              </div>
                              <div class="flex flex-col min-w-0">
                                <span class="text-sm text-gray-900 truncate" x-text="app.name"></span>
                                <span class="text-xs text-gray-500">System App</span>
                              </div>
                            </div>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Allow Tool Drawer Toggle -->
                <div
                  x-show="toolDrawerInPhoneFeature"
                  x-cloak
                  class="mt-4 md:max-w-[500px]"
                >
                  <div
                    class="flex items-center justify-between p-4 border border-gray-300 rounded-lg transition-colors"
                    :class="isSubscribed ? 'hover:bg-gray-50 cursor-pointer' : 'opacity-50 cursor-not-allowed'"
                  >
                    <div class="flex-1 pr-4">
                      <h4
                        class="text-sm font-semibold text-gray-900"
                        x-text="toolDrawerInPhoneFeature && toolDrawerInPhoneFeature.name"
                      ></h4>
                      <p
                        class="text-sm text-gray-600 leading-snug mt-0.5"
                        x-text="toolDrawerInPhoneFeature && toolDrawerInPhoneFeature.description"
                      ></p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                      <input
