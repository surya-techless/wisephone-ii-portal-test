            <!-- Edit Device Modal -->
            <div
              x-show="showEditModal"
              x-cloak
              x-transition.opacity
              class="absolute inset-0 bg-black/50 flex items-center justify-center z-50"
              @click.self="closeEditModal()"
            >
              <div
                class='bg-white rounded-lg shadow-xl max-w-md w-full mx-4
                 font-["Haffer SemiMono"]
                 [&_input]:!border-0
                 [&_input]:!border-b
                 [&_input]:!border-gray-900
                 [&_input]:!bg-transparent
                 [&_input]:!rounded-none
                 [&_input]:!shadow-none
                 [&_input]:!outline-none
                 [&_input]:!ring-0
                 [&_input]:focus:!border-gray-900'
              >
                <!-- Header -->
                <div class="px-6 pt-6 pb-4 font-haffer relative">
                  <h3 class="text-2xl font-semibold text-gray-900 tracking-tight">Edit Device</h3>
                  <button
                    @click="closeEditModal()"
                    class="absolute top-5 right-5 text-gray-700 hover:text-gray-900"
                    aria-label="Close"
                  >
                    <Icon name="lucide:x" class="w-7 h-7" />
                  </button>
                </div>

                <!-- Body -->
                <div class="px-6 pb-6 space-y-7">
                  <div>
                    <label class="block text-base text-gray-700">Name</label>
                    <input
                      type="text"
                      x-model="editName"
                      maxlength="15"
                      class="w-full mt-3 pl-6 pb-3 pt-1 text-m text-gray-700 tracking-wide"
                    />
                  </div>

                  <div>
                    <label class="block text-base text-gray-700">Phone Number</label>
                    <input
                      type="text"
                      x-model="editPhoneNumber"
                      @input="formatPhoneNumber($event)"
                      placeholder="222-222-2222"
                      maxlength="12"
                      class="w-full mt-3 pl-6 pb-3 pt-1 text-m text-gray-700 tracking-wide"
                    />
                  </div>
                </div>

                <!-- Footer -->
                <div class="px-6 pb-6 flex justify-end gap-4">
                  <button
                    @click="closeEditModal()"
                    class="px-8 py-3 text-base font-semibold text-gray-900 bg-white
                     border-2 border-gray-900 rounded-md hover:bg-gray-50"
                  >
                    Cancel
                  </button>
                  <button
                    @click="saveDeviceDetails()"
                    class="px-8 py-3 text-base font-semibold text-white bg-gray-700
                     rounded-md hover:bg-gray-800"
                  >
                    Update
                  </button>
                </div>
              </div>
            </div>

            <!-- Remove Device Modal -->
            <div
              x-show="showRemoveModal"
              x-cloak
              @click.self="showRemoveModal = false"
              class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4"
            >
              <div @click.stop class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
                <h3 class="text-lg font-semibold text-gray-900">Remove Device?</h3>

                <p class="text-sm text-gray-700 leading-relaxed">
                  Are you sure you want to remove this device from your account? You can re-add it later by selecting
                  "Add Device" on the Devices page.
                </p>

                <form action={actions.wisephones.deleteWisephone} method="POST">
                  <input type="hidden" name="imei" x-bind:value="imei" />
                  <div class="flex justify-end gap-3 pt-2">
                    <button
                      type="button"
                      @click="showRemoveModal = false"
                      class="px-4 py-2 text-sm font-medium text-white bg-gray-800 rounded hover:bg-gray-700 transition-colors"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors"
                    >
                      Remove Device
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <script is:inline define:vars={{ appsJsonData }}>
            window.APPS_JSON_DATA = appsJsonData;
          </script>
          <script>
            import Alpine from "alpinejs";
            import { actions } from "astro:actions";
            import {
              KNOX_USER_GROUPS,
              updateUnreachableAlpineState,
              getPackageNameFromPlayStoreUrl,
              STRIPE_PUBLIC_KEY,
              type Feature,
              devLog
            } from "@/libs/utils";
            import { loadStripe, type Stripe } from "@stripe/stripe-js";
            import { AppManagementService } from "@/services/AppManagementService";
            import { FeatureManagementService } from "@/services/FeatureManagementService";
            import type { AppEntry } from "@/types/apps";
            import { DEFAULT_SYSTEM_APPS, getInstalledSystemApps, getSystemAppPackageNames } from "@/utils/system-apps";

            const appManagement = new AppManagementService();
            const featureManagement = new FeatureManagementService();

            Alpine.data("manageDevice", function () {
              return {
                currentTab: "device-info",
                appsList: {} as Record<string, Omit<AppEntry, "packageName">>,
                installedApps: [] as {
                  packageName: string;
                  appName: string;
                  isGoogleManaged: "Y" | "N";
                  systemApp?: string;
                }[],
                appSearchQuery: "",
                features: [] as string[],
                availableFeatures: [] as Feature[],
                get toolDrawerInPhoneFeature(): Feature | undefined {
                  return (this.availableFeatures as Feature[]).find((f: Feature) => f.featureKey === "TOOL_DRAWER_IN_PHONE");
                },
                isSubscribed: false,
                imei: "",
                deviceName: "",
                userName: "",
                userPhone: "",
                userEmail: "",
                enableScreenTime: false,
                dataUsageFormatted: "",
                /** Portal-only: show Screen Time block on Device Info tab (persisted in localStorage per IMEI) */
                showScreenTimeComponent: true,
                deviceInfo: null as { resultValue?: { [key: string]: any } } | null,

                isEditing: false,
                devicePhone: "",
                originalDeviceName: "",
                originalDevicePhone: "",
                isLoading: true,
                isToolDrawerLoading: false,
                isToolDrawerLoaded: false,
                isAppsLoading: false,
                isAppsLoaded: false,
                isAvailableAppsLoaded: false,
                mobileMenuOpen: false,
                showAccountMenu: false,
                showConfirmModal: false,
                pendingFeature: null as Feature | null,
                pendingFeatureEnabled: false,
                confirmationMessage: "",
                showScreenTimeConfirmModal: false,
                pendingScreenTimeValue: false,
                showDisclosureFor: null as string | null,
                showAppInstallModal: false,
                pendingAppToInstall: null as string | null,
                pendingAppName: "",
                showAppUninstallModal: false,
                pendingAppToUninstall: null as string | null,
                pendingAppToUninstallName: "",
                showEditModal: false,
                editName: "",
                editPhoneNumber: "",
                showRemoveModal: false,
                cachedTotalApps: 0,
                installedOpen: false,
                // @ts-ignore
                isPhoneSetUp: this.$persist(false),
                // TODO :  Not a todo, but note to the future dev : all apps are embedded inside apps.json file,
                // TODO :since ottogrid support is not available and Healthy Tech Index is not yet integrated
                // TODO : apps in apps.json  from line 4 to 2537 are faith tools apps and the rest are from ottogrid (approved apps)
                get totalAppsCount() {
                  // Use cached value if available, otherwise calculate from current state
                  if (this.cachedTotalApps > 0) {
                    return this.cachedTotalApps;
                  }
                  return this.systemApps.length + this.installedFilteredApps.length;
                },
                updateCachedTotalApps() {
                  const total = this.systemApps.length + this.installedFilteredApps.length;
                  this.cachedTotalApps = total;
                  // Save to localStorage with IMEI as key
                  if (this.imei) {
                    try {
                      localStorage.setItem(`totalApps_${this.imei}`, String(total));
                    } catch (error) {
                      devLog.error("Failed to save total apps to localStorage:", error);
                    }
                  }
                },
                loadCachedTotalApps() {
                  if (this.imei) {
                    try {
                      const cached = localStorage.getItem(`totalApps_${this.imei}`);
                      if (cached) {
                        this.cachedTotalApps = parseInt(cached, 10) || 0;
                      }
                    } catch (error) {
                      devLog.error("Failed to load total apps from localStorage:", error);
                    }
                  }
                },
                get availableApps() {
                  // Only show apps that are NOT installed
                  // Also double-check against installedApps array to ensure no installed apps slip through
                  let apps = Object.entries(this.appsList)
                    .filter(([packageName, app]) => {
                      // First check: app.installed flag must be false
                      if (app.installed) {
                        return false;
                      }
                      // Second check: verify it's not in installedApps array (defensive check)
                      const isInInstalledApps = (this.installedApps || []).some(
                        (installedApp: { packageName: string }) =>
                          installedApp && installedApp.packageName && installedApp.packageName === packageName
                      );
                      return !isInInstalledApps;
                    })
                    .map(([packageName, app]) => ({ packageName, ...app }));

                  // Filter by search query (searches both name and category)
                  if (this.appSearchQuery) {
                    const query = this.appSearchQuery.toLowerCase();
                    apps = apps.filter(
                      (app) =>
                        app.name.toLowerCase().includes(query) ||
                        (app.category && app.category.toLowerCase().includes(query))
                    );
                  }

                  return apps;
                },

                get systemApps() {
                  // Get installed system apps based on the device model
                  const deviceModel = this.deviceName || ""; // Use device name/model if available
                  // Filter out null/undefined values from installedApps before processing
                  const validInstalledApps = (this.installedApps || []).filter((app) => app && app.packageName);
                  const result = getInstalledSystemApps(validInstalledApps, deviceModel);
                  // Ensure result doesn't contain null values
                  let filteredResult = result.filter((app) => app && app.packageName);

                  // Enrich with icon URLs from appsList if available
                  filteredResult = filteredResult.map((app) => {
                    const appFromList = this.appsList?.[app.packageName];
                    return {
                      ...app,
                      iconUrl: appFromList?.iconUrl || undefined
                    };
                  });

                  return filteredResult;
                },

                get installedFilteredApps() {
                  // Filter out null/undefined values first
                  const validInstalledApps = (this.installedApps || []).filter(
                    (app) => app && (app.packageName || app.appName)
                  );

                  // Show all installed apps from the device (filtered by isGoogleManaged === "Y")
                  let apps = validInstalledApps
                    .filter((app) => app && app.isGoogleManaged === "Y")
                    .map((app) => ({
                      packageName: app.packageName || app.appName || "unknown",
                      name: app.appName || app.packageName || "Unknown App",
                      installed: true,
                      source: "Tool Drawer" as const
                    }))
                    .filter((app) => app && app.packageName && app.packageName !== "unknown");

                  // Also include apps from appsList that are marked as installed
                  const appsListInstalled = Object.entries(this.appsList || {})
                    .filter(([packageName, app]) => app && app.installed && packageName)
                    .map(([packageName, app]) => ({ packageName, ...app }))
                    .filter((app) => app && app.packageName);

                  // Merge and deduplicate by packageName, prioritizing appsList data (which has icons)
                  const appsMap = new Map();
                  apps.forEach((app) => {
                    if (app && app.packageName) {
                      appsMap.set(app.packageName, app);
                    }
                  });
                  appsListInstalled.forEach((app) => {
                    if (app && app.packageName) {
                      // If already exists, merge to preserve iconUrl from appsList
                      const existing = appsMap.get(app.packageName);
                      if (existing) {
                        appsMap.set(app.packageName, { ...existing, ...app, iconUrl: app.iconUrl || existing.iconUrl });
                      } else {
                        appsMap.set(app.packageName, app);
                      }
                    }
                  });
                  apps = Array.from(appsMap.values()).filter((app) => app && app.packageName);

                  // Filter out system apps (they're shown in a separate section)
                  const systemAppPackages = getSystemAppPackageNames();
                  apps = apps.filter((app) => app && app.packageName && !systemAppPackages.includes(app.packageName));

                  // Sort by name
                  apps.sort((a, b) => {
                    if (!a || !b || !a.name || !b.name) return 0;
                    return a.name.localeCompare(b.name);
                  });

                  // Final filter to ensure no null values
                  const finalApps = apps.filter((app) => app && app.packageName && app.name);

                  return finalApps;
                },

                async getFeatures() {
                  if (!this.imei) {
                    devLog.error("IMEI is not set, cannot fetch features");
                    this.isLoading = false;
                    return;
                  }

                  // Ensure loading is true at the start
                  this.isLoading = true;

                  try {
                    const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                    url.searchParams.set("action", "get-device-groups");
                    url.searchParams.set("imei", this.imei);

                    const res = await fetch(url, { method: "GET" });

                    if (!res.ok) {
                      throw new Error(`Failed to fetch features: ${res.status} ${res.statusText}`);
                    }

                    const data = await res.json();

                    // Handle both old format (array) and new format (object with groups and deviceInfo)
                    if (Array.isArray(data)) {
                      // Old format - backward compatibility
                      this.features = data;
                      this.deviceInfo = null;
                    } else {
                      // New format - includes device info
                      this.features = data.groups || [];
                      this.deviceInfo = data.deviceInfo || null;
                    }
                  } catch (error) {
                    devLog.error("Error fetching features:", error);
                    this.showErrorToast("Failed to load device features. Please try again.");
                  } finally {
                    // Set loading to false after all operations complete
                    this.isLoading = false;
                  }
                },

                getDeviceModel(): string {
                  if (!this.deviceInfo?.resultValue) return "";

                  // Try different possible field names for device model
                  const resultValue = this.deviceInfo.resultValue;
                  return (
                    resultValue.modelName ||
                    resultValue.deviceModel ||
                    resultValue.model ||
                    resultValue.deviceName ||
                    resultValue.modelNumber ||
                    ""
                  );
                },

                isA16Device(): boolean {
                  const model = this.getDeviceModel();
                  if (!model) return false;

                  // Check if model contains "A16" (case insensitive)
                  return model.toUpperCase().includes("A16");
                },

                /**
                 * Fetches device model directly from Knox API
                 */
                async getDeviceModelFromKnox(): Promise<string | null> {
                  try {
                    const deviceInfoUrl = new URL(`/api/samsung-knox.json`, window.location.origin);
                    deviceInfoUrl.searchParams.set("action", "get-device-info");
                    deviceInfoUrl.searchParams.set("imei", this.imei);

                    const deviceInfoRes = await fetch(deviceInfoUrl, { method: "GET" });
                    if (!deviceInfoRes.ok) {
                      return null;
                    }

                    const deviceInfo = await deviceInfoRes.json();
                    const rv = deviceInfo?.resultValue;
                    if (!rv) {
                      return null;
                    }

                    const model =
                      rv.deviceModelName ||
                      rv.modelName ||
                      rv.deviceModel ||
                      rv.model ||
                      rv.deviceName ||
                      rv.name ||
                      null;

                    return model;
                  } catch (error) {
                    devLog.error("Error fetching device model:", error);
                    return null;
                  }
                },

                /**
                 * Gets the appropriate group ID for a feature based on device model
                 */
                getGroupIdForFeature(feature: Feature): string {
                  if (this.isA16Device() && feature.a16KnoxManageId) {
                    return feature.a16KnoxManageId;
                  }
                  return feature.knoxManageId || "";
                },

                /**
                 * Checks device model and assigns appropriate subscription group
                 * - A16 devices -> A16_SUBSCRIBED group
                 * - A15 and other devices -> SUBSCRIBED group (default)
                 */
                async assignSubscriptionGroupByDeviceModel() {
                  try {
                    const deviceModel = await this.getDeviceModelFromKnox();
                    if (!deviceModel) {
                      devLog.warn("Could not determine device model, using default SUBSCRIBED group");
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                      // Add block tool drawer group by default (A15 fallback)
                      if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                      return;
                    }

                    const modelUpper = deviceModel.toUpperCase();

                    // Check if device is A16
                    if (modelUpper.includes("A16") || modelUpper.includes("SM-A16")) {
                      devLog.log(`Device model detected as A16: ${deviceModel}, assigning to A16_SUBSCRIBED group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.A16_SUBSCRIBED);
                      // Add A16 block tool drawer group by default
                      if (!this.features.includes(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                    } else {
                      // Default to SUBSCRIBED for A15 and all other devices
                      devLog.log(`Device model: ${deviceModel}, assigning to SUBSCRIBED group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                      this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                      // Add block tool drawer group by default
                      if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                    }
                  } catch (error) {
                    devLog.error("Error assigning subscription group by device model:", error);
                    // Fallback to default SUBSCRIBED group on error
                    await this.addFeatureToDevice(KNOX_USER_GROUPS.SUBSCRIBED);
                    this.features.push(KNOX_USER_GROUPS.SUBSCRIBED);
                    // Add block tool drawer group by default (fallback)
                    if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                    }
                  }
                },

                /**
                 * Checks device model and assigns appropriate unpaid group
                 * - A16 devices -> A16_UNPAID group
                 * - A15 and other devices -> UNPAID group (default)
                 */
                async assignUnpaidGroupByDeviceModel() {
                  try {
                    const deviceModel = await this.getDeviceModelFromKnox();
                    if (!deviceModel) {
                      devLog.warn("Could not determine device model, using default UNPAID group");
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                      this.features.push(KNOX_USER_GROUPS.UNPAID);
                      // Add block tool drawer group by default (A15 fallback)
                      if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                      return;
                    }

                    const modelUpper = deviceModel.toUpperCase();

                    if (modelUpper.includes("A16") || modelUpper.includes("SM-A16")) {
                      devLog.log(`A16 device detected, assigning to A16_UNPAID group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_UNPAID);
                      this.features.push(KNOX_USER_GROUPS.A16_UNPAID);
                      // Add A16 block tool drawer group by default
                      if (!this.features.includes(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.A16_ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                    } else {
                      // Default to UNPAID for A15 and all other devices
                      devLog.log(`Non-A16 device, assigning to UNPAID group`);
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                      this.features.push(KNOX_USER_GROUPS.UNPAID);
                      // Add block tool drawer group by default
                      if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                        await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                        this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      }
                    }
                  } catch (error) {
                    devLog.error("Error assigning unpaid group by device model:", error);
                    // Fallback to default UNPAID group on error
                    await this.addFeatureToDevice(KNOX_USER_GROUPS.UNPAID);
                    this.features.push(KNOX_USER_GROUPS.UNPAID);
                    // Add block tool drawer group by default (fallback)
                    if (!this.features.includes(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER)) {
                      await this.addFeatureToDevice(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                      this.features.push(KNOX_USER_GROUPS.ADD_ON_BLOCK_TOOL_DRAWER);
                    }
                  }
                },

                /**
                 * Ensures a device has the correct Knox user group configuration
                 */
                async removeExclusiveGroups(userGroups: string[]) {
                  const exclusiveGroups = this.getExclusiveGroups(userGroups);
                  if (!this.hasMultipleExclusiveGroups(exclusiveGroups)) {
                    await this.ensureBaseGroup(userGroups);
                  } else {
                    await this.removeIncompatibleFeatures(userGroups);
                  }
                },

                /**
                 * Gets the list of exclusive groups from the user's current groups
                 */
                getExclusiveGroups(userGroups: string[]): string[] {
                  return userGroups.filter(
                    (group) =>
                      group === KNOX_USER_GROUPS.UNPAID ||
                      group === KNOX_USER_GROUPS.SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_UNPAID
                  );
                },

                /**
                 * Checks if the device has more than one exclusive group assigned
                 */
                hasMultipleExclusiveGroups(exclusiveGroups: string[]): boolean {
                  return exclusiveGroups.length > 1;
                },

                /**
                 * Ensures the device has at least one base group
                 */
                async ensureBaseGroup(userGroups: string[]) {
                  const hasBaseGroup = userGroups.some(
                    (group) =>
                      group === KNOX_USER_GROUPS.UNPAID ||
                      group === KNOX_USER_GROUPS.SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_SUBSCRIBED ||
                      group === KNOX_USER_GROUPS.A16_UNPAID
                  );
                  if (!hasBaseGroup) {
                    if (this.isSubscribed) {
                      await this.assignSubscriptionGroupByDeviceModel();
                    } else {
                      await this.assignUnpaidGroupByDeviceModel();
                    }
                  }
                },

                /**
                 * Removes incompatible feature combinations from the device
                 */
                async removeIncompatibleFeatures(userGroups: string[]) {
                  const featuresToRemove = this.getIncompatibleFeatures(userGroups);
                  for (const knoxManageId of featuresToRemove) {
                    await this.removeFeatureFromDevice(knoxManageId);
                  }
                  window.location.reload();
                },

                /**
                 * Determines which features need to be removed to resolve conflicts
                 */
                getIncompatibleFeatures(userGroups: string[]): string[] {
                  const featuresToRemove: string[] = [];

                  // Remove UNPAID if present with any subscription group
                  if (userGroups.includes(KNOX_USER_GROUPS.UNPAID)) {
                    if (
                      userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                      userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                    ) {
                      featuresToRemove.push(KNOX_USER_GROUPS.UNPAID);
                    }
                  }

                  // Remove A16_UNPAID if present with any subscription group
                  if (userGroups.includes(KNOX_USER_GROUPS.A16_UNPAID)) {
                    if (
                      userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) ||
                      userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                    ) {
                      featuresToRemove.push(KNOX_USER_GROUPS.A16_UNPAID);
                    }
                  }

                  // Remove SUBSCRIBED if A16_SUBSCRIBED is present
                  if (
                    userGroups.includes(KNOX_USER_GROUPS.SUBSCRIBED) &&
                    userGroups.includes(KNOX_USER_GROUPS.A16_SUBSCRIBED)
                  ) {
                    featuresToRemove.push(KNOX_USER_GROUPS.SUBSCRIBED);
                  }

                  // Remove UNPAID if A16_UNPAID is present
                  if (
                    userGroups.includes(KNOX_USER_GROUPS.UNPAID) &&
                    userGroups.includes(KNOX_USER_GROUPS.A16_UNPAID)
                  ) {
                    featuresToRemove.push(KNOX_USER_GROUPS.UNPAID);
                  }

                  return featuresToRemove;
                },

                /**
                 * Adds a feature to the device using the Knox API
                 */
                async addFeatureToDevice(knoxManageId: string) {
                  const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                  url.searchParams.set("action", "apply-feature");
                  url.searchParams.set("imei", this.imei);
                  url.searchParams.set("knoxManageId", knoxManageId);
                  await fetch(url, { method: "POST" });
                },

                /**
                 * Removes a feature from the device using the Knox API
                 */
                async removeFeatureFromDevice(knoxManageId: string) {
                  const url = new URL(`/api/samsung-knox.json`, window.location.origin);
                  url.searchParams.set("action", "remove-feature");
                  url.searchParams.set("imei", this.imei);
                  url.searchParams.set("knoxManageId", knoxManageId);
                  await fetch(url, { method: "POST" });
                },

                // Load available apps from apps.json - both Tool Drawer and Faith Tools
                // This should be called immediately when Tool Management tab is clicked
                loadAvailableApps() {
                  if (this.isAvailableAppsLoaded) {
                    return;
                  }

                  try {
                    devLog.log("[DEBUG] Loading available apps from apps.json...");
                    const updatedAppsList: Record<string, Omit<AppEntry, "packageName">> = {};

                    // Load apps from apps.json - filter for apps where "Tool Drawer" === "Yes" OR "faith.tools"
                    const appsJsonData = (window as any).APPS_JSON_DATA || { rows: [] };
                    const appsFromJson = (appsJsonData.rows || []).filter((row: any) => {
                      const toolDrawer = row.cells && row.cells["Tool Drawer"];
                      return toolDrawer === "Yes" || toolDrawer === "faith.tools";
                    });

                    appsFromJson.forEach((row: any) => {
                      try {
                        const cells = row.cells || {};
                        const playStoreUrl = cells["Play Store URL"];
                        const toolName = cells["Tool Name"]?.trim() || "Unknown App";
                        const iconUrl = cells["Play Store Icon URL"] || "";

                        if (!playStoreUrl || playStoreUrl === "n/a") return;

                        const packageName = getPackageNameFromPlayStoreUrl(playStoreUrl);
                        if (!packageName) return;

                        // Skip if already added (deduplication)
                        if (updatedAppsList[packageName]) return;

                        // Check if app is installed by comparing with installedApps
                        const isInstalled = (this.installedApps || []).some(
                          (installedApp: { packageName: string }) =>
                            installedApp && installedApp.packageName === packageName
                        );

                        // Determine source based on Tool Drawer value
                        const toolDrawerValue = cells["Tool Drawer"];
                        const source = toolDrawerValue === "faith.tools" ? "faith.tools" : "Tool Drawer";

                        const category = cells["Play Store Category"] || "";

                        updatedAppsList[packageName] = {
                          source: source as "faith.tools" | "Tool Drawer",
                          installed: isInstalled,
                          name: toolName,
                          iconUrl: iconUrl || undefined,
                          category: category || undefined
                        };
                      } catch (appError) {
                        devLog.error("Error processing app from apps.json:", appError);
                      }
                    });

                    // Sort apps by name
                    this.appsList = Object.fromEntries(
                      Object.entries(updatedAppsList).sort(([, a], [, b]) => a.name.localeCompare(b.name))
                    );

                    this.isAvailableAppsLoaded = true;
                    devLog.log(
                      `[DEBUG] Loaded ${Object.keys(this.appsList).length} available apps from apps.json (Tool Drawer + Faith Tools)`
                    );
                  } catch (error) {
                    devLog.error("Error loading available apps:", error);
                  }
                },

                // Fetch installed apps from Samsung Knox API when Tool Management tab is clicked
                // Flow:
                // 1. User clicks "Tool Management" tab -> currentTab watcher triggers
                // 2. loadAvailableApps() is called immediately (fast, no API call)
                // 3. This function fetches installed apps from Samsung Knox API (async, slow)
                // 4. Updates installedApps array
                // 5. Updates appsList to mark which available apps are installed
                // 6. System apps are automatically classified via systemApps getter (reactive)
                // 7. Installed apps are automatically filtered via installedFilteredApps getter (reactive)
                // 8. UI updates automatically via Alpine.js reactivity
                async getInstalledApps() {
                  if (!this.imei || this.isAppsLoading || this.isAppsLoaded) {
                    return;
                  }

                  try {
                    this.isAppsLoading = true;

                    const formData = new FormData();
                    formData.append("imei", String(this.imei));

                    devLog.log("[TESTING] non-blocking implementation");
                    const response = await fetch("/_actions/wisephones.getInstalledApps", {
                      method: "POST",
                      body: formData
                    });

                    if (!response.ok) {
                      throw new Error(`Failed to fetch installed apps: ${response.status} ${response.statusText}`);
                    }

                    // Check the raw response text first to see what we're actually getting
                    const responseText = await response.text();
                    devLog.log("[DEBUG] Raw response text (first 1000 chars):", responseText.substring(0, 1000));
                    devLog.log("[DEBUG] Raw response text length:", responseText.length);

                    // Try to parse the JSON
                    let result;
                    try {
                      result = JSON.parse(responseText);
                    } catch (parseError) {
                      devLog.error("[DEBUG] Failed to parse JSON:", parseError);
                      devLog.error("[DEBUG] Response text:", responseText);
                      throw new Error("Failed to parse response as JSON");
                    }

                    devLog.log("[DEBUG] Raw result from fetch:", {
                      resultType: typeof result,
                      isArray: Array.isArray(result),
                      resultLength: Array.isArray(result) ? result.length : null,
                      resultKeys: result && !Array.isArray(result) ? Object.keys(result) : [],
                      hasApps: !!result?.apps,
                      hasData: !!result?.data
                    });

                    // Log first few elements if result is an array
                    if (Array.isArray(result) && result.length > 0) {
                      devLog.log("[DEBUG] Result is array, checking first 10 elements:");
                      for (let i = 0; i < Math.min(10, result.length); i++) {
                        const elem = result[i];
                        devLog.log(`[DEBUG] result[${i}]:`, {
                          value: elem,
                          type: typeof elem,
                          isArray: Array.isArray(elem),
                          length: Array.isArray(elem) ? elem.length : null,
                          firstItem: Array.isArray(elem) && elem.length > 0 ? elem[0] : null,
                          firstItemType: Array.isArray(elem) && elem.length > 0 ? typeof elem[0] : null,
                          hasPackageName:
                            elem && typeof elem === "object" && !Array.isArray(elem) ? !!elem.packageName : null
                        });
                      }
                    }

                    // Astro actions when called via fetch might use a compressed/referenced format
                    // Check if result[0] contains metadata with indices
                    let fetchedApps = [];

                    if (Array.isArray(result) && result.length > 0 && result[0] && typeof result[0] === "object") {
                      const metadata = result[0];
                      devLog.log("[DEBUG] Found metadata object:", metadata);

                      // If metadata.apps is a number, it might be an index to the apps array
                      if (typeof metadata.apps === "number" && metadata.apps < result.length) {
                        const appsIndex = metadata.apps;
                        const appsData = result[appsIndex];
                        devLog.log(`[DEBUG] metadata.apps points to result[${appsIndex}]:`, appsData);

                        if (Array.isArray(appsData)) {
                          // appsData might be an array of indices to app objects
                          devLog.log(`[DEBUG] result[${appsIndex}] is an array of ${appsData.length} items`);

                          // Collect app objects using these indices
                          const rawApps = [];
                          for (let i = 0; i < appsData.length; i++) {
                            const appIdx = appsData[i];
                            if (typeof appIdx === "number" && appIdx < result.length) {
                              const appObj = result[appIdx];
                              if (appObj && typeof appObj === "object" && !Array.isArray(appObj)) {
                                rawApps.push({ index: appIdx, raw: appObj });
                              }
                            }
                          }

                          devLog.log(`[DEBUG] Collected ${rawApps.length} raw app objects from indices`);

                          // Dereference numeric properties to strings
                          fetchedApps = rawApps.map(({ raw: app }) => {
                            const dereferenced: any = {};
                            for (const [key, value] of Object.entries(app)) {
                              if (typeof value === "number" && value < result.length) {
                                const stringValue = result[value];
                                if (typeof stringValue === "string") {
                                  dereferenced[key] = stringValue;
                                } else if (stringValue && typeof stringValue === "object") {
                                  // Nested object - recursively dereference
                                  dereferenced[key] = stringValue;
                                } else {
                                  dereferenced[key] = value;
                                }
                              } else {
                                dereferenced[key] = value;
                              }
                            }
                            return dereferenced;
                          });

                          devLog.log(`[DEBUG] Dereferenced ${fetchedApps.length} apps`);
                          if (fetchedApps.length > 0) {
                            devLog.log("[DEBUG] Sample dereferenced app:", {
                              packageName: fetchedApps[0].packageName,
                              appName: fetchedApps[0].appName,
                              keys: Object.keys(fetchedApps[0])
                            });
                          }
                        }
                      }
                    }

                    // Fallback: Check if result is an object with apps property
                    if (
                      fetchedApps.length === 0 &&
                      result &&
                      typeof result === "object" &&
                      !Array.isArray(result) &&
                      result.apps &&
                      Array.isArray(result.apps)
                    ) {
                      fetchedApps = result.apps;
                      devLog.log("[DEBUG] Found apps in result.apps, count:", fetchedApps.length);
                    }
                    // Fallback: Check if result is an object with data.apps
                    else if (
                      fetchedApps.length === 0 &&
                      result &&
                      typeof result === "object" &&
                      !Array.isArray(result) &&
                      result.data?.apps &&
                      Array.isArray(result.data.apps)
                    ) {
                      fetchedApps = result.data.apps;
                      devLog.log("[DEBUG] Found apps in result.data.apps, count:", fetchedApps.length);
                    }
                    // Fallback: Check if result[2] is the apps array (based on debug output showing array structure)
                    else if (
                      fetchedApps.length === 0 &&
                      Array.isArray(result) &&
                      result.length > 2 &&
                      Array.isArray(result[2])
                    ) {
                      // Check if result[2] contains app objects or just numbers
                      const thirdElement = result[2];
                      if (thirdElement.length > 0 && typeof thirdElement[0] === "object" && thirdElement[0] !== null) {
                        fetchedApps = thirdElement;
                        devLog.log("[DEBUG] Found apps in result[2], count:", fetchedApps.length);
                      } else {
                        // result[2] contains numbers (likely indices), so apps might be at those indices
                        // Or apps might start from result[3] onwards
                        devLog.log("[DEBUG] result[2] is array of numbers, checking if they're indices...");
                        devLog.log("[DEBUG] Checking result[3], result[4], result[5] for app objects...");

                        // result[2] contains indices to app objects: [3, 35, 47, 61, ...]
                        // Use these indices to collect all app objects
                        if (Array.isArray(result[2]) && result[2].length > 0) {
                          devLog.log("[DEBUG] Using result[2] indices to collect app objects...");
                          const appIndices = result[2];
                          const rawApps = [];

                          for (let i = 0; i < appIndices.length; i++) {
                            const idx = appIndices[i];
                            if (typeof idx === "number" && idx < result.length) {
                              const appObj = result[idx];
                              if (appObj && typeof appObj === "object" && !Array.isArray(appObj)) {
                                rawApps.push(appObj);
                              }
                            }
                          }

                          devLog.log(`[DEBUG] Collected ${rawApps.length} raw app objects`);

                          // Now dereference numeric properties to actual strings
                          // If packageName is a number, it's an index to the actual string
                          const dereferencedApps = rawApps.map((app) => {
                            const dereferenced: any = {};
                            for (const [key, value] of Object.entries(app)) {
                              if (typeof value === "number" && value < result.length) {
                                // This number is likely an index to a string value
                                const stringValue = result[value];
                                if (typeof stringValue === "string") {
                                  dereferenced[key] = stringValue;
                                } else {
                                  // Keep the number if it's not a string index
                                  dereferenced[key] = value;
                                }
                              } else {
                                dereferenced[key] = value;
                              }
                            }
                            return dereferenced;
                          });

                          fetchedApps = dereferencedApps;
                          devLog.log(`[DEBUG] Dereferenced ${fetchedApps.length} apps`);
                          if (fetchedApps.length > 0) {
                            devLog.log("[DEBUG] First dereferenced app:", fetchedApps[0]);
                          }
                        } else {
                          // Fallback: Check if result[3] onwards contain app objects
                          devLog.log("[DEBUG] result[2] is not an array of indices, checking result[3] onwards...");
                          for (let i = 3; i < Math.min(result.length, 20); i++) {
                            const elem = result[i];
                            if (
                              elem &&
                              typeof elem === "object" &&
                              !Array.isArray(elem) &&
                              (elem.packageName || elem.appName)
                            ) {
                              // Found an app object! Check if subsequent elements are also apps
                              devLog.log(`[DEBUG] Found app object at result[${i}]:`, elem);
                              // Collect all app objects starting from this index
                              fetchedApps = [];
                              for (let j = i; j < result.length; j++) {
                                const app = result[j];
                                if (
                                  app &&
                                  typeof app === "object" &&
                                  !Array.isArray(app) &&
                                  (app.packageName || app.appName)
                                ) {
                                  fetchedApps.push(app);
                                } else {
                                  // Stop when we hit a non-app element
                                  break;
                                }
                              }
                              devLog.log(`[DEBUG] Found ${fetchedApps.length} apps starting from result[${i}]`);
                              break;
                            }
                          }
                        }

                        // If still not found, check if result[2] numbers are indices pointing to apps
                        if (fetchedApps.length === 0 && Array.isArray(result[2]) && result[2].length > 0) {
                          devLog.log("[DEBUG] Checking if result[2] numbers are indices to app objects...");
                          const indices = result[2];
                          const potentialApps = [];
                          for (let i = 0; i < Math.min(indices.length, 10); i++) {
                            const idx = indices[i];
                            if (typeof idx === "number" && idx < result.length) {
                              const elem = result[idx];
                              if (
                                elem &&
                                typeof elem === "object" &&
                                !Array.isArray(elem) &&
                                (elem.packageName || elem.appName)
                              ) {
                                potentialApps.push(elem);
                              }
                            }
                          }
                          if (potentialApps.length > 0) {
                            devLog.log(`[DEBUG] Found ${potentialApps.length} apps using result[2] indices`);
                            // Collect all apps using all indices
                            fetchedApps = [];
                            for (let i = 0; i < indices.length; i++) {
                              const idx = indices[i];
                              if (typeof idx === "number" && idx < result.length) {
                                const elem = result[idx];
                                if (
                                  elem &&
                                  typeof elem === "object" &&
                                  !Array.isArray(elem) &&
                                  (elem.packageName || elem.appName)
                                ) {
                                  fetchedApps.push(elem);
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    // Check if result is directly the apps array
                    else if (Array.isArray(result) && result.length > 0) {
                      const firstItem = result[0];
                      if (firstItem && typeof firstItem === "object" && (firstItem.packageName || firstItem.appName)) {
                        fetchedApps = result;
                        devLog.log("[DEBUG] Result is directly apps array, count:", fetchedApps.length);
                      }
                    }
                    // Check if result.data is the apps array
                    else if (result?.data && Array.isArray(result.data)) {
                      const firstItem = result.data[0];
                      if (firstItem && typeof firstItem === "object" && (firstItem.packageName || firstItem.appName)) {
                        fetchedApps = result.data;
                        devLog.log("[DEBUG] Found apps in result.data (array), count:", fetchedApps.length);
                      }
                    }

                    if (fetchedApps.length === 0) {
                      devLog.error("[DEBUG] Could not find apps array in result", {
                        resultType: typeof result,
                        isArray: Array.isArray(result),
                        resultLength: Array.isArray(result) ? result.length : null,
                        resultKeys:
                          result && typeof result === "object" && !Array.isArray(result) ? Object.keys(result) : [],
                        firstFewElements: Array.isArray(result) ? result.slice(0, 5) : null,
                        resultSample: result ? JSON.stringify(result).substring(0, 2000) : null
                      });
                    }

                    // Log first app structure to see what we're getting
                    if (fetchedApps.length > 0) {
                      devLog.log("[DEBUG] First app structure:", {
                        app: fetchedApps[0],
                        appType: typeof fetchedApps[0],
                        hasPackageName: !!fetchedApps[0]?.packageName,
                        packageNameType: typeof fetchedApps[0]?.packageName,
                        packageNameValue: fetchedApps[0]?.packageName,
                        allKeys: fetchedApps[0] ? Object.keys(fetchedApps[0]) : []
                      });
                    }

                    // Update installed apps - filter out null/undefined values
                    this.installedApps = (fetchedApps || []).filter(
                      (app: any) => app && (app.packageName || app.appName)
                    );

                    devLog.log("[DEBUG] After filtering, installedApps count:", this.installedApps.length);

                    // Log first few apps to see structure
                    this.installedApps.slice(0, 5).forEach((app, index) => {
                      devLog.log(`[DEBUG] App ${index} full object:`, app);
                      devLog.log(`[DEBUG] App ${index} details:`, {
                        app: app,
                        appType: typeof app,
                        isArray: Array.isArray(app),
                        isObject: typeof app === "object" && app !== null,
                        packageName: app?.packageName,
                        packageNameType: typeof app?.packageName,
                        packageNameValue: app?.packageName,
                        appName: app?.appName,
                        allKeys: app && typeof app === "object" ? Object.keys(app) : "not an object"
                      });
                    });

                    // Update appsList to mark which available apps are now installed
                    // This updates the installed status of apps that were already loaded by loadAvailableApps()
                    // IMPORTANT: Installed apps should NOT appear in availableApps (they're filtered out by the getter)
                    if (this.appsList && Object.keys(this.appsList).length > 0) {
                      devLog.log("[DEBUG] Updating installed status in appsList...");
                      const updatedAppsList = { ...this.appsList };
                      let installedCount = 0;
                      Object.keys(updatedAppsList).forEach((packageName) => {
                        // Check if this package is in the installedApps array
                        const isInstalled = this.installedApps.some(
                          (installedApp: { packageName: string }) =>
                            installedApp &&
                            installedApp.packageName &&
                            installedApp.packageName.trim() === packageName.trim()
                        );
                        updatedAppsList[packageName].installed = isInstalled;
                        if (isInstalled) {
                          installedCount++;
                        }
                      });
                      this.appsList = updatedAppsList;
                      devLog.log(
                        `[DEBUG] Updated ${Object.keys(this.appsList).length} apps in appsList: ${installedCount} installed, ${Object.keys(this.appsList).length - installedCount} available`
                      );
                    } else {
                      // If appsList is empty, load available apps first, then update installed status
                      devLog.log("[DEBUG] appsList is empty, loading available apps first...");
                      this.loadAvailableApps();
                      // Update installed status after loading
                      const updatedAppsList = { ...this.appsList };
                      let installedCount = 0;
                      Object.keys(updatedAppsList).forEach((packageName) => {
                        const isInstalled = this.installedApps.some(
                          (installedApp: { packageName: string }) =>
                            installedApp &&
                            installedApp.packageName &&
                            installedApp.packageName.trim() === packageName.trim()
                        );
                        updatedAppsList[packageName].installed = isInstalled;
                        if (isInstalled) {
                          installedCount++;
                        }
                      });
                      this.appsList = updatedAppsList;
                      devLog.log(
                        `[DEBUG] Loaded and updated ${Object.keys(this.appsList).length} apps: ${installedCount} installed, ${Object.keys(this.appsList).length - installedCount} available`
                      );
                    }

                    this.isAppsLoaded = true;
                    // Update cached total apps count after loading
                    this.updateCachedTotalApps();
                  } catch (error) {
                    devLog.error("Error getting installed apps:", error);
                    this.showErrorToast("Failed to load installed apps. Please try again.");
                  } finally {
                    this.isAppsLoading = false;
                  }
                },

                showSuccessToast(message: string) {
                  updateUnreachableAlpineState({
                    sourceDataElement: document.documentElement,
                    key: "toastMessage",
                    value: message
                  });
