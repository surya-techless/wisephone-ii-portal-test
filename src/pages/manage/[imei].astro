                            <div class="flex items-center gap-2 flex-1 min-w-0">
                              <div
                                class="w-8 h-8 rounded-md flex items-center justify-center flex-shrink-0 overflow-hidden"
                                :class="app.iconUrl ? 'bg-transparent' : 'bg-blue-600'"
