---
import Icon from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import WisephoneLogo from "@/components/WisephoneLogo.astro";
import DashboardSidebar from "@/components/DashboardSidebar.astro";

if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}
---

<Layout title="Request an App" description="Request an app to be added to Wisephone.">
  <style>
    * {
      font-family: 'TT Norms Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .request-app-page :is(h1, h2, h3, p, li, a, span) {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: break-word;
      flex-shrink: 1;
    }
  </style>

  <div class="flex h-screen w-full min-w-[360px] bg-[#f7f6f2]" x-data="{ mobileMenuOpen: false }">

    <!-- Mobile Header -->
    <div class="md:hidden fixed top-0 left-0 right-0 bg-[#f7f6f2] z-30 flex items-center justify-between p-4 shadow-sm">
      <div class="flex items-center">
        <WisephoneLogo class="h-8 text-[var(--charcoal)]" />
        <span class="ml-2 font-semibold text-[10px] text-gray-800">PORTAL</span>
      </div>
      <button @click="mobileMenuOpen = true" class="p-2 rounded-lg hover:bg-gray-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Sidebar -->
    <DashboardSidebar activeLink="request-app" />

    <!-- Main Content -->
    <main class="relative flex-1 overflow-y-auto overflow-x-hidden md:rounded-xl md:mt-4 md:mb-4 md:mr-4 bg-white w-full pt-16 md:pt-0">
      <div class="request-app-page w-full min-w-0 overflow-x-hidden">
        <div class="device-dashboard-inner-container mx-4 mt-4 mb-4 md:m-4 pt-2 md:pt-0 min-w-0 lg:max-w-[60%]">
          <h1 class="text-xl md:text-2xl font-semibold text-gray-800">Meet the Healthy Tech Index</h1>

          <div class="mt-3 md:mt-4 space-y-3 md:space-y-4 text-sm md:text-base text-gray-600 leading-relaxed">
            <p>
              Wisephone partners with the Healthy Tech Index, an independent organization that evaluates applications using consistent standards for healthier digital habits.
            </p>
            <p>
              The Healthy Tech Index evaluates apps across multiple categories, including apps that may never be available on Wisephone. Each evaluated app receives a score along with information explaining the evaluation.
            </p>
          </div>

          <h2 class="mt-6 md:mt-8 text-base md:text-xl font-semibold text-gray-800">How can an app become available in the Tool Drawer?</h2>

          <ol class="mt-4 md:mt-5 space-y-4 md:space-y-5">
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
              <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">1</span>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm md:text-base">Search for the app</h3>
                <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                  Visit
                  <a href="https://healthytechindex.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline hover:text-blue-800">Healthy Tech Index</a>
                  to see whether the app has already been evaluated.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
              <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">2</span>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm md:text-base">Request an app</h3>
                <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                  Not scored yet? Select "+ Add" next to the app in
                  <a href="https://healthytechindex.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline hover:text-blue-800">Healthy Tech Index</a>
                  search to request review.<br><br>
                  <b>Note:</b> You don't need to submit a separate request to Wisephone.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
              <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">3</span>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm md:text-base">Look for the <b>W-Approved</b> badge</h3>
                <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                  Apps that are approved for Wisephone use should have a <b>W-Approved</b> badge.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
              <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">4</span>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm md:text-base">W-Approved apps are considered for the Tool Drawer</h3>
                <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                  Apps with a <b>W-Approved</b> badge will be considered for the Wisephone Tool Drawer, but Wisephone makes the final decision based on extra criteria.
                </p>
              </div>
            </li>
          </ol>

          <div class="mt-5 md:mt-6 space-y-3 md:space-y-4 text-sm md:text-base text-gray-600 leading-relaxed">
            <p>
              W-Approved apps typically appear in the Tool Drawer within 48 hours. Having the badge does not guarantee availability, and Wisephone may add or remove third-party apps from the Tool Drawer at any time.
            </p>
            <p class="font-medium text-gray-800">
              <b>
                Wisephone is <i>generally</i> free from internet browsers, social media, games, shopping, video streaming, explicit content, and solo media.
              </b>
            </p>
          </div>

          <div class="mt-6 md:mt-8 border border-gray-300 rounded-lg p-4 md:p-6 bg-white">
            <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 mb-3 md:mb-4">
              <img src="/assets/portal-icons/app-request.svg" alt="" class="w-6 h-6" />
              <h3 class="font-semibold text-gray-900 text-sm md:text-base">Already requested an app?</h3>
            </div>
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              We have submitted all previous app requests to Healthy Tech Index for review. If a score is not visible, please follow step 2 above.
            </p>

            <a
              href="https://healthytechindex.com"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 md:mt-6 flex w-full max-w-full md:inline-flex md:w-auto items-center justify-center gap-1 px-4 py-2.5 md:py-2 bg-[#C07F53] text-white rounded-md text-sm font-medium hover:bg-[#A06F43] transition-colors"
            >
              <span class="text-center">Explore the Healthy Tech Index</span>
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>

            <p class="mt-5 md:mt-6 text-sm text-gray-500 leading-relaxed">
              Healthy Tech Index is currently in beta. To ensure your feedback reaches the appropriate team, please submit Healthy Tech Index-related feedback directly through Healthy Tech Index.
            </p>

            <a
              href="https://healthytechindex.com/feedback"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 flex w-full max-w-full md:inline-flex md:w-auto items-center justify-center gap-1 px-4 py-2.5 md:py-2 border border-gray-400 rounded-md text-sm font-semibold text-gray-800 hover:bg-gray-100 transition-colors"
            >
              Share Feedback
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
