---
import { Wisephone, eq, db, BypassTechlessSubscription } from "astro:db";
import { actions, type ActionInputError } from "astro:actions";
import Icon from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { FEATURES, KNOX_USER_GROUPS } from "@/libs/utils";

const { imei } = Astro.params;

if (isNaN(Number(imei))) {
  return Astro.redirect("/dashboard");
}

const resultDelete = Astro.getActionResult(actions.wisephones.deleteWisephone);
const resultDeleteMessage = resultDelete?.data?.success || "";
if (resultDeleteMessage) {
  return Astro.redirect("/dashboard?message=" + encodeURIComponent(resultDeleteMessage));
}

const wisephones = await db
  .select()
  .from(Wisephone)
  .where(eq(Wisephone.imei, Number(imei)))
  .limit(1);

const features = Object.values(FEATURES);

if (!wisephones || !wisephones.length) {
  return Astro.redirect("/dashboard");
}

const wisephone = wisephones[0];

const subscribedUrl = new URL(`/webhook-is-user-subscribed`, "https://cameronpak-wisephoneii.web.val.run");

// Phone numbers are stored as XXX-XXX-XXXX, but the webhook expects +1XXX-XXX-XXXX
subscribedUrl.searchParams.set("phoneNumber", `+1${wisephone.phoneNumber.replace(/[^0-9+]/g, "")}`);
subscribedUrl.searchParams.set("imei", String(wisephone.imei));

const bypassTechlessSubscription = await db
  .select()
  .from(BypassTechlessSubscription)
  .where(eq(BypassTechlessSubscription.imei, Number(imei)))
  .limit(1);

let isSubscribed = bypassTechlessSubscription.length > 0 || false;
if (!isSubscribed) {
  const result = await fetch(subscribedUrl, { method: "GET" });
  const isSubscribedText = await result.text();
  if (isSubscribedText.includes("bypass") || isSubscribedText.includes("is subscribed")) {
    isSubscribed = true;
  }
}

const result = Astro.getActionResult(actions.wisephones.updateWisephone);
const error = (result?.error as ActionInputError<typeof actions.wisephones.updateWisephone>)?.issues
  .map((issue) => issue.message)
  .join("\n");
---

<Layout title="Device Features" description="Manage the features of your Wisephone II device.">
  <div
    class="container p-6 mx-auto prose"
    x-data="device"
    x-init={`
      imei = "${imei}";
      isSubscribed = ${isSubscribed};
      nickname = "${wisephone.nickname}";
      phoneNumber = "${wisephone.phoneNumber}";
      originalNickname = "${wisephone.nickname}";
      originalPhoneNumber = "${wisephone.phoneNumber}";
      toastErrorMessage = "${error || ""}" || toastErrorMessage;
      toastMessage = "${result?.data?.success || ""}" || toastMessage;
    `}
  >
    <Header activeTab="page" isProjectPublished={false} projectSlug={""} />

    <main class="flex flex-col gap-6 py-12">
      <section class="flex flex-col gap-6 not-prose">
        <div>
          <a href="/dashboard" class="p-0 no-underline w-fit btn btn-link text-slate-500">
            <Icon name="lucide:arrow-left" class="w-4 h-4" />
            Devices
          </a>

          <div class="sm:grid sm:grid-cols-[1fr_auto] max-sm:flex max-sm:flex-col sm:items-center gap-2">
            <h1 class="flex items-center gap-2 !m-0 text-3xl font-bold">
              <span>Features</span>
              <button
                @click="alert('Use this page to manage the features of your Wisephone II. Make sure the device is connected to the internet before updating any features.')"
              >
                <Icon name="lucide:circle-help" class="w-4 h-4 text-slate-500" />
              </button>
            </h1>

            <button
              x-cloak
              class="sm:hidden btn btn-sm btn-primary"
              x-show="!isPhoneSetUp && isSubscribed"
              @click="completeSetup()"
            >
              Complete Setup
            </button>
          </div>

          <div class="inline-flex flex-wrap items-baseline w-full gap-2 mt-2 text-slate-500">
            <div x-show="!isEditing">
              <div class="flex items-baseline gap-2">
                <span
                  class="hover:underline hover:cursor-pointer underline-offset-4"
                  @click="isEditing = true"
                  x-text="nickname">{wisephone.nickname}</span
                >
                •
                <span
                  class="hover:underline hover:cursor-pointer underline-offset-4"
                  @click="isEditing = true"
                  x-text="phoneNumber">{wisephone.phoneNumber}</span
                >
              </div>
            </div>

            <div x-cloak x-show="isEditing" class="w-full" x-collapse>
              <form
                method="POST"
                class="[&>*]:max-sm:w-full flex flex-wrap max-sm:flex-col w-full items-baseline gap-2"
                action={actions.wisephones.updateWisephone}
              >
                <input
                  placeholder="Device Nickname"
                  type="text"
                  name="nickname"
                  x-model="nickname"
                  class="input input-bordered"
                  required
                />
                <input
                  type="text"
                  name="phoneNumber"
                  placeholder="123-456-7890"
                  x-model="phoneNumber"
                  x-mask="999-999-9999"
                  class="input input-bordered"
                  required
                />
                <input type="hidden" name="imei" :value="imei" />
                <div class="flex gap-1">
                  <button type="submit" class="btn btn-primary btn-circle">
                    <Icon name="lucide:check" class="w-4 h-4" />
                  </button>
                  <button type="button" @click="isEditing = false" class="btn hover:!bg-slate-50 btn-ghost btn-circle">
                    <Icon name="lucide:x" class="w-4 h-4" />
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <div
          x-show="!isSubscribed"
          x-cloak
          x-transition
          class="transition-transform duration-150 alert bg-slate-200 border-slate-300 text-slate-800 -rotate-1 hover:rotate-0"
        >
          <Icon name="lucide:info" class="w-4 h-4" />
          <p>
            <a href="https://wisephone.com/pages/activate" class="font-medium link text-slate-800"
              >Activate a Techless Subscription</a
            > to update this device's features.
          </p>
        </div>

        <ul class="list-item-container">
          {
            features.map((feature) => (
              <li
                class="w-full shadow list-item"
                role="button"
                x-bind:class="{ 'pointer-events-none': isLoading, 'opacity-50': !isSubscribed }"
                @click="handleToggle()"
                x-data={`{
                    getSwitchElement() {
                      return this.$refs.switch;
                    },
                    handleToggle() {
                      if (this.feature.knoxManageId === '${KNOX_USER_GROUPS.PRO}') {
                        toggleProAndMinimalFeature(this.feature, this.getSwitchElement());
                      } else {
                        toggleFeature(this.feature, this.getSwitchElement());
                      }
                    },
                    feature: ${JSON.stringify(feature, null, 2)},
                  }`}
              >
                <div class="w-full grid grid-cols-[1fr_auto] items-center justify-between gap-6">
                  <div class="flex flex-col">
                    <div class="inline-flex items-center gap-2">
                      <p>{feature.name}</p>
                      {feature.isBeta && <span class="text-xs text-gray-500">(Beta)</span>}
                    </div>
                    <p class="text-sm text-gray-500">{feature.description}</p>
                  </div>
                  <div class="relative h-[24px]">
                    <input
                      x-ref="switch"
                      type="checkbox"
                      class="pointer-events-none toggle"
                      x-bind:checked="isFeatureEnabled(feature.knoxManageId)"
                    />
                    <div
                      x-show="isLoading"
                      x-transition
                      class="loading loading-spinner loading-sm absolute top-0 left-0 bottom-0 right-0 ms-0.5 my-auto flex items-center justify-center"
                    />
                  </div>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="flex flex-col gap-4 p-6 -translate-y-2 rounded-2xl ps-8 bg-slate-100 rounded-b-2xl">
          <p class="text-xs text-gray-500">
            * Tool Drawer Disclosure: Please note that third-party apps may display in-app ads, which are not endorsed
            by Techless and could contain unexpected content. Use of the Tool Drawer apps is at your discretion. If you
            are battling addiction, we recommend not enabling the Tool Drawer.
          </p>

          <p class="text-xs text-gray-500">
            ** faith.tools Disclosure: Apps curated by faith.tools may display in-app ads and content not affiliated
            with or curated by Techless. These apps are curated by our partner, faith.tools.
          </p>
        </div>
      </section>
      <form
        method="POST"
        action={actions.wisephones.deleteWisephone}
        onsubmit="return confirm('Are you sure you want to delete this device? This action cannot be undone.')"
      >
        <input type="hidden" name="imei" :value="imei" />
        <button type="submit" class="btn btn-ghost btn-sm text-error hover:bg-error/10">
          <Icon name="lucide:trash-2" class="w-4 h-4" />
          Delete Device
        </button>
      </form>
    </main>
  </div>

  <div class="mb-12">
    <Footer showLogo={false} />
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  import {
    type Feature,
    updateUnreachableAlpineState,
    KNOX_USER_GROUPS,
    oldKnoxUserGroupsForSubscription
  } from "@/libs/utils";

  Alpine.data("device", function () {
    return {
      isAiEnabled: false,
      isEditing: false,
      nickname: "",
      phoneNumber: "",
      originalNickname: "",
      originalPhoneNumber: "",
      features: [] as string[],
      imei: "",
      /** Using this field as a local storage flag to track if the phone is set up. */
      // @ts-ignore
      isPhoneSetUp: this.$persist(false),
      get completeSetupUrl() {
        return `http://localhost?imei=${this.imei}&phone=${this.phoneNumber}&subscription=done`;
      },
      completeSetup() {
        if (
          confirm(
            "Completing the setup will close the Portal and remove 'Setup' from your Wisephone II's home screen. Continue?"
          )
        ) {
          this.isPhoneSetUp = true;
          this.$nextTick(() => {
            window.location.href = this.completeSetupUrl;
          });
        }
      },
      isSubscribed: false,
      isFeatureEnabled(knoxManageId: string) {
        return this.features.includes(knoxManageId);
      },
      isLoading: true,
      async getFeatures() {
        const url = new URL(`/api/samsung-knox.json`, window.location.origin);
        url.searchParams.set("action", "get-device-groups");
        url.searchParams.set("imei", this.imei);

        const res = await fetch(url, { method: "GET" });
        const features = await res.json();
        this.features = features;
      },
      /**
       * This function is used to toggle the Pro and Minimal features. We must have one of these enabled.
       * @param feature - The feature to toggle.
       * @param switchElement - The switch element to toggle.
       */
      async toggleProAndMinimalFeature(feature: Feature, switchElement: HTMLInputElement) {
        if (!this.isSubscribed) {
          alert("Oops! You must have an active Techless Subscription to enable features.");
          return;
        }

        const isToolDrawerEnabled = this.isFeatureEnabled(feature.knoxManageId);
        if (!confirm(isToolDrawerEnabled ? feature.disableMessage : feature.enableMessage)) {
          return;
        }

        switchElement.checked = !switchElement.checked;
        const removeUrl = new URL(`/api/samsung-knox.json`, window.location.origin);
        const addUrl = new URL(`/api/samsung-knox.json`, window.location.origin);

        removeUrl.searchParams.set("imei", this.imei);
        addUrl.searchParams.set("imei", this.imei);

        if (isToolDrawerEnabled) {
          removeUrl.searchParams.set("knoxManageId", KNOX_USER_GROUPS.PRO);
          removeUrl.searchParams.set("action", "remove-feature");
          addUrl.searchParams.set("knoxManageId", KNOX_USER_GROUPS.MINIMAL);
          addUrl.searchParams.set("action", "apply-feature");
        } else {
          removeUrl.searchParams.set("knoxManageId", KNOX_USER_GROUPS.MINIMAL);
          removeUrl.searchParams.set("action", "remove-feature");
          addUrl.searchParams.set("knoxManageId", KNOX_USER_GROUPS.PRO);
          addUrl.searchParams.set("action", "apply-feature");
        }

        await fetch(removeUrl, { method: "POST" });
        await fetch(addUrl, { method: "POST" });

        updateUnreachableAlpineState({
          sourceDataElement: document.documentElement,
          key: "toastMessage",
          value: `Your device is being updated. ${feature.name} will be ${isToolDrawerEnabled ? "disabled" : "enabled"} shortly.`
        });
      },
      async toggleFeature(feature: Feature, switchElement: HTMLInputElement) {
        if (!this.isSubscribed) {
          alert("Oops! You must have an active Techless Subscription to enable features.");
          return;
        }

        const isEnabled = this.isFeatureEnabled(feature.knoxManageId);
        if (!confirm(isEnabled ? feature.disableMessage : feature.enableMessage)) {
          return;
        }

        switchElement.checked = !switchElement.checked;
        const url = new URL(`/api/samsung-knox.json`, window.location.origin);

        if (this.isFeatureEnabled(feature.knoxManageId)) {
          url.searchParams.set("action", "remove-feature");
        } else {
          url.searchParams.set("action", "apply-feature");
        }

        url.searchParams.set("imei", this.imei);
        url.searchParams.set("knoxManageId", feature.knoxManageId);

        await fetch(url, { method: "POST" });

        updateUnreachableAlpineState({
          sourceDataElement: document.documentElement,
          key: "toastMessage",
          value: `Your device is being updated. ${feature.name} will be ${isEnabled ? "disabled" : "enabled"} shortly.`
        });
      },
      async removeExclusiveGroups(userGroups: string[]) {
        if (!userGroups.length) {
          return;
        }

        if (!this.isSubscribed) {
          return;
        }

        const hasMoreThanOneExclusiveGroup =
          userGroups.filter((group) => oldKnoxUserGroupsForSubscription.has(group)).length > 1;

        if (!hasMoreThanOneExclusiveGroup) {
          // Do they have any exclusive groups? If not, we need to add Minimal.
          const hasAtLeastOneExclusiveGroup = userGroups.some((group) => oldKnoxUserGroupsForSubscription.has(group));
          if (!hasAtLeastOneExclusiveGroup) {
            if (this.isSubscribed) {
              const url = new URL(`/api/samsung-knox.json`, window.location.origin);

              url.searchParams.set("action", "add-feature");
              url.searchParams.set("imei", this.imei);
              url.searchParams.set("knoxManageId", KNOX_USER_GROUPS.MINIMAL);

              await fetch(url, { method: "POST" });
            } else {
              const url = new URL(`/api/samsung-knox.json`, window.location.origin);

              url.searchParams.set("action", "add-feature");
              url.searchParams.set("imei", this.imei);
              url.searchParams.set("knoxManageId", KNOX_USER_GROUPS.UNPAID);

              await fetch(url, { method: "POST" });
            }
          }

          return;
        }

        if (userGroups.includes(KNOX_USER_GROUPS.UNPAID)) {
          const url = new URL(`/api/samsung-knox.json`, window.location.origin);

          url.searchParams.set("action", "remove-feature");
          url.searchParams.set("imei", this.imei);
          url.searchParams.set("knoxManageId", KNOX_USER_GROUPS.UNPAID);

          await fetch(url, { method: "POST" });
        }

        if (userGroups.includes(KNOX_USER_GROUPS.PRO) && userGroups.includes(KNOX_USER_GROUPS.HEALTHY)) {
          const url = new URL(`/api/samsung-knox.json`, window.location.origin);

          url.searchParams.set("action", "remove-feature");
          url.searchParams.set("imei", this.imei);
          url.searchParams.set("knoxManageId", KNOX_USER_GROUPS.HEALTHY);

          await fetch(url, { method: "POST" });
        }

        if (
          (userGroups.includes(KNOX_USER_GROUPS.PRO) || userGroups.includes(KNOX_USER_GROUPS.HEALTHY)) &&
          userGroups.includes(KNOX_USER_GROUPS.MINIMAL)
        ) {
          const url = new URL(`/api/samsung-knox.json`, window.location.origin);

          url.searchParams.set("action", "remove-feature");
          url.searchParams.set("imei", this.imei);
          url.searchParams.set("knoxManageId", KNOX_USER_GROUPS.MINIMAL);

          await fetch(url, { method: "POST" });
        }

        window.location.reload();
      },
      async init() {
        this.$watch("imei", async () => {
          await this.getFeatures();
          this.isLoading = false;
        });

        this.$watch("isEditing", (value) => {
          if (!value) {
            this.nickname = this.originalNickname;
            this.phoneNumber = this.originalPhoneNumber;
          }
        });

        this.$watch("features", async (userGroups: string[]) => {
          await this.removeExclusiveGroups(userGroups);
        });
      }
    };
  });
</script>
