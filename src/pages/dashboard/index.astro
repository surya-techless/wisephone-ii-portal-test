---
import "trix/dist/trix.css";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";

if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}

const user = await Astro.locals.currentUser();
---

<Layout title="Dashboard">
  <div class="prose p-6 container mx-auto" x-data="{ showForm: false }">
    <Header activeTab="page" isProjectPublished={false} projectSlug={""} />

    <main class="py-12 flex flex-col gap-6">
      <section
        class="w-full flex flex-col items-center justify-center p-6 rounded-2xl bg-transparent border-2 border-slate-200"
        x-show="!showForm"
      >
        <h1>Setup</h1>
        <p class="m-0 text-center">Connect your Wisephone II to manage your device's experience.</p>
        <button class="mt-8 btn btn-primary w-fit" @click="showForm = true">Get Started</button>
      </section>
      <section
        class="w-full flex flex-col items-start justify-center p-6 rounded-2xl bg-white shadow"
        x-show="showForm"
        x-transition
        x-cloak
      >
        <h1>Setup</h1>
        <form method="POST" action="/api/wisephone" class="w-full flex flex-col gap-4">
          <div class="form-control w-full">
            <label class="label">
              <span class="label-text">Wisephone II's IMEI (slot 1)</span>
              <span class="label-text-alt">Required</span>
            </label>
            <input
              type="text"
              name="imei"
              x-mask="999999999999999"
              placeholder="350XXXXXXXXXXXX"
              class="input input-bordered w-full"
              required
            />
            <label class="label">
              <span class="label-text text-slate-500 [&_strong]:text-slate-500">
                On the WiseOS home screen, tap <strong>"Settings"</strong> &gt; tap <strong
                  >"Open System Settings"</strong
                > &gt; scroll to and tap <strong>"About phone"</strong> &gt; hold down on <strong
                  >"IMEI (slot 1)"</strong
                > to copy the number.
              </span>
            </label>
          </div>

          <div class="form-control w-full">
            <label class="label">
              <span class="label-text">Phone Number</span>
              <span class="label-text-alt">Required</span>
            </label>
            <input
              type="tel"
              name="phoneNumber"
              placeholder="+1-XXX-XXX-XXXX"
              class="input input-bordered w-full"
              required
            />
          </div>

          <div class="form-control w-full">
            <label class="label">
              <span class="label-text">Who is this device for?</span>
            </label>
            <input type="text" name="nickname" placeholder="John Doe" class="input input-bordered w-full" />
          </div>

          <button type="submit" class="btn btn-primary mt-4">Done</button>
        </form>
      </section>
    </main>
  </div>

  <Footer showLogo={false} />
</Layout>

<script>
  // @ts-ignore - no types available
  import Trix from "trix";
  import { setupKeyboardNavigation } from "../../libs/utils";

  setupKeyboardNavigation();

  type UploadInfo = {
    id: string;
    batchId: string;
    asset_id: string;
    public_id: string;
    version: number;
    version_id: string;
    signature: string;
    width: number;
    height: number;
    format: string;
    resource_type: string;
    created_at: string;
    tags: string[];
    bytes: number;
    type: string;
    etag: string;
    placeholder: boolean;
    url: string;
    secure_url: string;
    asset_folder: string;
    display_name: string;
    existing: boolean;
    original_filename: string;
    path: string;
    thumbnail_url: string;
  };

  type UploadEvent = {
    event: string;
    info: UploadInfo;
    UploadWidget: Record<string, unknown>;
  };

  document.addEventListener("trix-file-accept", function (event) {
    event.preventDefault();
  });

  const widget = document.querySelector("#upload-banner");
  const bannerImageIdInput = document.querySelector("#bannerImageId") as HTMLInputElement;
  const bannerImageEl = document.querySelector("#bannerImageEl") as HTMLImageElement;
  if (widget) {
    widget.addEventListener("clduploadwidget:success", ((e: CustomEvent<UploadEvent>) => {
      // Save the public_id to the hidden input
      const publicId = e.detail.info.public_id;
      if (bannerImageIdInput) {
        bannerImageIdInput.value = publicId;
        bannerImageIdInput.dispatchEvent(new Event("input", { bubbles: true }));
      }

      // Update the banner image
      if (bannerImageEl) {
        bannerImageEl.src = e.detail.info.url;
      }
    }) as EventListener);
  }

  const logoWidget = document.querySelector("#upload-logo");
  const logoImageIdInput = document.querySelector("#logoImageId") as HTMLInputElement;
  const logoImageEl = document.querySelector("#logoImageEl") as HTMLImageElement;
  if (logoWidget) {
    logoWidget.addEventListener("clduploadwidget:success", ((e: CustomEvent<UploadEvent>) => {
      const publicId = e.detail.info.public_id;
      if (logoImageIdInput) {
        logoImageIdInput.value = publicId;
        logoImageIdInput.dispatchEvent(new Event("input", { bubbles: true }));
      }

      // Update the logo image
      if (logoImageEl) {
        logoImageEl.src = e.detail.info.url;
      }
    }) as EventListener);
  }
</script>
