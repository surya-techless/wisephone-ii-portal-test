<Layout title="Dashboard" description="Manage your Wisephone II devices.">
  {actionResult ? <AstroActionToastResponse actionResult={actionResult} /> : null}

<style>
  * {
    font-family: 'TT Norms Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .request-app-page :is(h1, h2, h3, p, li, a, span) {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
    flex-shrink: 1;
  }
</style>

<div class="dashboard-container flex h-screen w-full min-w-[360px] bg-[#f7f6f2] relative" x-data={`dashboard(${JSON.stringify({ userEmail: user?.emailAddresses?.[0]?.emailAddress || user?.primaryEmailAddress?.emailAddress || "", newDevice: actionResult?.data && !actionResult.error && !actionResult.data.isSubscribed && actionResult.data.wisephone?.[0] ? { imei: actionResult.data.wisephone[0].imei.toString().padEnd(15, "0"), phoneNumber: actionResult.data.wisephone[0].phoneNumber || "", isCspire: Boolean(actionResult.data.isCspire) } : null, testStripe })})`} @activate-modal.window="$event.detail?.isCspire ? openCspireModal($event.detail) : openActivateModal($event.detail?.imei || $event.detail)">
  <progress
    x-show="isLoading"
    x-cloak
    x-transition
    class="absolute top-0 left-0 right-0 w-full progress"
    style="--progress-color: var(--evergreen);"></progress>

  <!-- Mobile Header -->
  <div class="md:hidden fixed top-0 left-0 right-0 bg-[#f7f6f2] z-30 flex items-center justify-between p-4 shadow-sm">
    <div class="flex items-center">
      <WisephoneLogo class="h-8 text-[var(--charcoal)]" />
      <span class="ml-2 font-semibold text-[10px] text-gray-800">PORTAL</span>
    </div>
    <button
      @click="mobileMenuOpen = true"
      class="p-2 rounded-lg hover:bg-gray-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <!-- Sidebar -->
  <DashboardSidebar activeLink="devices" />

<main class="device-dashboard-main-container relative flex-1 min-w-0 overflow-auto md:rounded-xl md:mt-4 md:mb-4 md:mr-4 bg-[#ffffff] w-full pt-16 md:pt-0">

  <!-- no registered devices, so prompt user to add -->
  { derivedHasNoWisephone &&
      <Fragment>
        <div class="p-4 md:p-8">
          <section class="flex flex-col items-center justify-center w-full p-6 md:p-8 bg-transparent border-2 rounded-2xl border-slate-200" x-show="!showForm">
            <img
              src={phoneImg.src}
              alt="A hand-drawn hand holding a Wisephone II"
              class="h-[100px] md:h-[125px] aspect-square"
              decoding="async"
              loading="lazy"
            />
            <h1 class="text-2xl md:text-3xl font-bold text-center mt-4">Connect to your Wisephone.</h1>
            <p class="m-0 text-center text-sm md:text-base mt-2">Connect your Wisephone II to manage your device's experience.</p>
            <button class="mt-6 md:mt-8 btn btn-primary w-fit px-6" @click="showForm = true"> Get Started </button>
          </section>
        </div>
      </Fragment>
  }

  { !derivedHasNoWisephone &&
    <div x-show="activeLink === 'devices'" class="w-full mx-auto ml-0">
        <div class="device-dashboard-inner-container mx-4 mt-4 mb-4 md:m-4">
          <div class="flex justify-between items-start gap-2 pt-2 md:pt-0">
            <div class="flex-1 min-w-0">
              <h1 class="text-xl md:text-2xl font-semibold text-gray-800">Device Dashboard</h1>
              <p class="mt-1 text-sm md:text-base text-gray-600 md:hidden">Select a phone to manage</p>
              <p class="mt-1 text-base text-gray-600 hidden md:block">View all of the Wisephones associated with this account here. Click "Manage Device" to <br>configure settings for a specific Wisephone.</p>
            </div>
            <button @click="showForm = true" class="flex items-center justify-center flex-shrink-0 p-1 md:px-3 md:py-1 border border-gray-400 rounded-md text-sm font-semibold hover:bg-gray-100 whitespace-nowrap">
              <img src="/assets/portal-icons/add-phone.svg" alt="Add device" class="w-7 h-7 md:mr-2" />
              <span class="hidden md:inline">Add device</span>
            </button>
          </div>

          <!-- Device Cards Grid -->
          <div class="mt-6 flex flex-wrap gap-6">
            {wisephonesWithSubscription.map((wisephone) => {
              const initials = (wisephone.nickname || 'Device')
                .split(' ')
                .map(word => word[0])
                .join('')
                .toUpperCase()
                .slice(0, 2);
              const imeiString = wisephone.imei.toString().padEnd(15, "0");
              const deviceData = {
                imei: imeiString,
                isSubscribed: Boolean(wisephone.isSubscribed),
                phoneNumber: wisephone.phoneNumber || '',
                isCspire: Boolean(wisephone.isCspire)
              };
              devLog.log(`Device card data for ${imeiString}:`, deviceData, `isSubscribed type: ${typeof wisephone.isSubscribed}, value: ${wisephone.isSubscribed}`);

              return (
                <div class="border border-gray-300 rounded-md bg-white p-3 w-full md:w-[400px] flex items-start gap-4" x-data={`deviceCard(${JSON.stringify(deviceData)})`}>
                  <div class="w-10 h-10 bg-[#4b918e] rounded-full flex items-center justify-center text-white text-sm font-semibold flex-shrink-0">
                    {initials}
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                    <p class="font-semibold text-base text-gray-900 truncate">{wisephone.nickname || 'Device'}</p>
                    <p class="text-gray-500 text-sm">{wisephone.phoneNumber || '(111) 111-1111'}</p>
                    <p class="text-gray-500 text-sm whitespace-nowrap">IMEI: {imeiString}</p>
                  </div>
                  <template x-if="isSubscribed">
                    <a
                      href={`/manage/${imeiString}`}
                      @click="$root.isLoading = true"
                      class="border border-gray-300 bg-white text-gray-900 text-sm px-2.5 py-1 rounded-md hover:bg-gray-50 whitespace-nowrap flex-shrink-0"
                    >
                      Manage Device
                    </a>
                  </template>
                  <template x-if="!isSubscribed">
                    <button
                      type="button"
                      @click="openActivateModal()"
                      class="border border-gray-300 bg-white text-gray-900 text-sm px-2.5 py-1 rounded-md hover:bg-gray-50 whitespace-nowrap flex-shrink-0"
                    >
                      Activate Plan
                    </button>
                  </template>
                </div>
              );
            })}
          </div>
        </div>
    </div>
  }

  { !derivedHasNoWisephone &&
    <div x-show="activeLink === 'request-app'" x-cloak class="request-app-page w-full min-w-0 overflow-x-hidden">
      <div class="device-dashboard-inner-container mx-4 mt-4 mb-4 md:m-4 pt-2 md:pt-0 min-w-0 lg:max-w-[60%]">
        <h1 class="text-xl md:text-2xl font-semibold text-gray-800">Meet the Healthy Tech Index</h1>

        <div class="mt-3 md:mt-4 space-y-3 md:space-y-4 text-sm md:text-base text-gray-600 leading-relaxed">
          <p>
            Wisephone partners with the Healthy Tech Index, an independent organization that evaluates applications using consistent standards for healthier digital habits.
          </p>
          <p>
            The Healthy Tech Index evaluates apps across multiple categories, including apps that may never be available on Wisephone. Each evaluated app receives a score along with information explaining the evaluation.
          </p>
        </div>

        <h2 class="mt-6 md:mt-8 text-base md:text-xl font-semibold text-gray-800">How can an app become available in the Tool Drawer?</h2>

        <ol class="mt-4 md:mt-5 space-y-4 md:space-y-5">
          <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
            <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">1</span>
            <div>
              <h3 class="font-semibold text-gray-900 text-sm md:text-base">Search for the app</h3>
              <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                Visit
                <a href="https://healthytechindex.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline hover:text-blue-800">Healthy Tech Index</a>
                to see whether the app has already been evaluated.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
            <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">2</span>
            <div>
              <h3 class="font-semibold text-gray-900 text-sm md:text-base">Request an app</h3>
              <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                Not scored yet? Select "+ Add" next to the app in
                <a href="https://healthytechindex.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline hover:text-blue-800">Healthy Tech Index</a>
                search to request review.<br><br>
                <b>Note:</b> You don't need to submit a separate request to Wisephone.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
            <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">3</span>
            <div>
              <h3 class="font-semibold text-gray-900 text-sm md:text-base">Look for the <b>W-Approved</b> badge</h3>
              <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                Apps that are approved for Wisephone use should have a <b>W-Approved</b> badge.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 md:gap-4">
            <span class="w-7 h-7 md:w-8 md:h-8 rounded-full bg-[#4b918e] text-white text-sm font-semibold flex items-center justify-center">4</span>
            <div>
              <h3 class="font-semibold text-gray-900 text-sm md:text-base">W-Approved apps are considered for the Tool Drawer</h3>
              <p class="mt-1 text-sm md:text-base text-gray-600 leading-relaxed">
                Apps with a <b>W-Approved</b> badge will be considered for the Wisephone Tool Drawer, but Wisephone makes the final decision based on extra criteria.
              </p>
