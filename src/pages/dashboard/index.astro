              placeholder="350XXXXXXXXXXXX"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              :class="{ 'border-red-500': !isImeiValid && hasBlurredImei }"
              pattern="[0-9]{15}"
              minlength="15"
              maxlength="15"
              title="Please enter exactly 15 digits"
              @blur="validateImei(); hasBlurredImei = true;"
              required
            />
            <div x-show="hasBlurredImei && (imei1.length > 0 && (imei1.length !== 15 || !isImeiValid))">
              <p class="text-sm text-red-500 mt-1" x-show="imei1.length > 0 && imei1.length !== 15">
                IMEI must be exactly 15 digits
              </p>
              <p class="text-sm text-red-500 mt-1" x-show="imei1.length === 15 && !isImeiValid">
                Invalid IMEI. Please check the number and try again.
              </p>
            </div>
            <p class="text-xs text-gray-500 mt-2">
              On the WiseOS home screen, tap <strong>"Settings"</strong> → tap
              <strong>"Open System Settings"</strong> → scroll to and tap <strong>"About phone"</strong> → hold down on
              <strong>"IMEI (slot 1)"</strong> to copy the number.
            </p>
          </div>

          <div>
            <label for="imei2" class="block text-sm font-medium text-gray-700 mb-1">
              Enter the IMEI one more time
              <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="imei2"
              name="imei2"
              x-model.trim="imei2"
              x-mask="999999999999999"
              placeholder="350XXXXXXXXXXXX"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              :class="{ 'border-red-500': !isImeiValid && hasBlurredImeiVerification }"
              pattern="[0-9]{15}"
              minlength="15"
              maxlength="15"
              title="Please enter exactly 15 digits"
              @blur="validateImei(); hasBlurredImeiVerification = true;"
              required
            />
            <div x-show="hasBlurredImei && (imei2.length > 0 && ((imei2.length !== 15) || (imei2.length === 15 && imei1 !== imei2)))">
              <p class="text-sm text-red-500 mt-1" x-show="imei2.length > 0 && imei2.length !== 15">
                IMEI must be exactly 15 digits
              </p>
              <p class="text-sm text-red-500 mt-1" x-show="imei2.length === 15 && imei1.length === 15 && imei1 !== imei2">
                IMEIs don't match
              </p>
            </div>
          </div>

          <div>
            <label for="phoneNumber" class="block text-sm font-medium text-gray-700 mb-1">
              Wisephone Phone Number
              <span class="text-red-500">*</span>
            </label>
            <input
              type="tel"
              id="phoneNumber"
              x-model.trim="phoneNumber"
              name="phoneNumber"
              x-mask="999-999-9999"
              placeholder="XXX-XXX-XXXX"
              pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              :class="{ 'border-red-500': phoneNumber.length > 0 && phoneNumber.replace(/-/g, '').length !== 10 }"
              required
            />
          </div>

          <div>
            <label for="nickname" class="block text-sm font-medium text-gray-700 mb-1">
              Give this Wisephone a name or owner
              <span class="text-red-500">*</span>
            </label>
            <input
              id="nickname"
              x-model.trim="nickname"
              type="text"
              name="nickname"
              placeholder="John Doe"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              :class="{ 'border-red-500': nickname.length > 0 && nickname.trim().length === 0 }"
              required
            />
          </div>

          <input type="hidden" name="userId" value={user?.id} />

          <div class="flex justify-end gap-3 pt-4">
            <button type="button" @click="showForm = false; resetForm()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed" :disabled="!isFormValid()">
              Add Device
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  </Fragment>

</main>

</div>

<script>
  import Alpine from "alpinejs";
  import { isValidIMEI } from "@/libs/utils";

  document.addEventListener("alpine:init", () => {
    Alpine.data("dashboard", () => ({
      showForm: false,
      isLoading: false,
      mobileMenuOpen: false,
      imei1: "",
      imei2: "",
      phoneNumber: "",
      nickname: "",
      imeiMatch: false,
      hasBlurredImei: false,
      hasBlurredImeiVerification: false,
      isImeiValid: true,
      validateImei() {
        this.imeiMatch = this.imei1 === this.imei2;

        if (this.imei1.length === 15) {
          this.isImeiValid = isValidIMEI(this.imei1);
        } else {
          this.isImeiValid = false;
        }
      },
      isFormValid() {
        return (
          this.isImeiValid &&
          this.imeiMatch &&
          this.phoneNumber.replace(/-/g, "").length === 10 &&
          this.nickname.trim().length > 0
        );
      },
      resetForm() {
        this.imei1 = "";
        this.imei2 = "";
        this.phoneNumber = "";
        this.nickname = "";
        this.imeiMatch = false;
        this.hasBlurredImei = false;
        this.hasBlurredImeiVerification = false;
        this.isImeiValid = true;
      }
    }));
  });
</script>
</Layout>
