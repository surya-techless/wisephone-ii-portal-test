<Layout title="Dashboard" description="Manage your Wisephone II devices.">
  {actionResult ? <AstroActionToastResponse actionResult={actionResult} /> : null}

<style>
  * {
    font-family: 'TT Norms Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
</style>

<div class="dashboard-container flex h-screen w-full bg-[#f7f6f2]" x-data="dashboard">

  <!-- Mobile Header -->
  <div class="md:hidden fixed top-0 left-0 right-0 bg-[#f7f6f2] z-30 flex items-center justify-between p-4 shadow-sm">
    <div class="flex items-center">
      <WisephoneLogo class="h-8 text-[var(--charcoal)]" />
      <span class="ml-2 font-semibold text-[10px] text-gray-800">PORTAL</span>
    </div>
    <button
      @click="mobileMenuOpen = true"
      class="p-2 rounded-lg hover:bg-gray-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <div
    x-show="mobileMenuOpen"
    x-cloak
    x-transition.opacity
    @click="mobileMenuOpen = false"
    class="md:hidden fixed inset-0 bg-black bg-opacity-50 z-40"
  ></div>

  <!-- Sidebar -->
  <aside
    class="w-64 flex flex-col justify-between h-screen bg-[#f7f6f2] md:relative fixed right-0 top-0 z-50 transition-transform duration-300"
    :class="{ 'translate-x-full md:translate-x-0': !mobileMenuOpen }"
  >
    <!-- Top Section: Logo + Navigation -->
    <div class="flex-1 overflow-y-auto">
      <!-- Close Button (Mobile Only) - Top Left -->
      <div class="md:hidden flex items-center justify-start p-4">
        <button
          @click="mobileMenuOpen = false"
          class="p-2 text-gray-600 hover:text-black"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Logo (Desktop Only) -->
      <div class="hidden md:flex p-4 items-center">
        <WisephoneLogo class="h-8 text-[var(--charcoal)]" />
        <span class="ml-2 font-semibold text-[10px] text-gray-800">PORTAL</span>
      </div>

      <nav class="md:mt-6 px-2 space-y-1">
        <!-- Devices -->
        <a href="/dashboard" @click="mobileMenuOpen = false" class="flex items-center px-4 py-3 text-sm text-gray-800 rounded-lg" style="background-color: #DBD5CD;">
          <img src="/assets/portal-icons/devices.svg" alt="" class="w-5 h-5" />
          <span class="ml-4">Devices</span>
        </a>

        <!-- Request an app -->
        <a
          href="https://getwisephone.com/request-app"
          target="_blank"
          rel="noopener noreferrer"
          @click="mobileMenuOpen = false"
          class="flex items-center px-4 py-3 text-sm text-gray-600 rounded-lg hover:bg-gray-50"
        >
          <img src="/assets/portal-icons/app-request.svg" alt="" class="w-5 h-5" />
          <span class="ml-4">Request an App</span>
        </a>

        <!-- Desktop: Show only bottom section -->
        <!-- Mobile: Show all options in one list -->
        <div class="md:hidden space-y-1">
          <div class="flex items-center px-4 py-3 text-sm text-gray-600">
            <img src="/assets/portal-icons/account-circle.svg" alt="" class="w-5 h-5" />
            <span class="ml-4">Account</span>
          </div>

          <a
            href="mailto:support@wisephone.com"
            @click="mobileMenuOpen = false"
            class="flex items-center px-4 py-3 text-sm text-gray-600 hover:bg-gray-50 rounded-lg"
          >
            <img src="/assets/portal-icons/support.svg" alt="" class="w-5 h-5" />
            <span class="ml-4">Support</span>
          </a>

          <IsAdmin server:defer>
            <a href="/dashboard/admin" @click="mobileMenuOpen = false" class="flex items-center px-4 py-3 text-sm text-gray-600 hover:bg-gray-50 rounded-lg">
              <img src="/assets/portal-icons/admin.svg" alt="" class="w-5 h-5" />
              <span class="ml-4">Admin</span>
            </a>
          </IsAdmin>

          <SignOutButton
            redirectUrl="/"
            class="flex items-center w-full px-4 py-3 text-sm text-gray-600 hover:bg-gray-50 text-left rounded-lg"
            @click="mobileMenuOpen = false"
          >
            <img src="/assets/portal-icons/logout.svg" alt="" class="w-5 h-5" />
            <span class="ml-4">Logout</span>
          </SignOutButton>
        </div>
      </nav>
    </div>

    <!-- Bottom Section: Admin, Account, Support, Logout (Desktop Only) -->
    <div class="hidden md:block px-6 pb-6">
      <IsAdmin server:defer>
        <a href="/dashboard/admin" @click="mobileMenuOpen = false" class="flex items-center py-2 text-sm text-gray-600 hover:text-black">
          <img src="/assets/portal-icons/admin.svg" alt="" class="w-5 h-5" />
          <span class="ml-4">Admin</span>
        </a>
      </IsAdmin>

      <div class="flex items-center py-2 text-sm text-gray-600 pb-4">
        <img src="/assets/portal-icons/account-circle.svg" alt="" class="w-5 h-5" />
        <span class="ml-4">Account</span>
      </div>

      <a
        href="mailto:support@wisephone.com"
        @click="mobileMenuOpen = false"
        class="flex items-center py-2 text-sm text-gray-600 hover:text-black pb-4"
      >
        <img src="/assets/portal-icons/support.svg" alt="" class="w-5 h-5" />
        <span class="ml-4">Support</span>
      </a>

      <SignOutButton
        redirectUrl="/"
        class="flex items-center w-full py-2 pb-4 text-sm text-gray-600 hover:text-black text-left"
        @click="mobileMenuOpen = false"
      >
        <img src="/assets/portal-icons/logout.svg" alt="" class="w-5 h-5" />
        <span class="ml-4">Logout</span>
      </SignOutButton>
    </div>
  </aside>

<main class="device-dashboard-main-container relative flex-1 overflow-auto md:rounded-xl md:mt-4 md:mb-4 md:mr-4 bg-[#ffffff] w-full pt-16 md:pt-0">
  {derivedHasNoWisephone ? (<Fragment>
    <section
              class="flex flex-col items-center justify-center w-full p-4 md:p-6 bg-transparent border-2 rounded-2xl border-slate-200 m-4"
              x-show="!showForm"
            >
              <img
                src={phoneImg.src}
                alt="A hand-drawn hand holding a Wisephone II"
                class="h-[100px] md:h-[125px] aspect-square"
                decoding="async"
                loading="lazy"
              />
              <h1 class="text-2xl md:text-3xl font-bold text-center mt-4">Connect to your Wisephone.</h1>
              <p class="m-0 text-center text-sm md:text-base mt-2">Connect your Wisephone II to manage your device's experience.</p>
              <button class="mt-6 md:mt-8 btn btn-primary w-fit px-6" @click="showForm = true">
                Get Started
              </button>
            </section>
  </Fragment>):(
  <Fragment>
    <div class="w-full mx-auto ml-0">
      <div class="device-dashboard-inner-container mx-4 mt-4 mb-4 md:m-4">
        <div class="flex justify-between items-start pt-2 md:pt-0">
          <div>
            <h1 class="text-xl md:text-2xl font-semibold text-gray-800">Device Dashboard</h1>
            <p class="mt-1 text-sm md:text-base text-gray-600 md:hidden">Select a phone to manage</p>
            <p class="mt-1 text-base text-gray-600 hidden md:block">View all of the Wisephones associated with this account here. Click "Manage Device" to <br>configure settings for a specific Wisephone.</p>
          </div>
          <button @click="showForm = true" class="flex items-center justify-center p-2 md:px-4 md:py-2 border border-gray-400 rounded-md text-sm font-semibold hover:bg-gray-100 whitespace-nowrap">
            <img src="/assets/portal-icons/add-device.svg" alt="Add device" class="w-5 h-5 md:mr-2" />
            <span class="hidden md:inline">Add device</span>
          </button>
        </div>

        <!-- Device Cards Grid -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {wisephones.map((wisephone) => {
            const initials = (wisephone.nickname || 'Device')
              .split(' ')
              .map(word => word[0])
              .join('')
              .toUpperCase()
              .slice(0, 2);

            return (
              <div class="border border-gray-300 rounded-md p-4 w-full min-h-[200px] flex flex-col">
                <div class="flex justify-between items-start gap-2">
                  <div class="flex items-start space-x-2 sm:space-x-3 min-w-0 flex-1">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-[#4b918e] rounded-full flex items-center justify-center text-white text-xs sm:text-sm font-semibold flex-shrink-0">
                      {initials}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="font-medium text-sm sm:text-base text-gray-900 truncate">{wisephone.nickname || 'Device'}</p>
                      <p class="text-gray-500 text-xs sm:text-sm">{wisephone.phoneNumber || 'No phone number'}</p>
                      <p class="text-gray-400 text-xs break-all">IMEI: {wisephone.imei.toString().padEnd(15, "0")}</p>
                    </div>
                  </div>
                  <a
                    href={`/dashboard/device/${wisephone.imei.toString().padEnd(15, "0")}`}
                    class="border border-gray-400 text-[11px] sm:text-sm px-2 sm:px-3 py-1 rounded-md hover:bg-gray-100 whitespace-nowrap flex-shrink-0"
                  >
                    Manage Device
                  </a>
                </div>

                {/* <div class="device-metrics-container flex justify-between mt-auto pt-4 h-[90px]">
                  <div class="bg-[#f7f6f2] border border-gray-200 rounded-md p-4 w-32 text-center">
                    <p class="text-gray-500 text-xs">Avg. Screen Time</p>
                    <p class="text-lg font-semibold">1hr/Day</p>
                  </div>

                  <div class="bg-[#f7f6f2] border border-gray-200 rounded-md p-4 w-32 text-center">
                    <p class="text-gray-500 text-xs">Apps</p>
                    <p class="text-lg font-semibold">7</p>
                  </div>
                </div> */}
              </div>
            );
          })}
        </div>
      </div>
      </div>

  </Fragment>
)}

  <!-- Modal for Add Device Form -->
  <Fragment>
    <div
    x-show="showForm"
