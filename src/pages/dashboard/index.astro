              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>

          <div class="p-4 md:p-6">
            <!-- Billing cycle toggle -->
            <div class="flex items-center rounded-full bg-gray-200 p-1 mb-6 h-11">
              <button
                @click="byocBillingCycle = 'yearly'"
                class="flex-1 min-w-0 h-full px-3 rounded-full text-sm font-medium transition-all duration-200 focus:outline-none leading-tight text-center"
                :class="byocBillingCycle === 'yearly' ? 'bg-[#C07F53] text-white shadow-sm' : 'text-gray-500'"
              >
                Annually (One Month Free)
              </button>
              <button
                @click="byocBillingCycle = 'monthly'"
                class="flex-1 min-w-0 h-full rounded-full text-sm font-medium transition-all duration-200 focus:outline-none"
                :class="byocBillingCycle === 'monthly' ? 'bg-[#C07F53] text-white shadow-sm' : 'text-gray-500'"
              >
                Monthly
              </button>
            </div>

            <!-- Plan card -->
            <div class="border border-gray-200 rounded-xl p-5 mb-5">
              <h3 class="text-base font-semibold text-gray-900 mb-1">WiseOS Subscription</h3>
              <p class="text-xs text-gray-500 mb-4">No carrier service included — bring your own plan</p>
              <ul class="space-y-2 mb-5">
                <li class="flex items-start gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-[#C07F53] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  WiseOS Subscription
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-[#C07F53] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Full feature access
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-[#C07F53] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Works with any carrier
                </li>
              </ul>
              <div x-show="byocBillingCycle === 'monthly'">
                <p class="text-3xl font-bold text-gray-900">$14.99<span class="text-base font-normal text-gray-500">/mo</span></p>
                <p class="text-xs text-gray-500 mt-1">Billed monthly</p>
              </div>
              <div x-show="byocBillingCycle === 'yearly'" x-cloak>
                <p class="text-3xl font-bold text-gray-900">$13.74<span class="text-base font-normal text-gray-500">/mo</span></p>
                <p class="text-xs text-gray-500 mt-1">Billed annually · One Month Free</p>
              </div>
            </div>

            <!-- Activate button -->
            <button
              @click="handleStripeCheckout(byocBillingCycle)"
              :disabled="!isStripeLoaded || !activeDeviceImei"
              class="w-full px-4 py-3 bg-[#C07F53] text-white rounded-md text-sm font-medium hover:bg-[#A06F43] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span x-text="byocBillingCycle === 'yearly' ? 'Activate BYOC Plan (Annually)' : 'Activate BYOC Plan (Monthly)'"></span>
            </button>

            <p class="text-xs text-gray-400 text-center mt-3">Secure checkout powered by Stripe</p>
          </div>
        </div>
      </div>

      <!-- CSpire Subscription Modal -->
      <CspireSubscriptionModal />

      {
        testStripe ? (
          <!-- Custom Stripe Checkout Modal -->
          <div
            x-show="showStripeModal"
            x-cloak
            x-transition.opacity
            class="fixed inset-0 z-50 bg-black bg-opacity-60 flex items-center justify-center p-4"
            @click.self="closeStripeModal()"
          >
            <div class="bg-[#f7f6f2] rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto relative">
              <div class="flex items-center justify-between px-5 pt-5 pb-3">
                <h2 class="text-base font-semibold text-gray-800">Test Stripe Modal</h2>
                <button
                  @click="closeStripeModal()"
                  class="text-gray-400 hover:text-gray-600 transition-colors p-1"
                  aria-label="Close"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                </button>
              </div>
              <div class="px-5 pb-6">
                <StripeCheckout customerEmail={user?.emailAddresses?.[0]?.emailAddress || user?.primaryEmailAddress?.emailAddress || ""} />
              </div>
            </div>
          </div>
        ) : (
          <!-- Legacy Stripe Embedded Checkout Dialog -->
          <dialog x-ref="stripeDialog" class="modal">
            <div style="background-color: rgb(247, 246, 242)" class="modal-box max-w-2xl">
              <div id="stripe-subscription-element"></div>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
        )
      }
      </div>
    </Fragment>
  }

</main>

</div>

<script>
  import Alpine from "alpinejs";
  import { isValidIMEI, STRIPE_PUBLIC_KEY, updateUnreachableAlpineState, devLog } from "@/libs/utils";
  import { actions } from "astro:actions";
  import { loadStripe, type Stripe, type StripeElements, type StripeEmbeddedCheckout } from "@stripe/stripe-js";
  import { SubscriptionPollingService, type Device } from "@/services/SubscriptionPollingService";

  // Initialize subscription polling service
  let subscriptionPollingService: SubscriptionPollingService | null = null;

  // Module-level variables keep Stripe instances outside Alpine's reactive Proxy.
  // WeakMap(this) was unreliable because Alpine's expression evaluator passes a different
  // proxy reference than the one captured in init(), causing get() to always return undefined.
  let _stripeInstance: Stripe | null = null;
  let _stripeElementsInstance: StripeElements | null = null;

  // Pre-load Stripe SDK immediately so it's ready when the payment modal opens
  const stripePromise = loadStripe(STRIPE_PUBLIC_KEY);

  document.addEventListener("alpine:init", () => {
    Alpine.data("stripeCheckout", () => ({
      cycle: "yearly" as "monthly" | "yearly",
      ready: false,
      loading: false,
      cardComplete: false,
      errorMsg: "",
      couponCode: "",
      couponApplied: false,
      couponError: "",
      finalAmount: null as number | null,
      _email: "",
      _name: "",
      _imei: "",
      _customerId: "",

      init() {
        // Component is always in DOM (x-show). Listen for dashboard events instead
        // of watching cross-component state (which Alpine doesn't track reactively).
        const dashboardEl = document.querySelector('[x-data^="dashboard("]') as HTMLElement | null;
        devLog.log("[STRIPE CHECKOUT] Component initialized");

        this.$watch("_email", (val: string) => {
          if (val) devLog.log("[STRIPE CHECKOUT] Email →", val);
        });

        window.addEventListener('stripe-checkout-open', () => {
          this._onModalOpen(dashboardEl);
        });

        window.addEventListener('stripe-checkout-close', () => {
          devLog.log("[STRIPE CHECKOUT] Modal closed | was couponApplied:", this.couponApplied, "| finalAmount:", this.finalAmount);
          // Reset transient state on close but keep card form alive for instant reopen
          this.couponCode = "";
          this.couponApplied = false;
          this.couponError = "";
          this.errorMsg = "";
          this.finalAmount = null;
          this._name = "";
        });
      },

      async _onModalOpen(dashboardEl: HTMLElement | null) {
        const dashData = dashboardEl ? (window as any).Alpine?.$data?.(dashboardEl) : null;

        const email = (this.$el as HTMLElement).dataset.email || dashData?.customerEmail || "";
        const imei = dashData?.activeDeviceImei
          ? (dashData.activeDeviceImei as string).replace(/[^0-9]/g, "").padEnd(15, "0")
          : "";
        const cycle = (dashData?.stripeInitialCycle || "yearly") as "monthly" | "yearly";

        devLog.log("[STRIPE CHECKOUT] Modal opening | cycle:", cycle, "| email:", email, "| IMEI:", imei);

        // Same session — card form already mounted, show instantly
        if (_stripeInstance && this._email === email && this._imei === imei && this.cycle === cycle) {
          devLog.log("[STRIPE CHECKOUT] Instant reopen — form already mounted | ready:", this.ready);
          return;
        }

        this._email = email;
        this._imei = imei;
        this.cycle = cycle;
        devLog.log("[STRIPE CHECKOUT] Loading payment form | cycle:", cycle, "| email:", email, "| IMEI:", imei);

        if (!email || !imei) {
          this.errorMsg = "Missing payment information. Please close and try again.";
          devLog.log("[STRIPE CHECKOUT] Blocked: missing email or IMEI");
          return;
        }

        const stripe = await stripePromise;
        if (!stripe) {
          this.errorMsg = "Unable to initialize Stripe. Please refresh and try again.";
          devLog.log("[STRIPE CHECKOUT] Blocked: Stripe SDK failed to load");
          return;
        }
        _stripeInstance = stripe;
        await this._mountPaymentElement();
      },

      // Validates the coupon code against Stripe without touching the card form or creating any subscription.
      async applyCoupon() {
        if (!this.couponCode.trim() || this.loading) return;
        const code = this.couponCode.trim();
        this.couponError = "";
        this.loading = true;
        devLog.log("[STRIPE CHECKOUT] Applying coupon:", code);
        try {
          const result = await actions.stripe.validateCoupon.orThrow({
            code,
            plan: this.cycle
          });
          this.finalAmount = result.finalAmount;
          this.couponApplied = true;
          const original = this.cycle === "yearly" ? 13.74 : 14.99;
          const discounted = result.finalAmount / 100;
          const perMonth = this.cycle === "yearly" ? (discounted / 12).toFixed(2) : discounted.toFixed(2);
          devLog.log(`[STRIPE CHECKOUT] Coupon applied: ${code} | $${original}/mo → $${perMonth}/mo | Due today: $${discounted.toFixed(2)}`);
        } catch (err: any) {
          this.couponApplied = false;
          this.finalAmount = null;
          devLog.log("[STRIPE CHECKOUT] Invalid coupon:", code, "| error:", err?.message ?? err);
          this.couponError = "Invalid or expired coupon code.";
        } finally {
          this.loading = false;
        }
      },

      _onCouponFocus() {
        devLog.log("[STRIPE CHECKOUT] Coupon field focused | current value:", this.couponCode || "(empty)");
      },

      _onCouponBlur() {
        if (this.couponCode.trim()) {
          devLog.log("[STRIPE CHECKOUT] Coupon field blurred | code entered:", this.couponCode);
        }
      },

      // Resets coupon state only. Card form stays mounted — no remount needed.
      removeCoupon() {
        devLog.log("[STRIPE CHECKOUT] Coupon removed:", this.couponCode);
        this.couponApplied = false;
        this.couponCode = "";
        this.couponError = "";
        this.finalAmount = null;
      },

      // Creates a SetupIntent and mounts the card form. No subscription is created here.
      async _mountPaymentElement() {
        devLog.log("[STRIPE CHECKOUT] _mountPaymentElement | stripeInstance:", !!_stripeInstance);
        const stripe = _stripeInstance;
        if (!stripe) {
          devLog.log("[STRIPE CHECKOUT] EARLY RETURN — stripe not initialized yet");
          return;
        }

        this.ready = false;
        this.cardComplete = false;
        this.errorMsg = "";

        const prevElements = _stripeElementsInstance;
        if (prevElements) {
          devLog.log("[STRIPE CHECKOUT] Unmounting previous payment element");
          prevElements.getElement("payment")?.unmount();
          _stripeElementsInstance = null;
        }

        try {
          const { clientSecret, customerId } = await actions.stripe.createSetupIntent.orThrow({
            customerEmail: this._email,
            deviceIMEI: this._imei
          });
          this._customerId = customerId;

          const elements = stripe.elements({
            clientSecret,
            appearance: { theme: "stripe", variables: { colorPrimary: "#C07F53" } }
          });
          _stripeElementsInstance = elements;

          // Payment Element — card number, expiry, CVC, country, ZIP, phone
          // Name is collected by our own Full name input above and passed via payment_method_data
          const paymentEl = elements.create("payment", {
            fields: {
              billingDetails: {
                name: "never",
                phone: "auto",
                email: "never"
              }
            },
            defaultValues: {
              billingDetails: { email: this._email }
            }
          });
          paymentEl.on("ready", () => {
            this.ready = true;
            devLog.log("[STRIPE CHECKOUT] Payment element ready");
          });
          paymentEl.on("change", (event: any) => {
            this.cardComplete = event.complete;
            devLog.log("[STRIPE CHECKOUT] Card field updated | complete:", event.complete, "| type:", event.value?.type ?? "card");
          });
          paymentEl.mount(this.$refs.paymentContainer as HTMLElement);
          devLog.log("[STRIPE CHECKOUT] Payment element mounted | cycle:", this.cycle);
        } catch (err: any) {
          devLog.log("[STRIPE CHECKOUT] Failed to load payment form | message:", err?.message ?? err);
          this.errorMsg = "Unable to load payment form. Please refresh and try again.";
        }
      },

      async submit() {
        if (this.loading) return;

        const stripe = _stripeInstance;
        const elements = _stripeElementsInstance;

        if (!stripe || !elements) {
          this.errorMsg = "Payment form not loaded. Please close and reopen.";
          devLog.log("[STRIPE CHECKOUT] Submit blocked: Stripe not initialized");
          return;
        }
        if (!this.ready) {
          this.errorMsg = "Payment form is still loading. Please wait a moment.";
          devLog.log("[STRIPE CHECKOUT] Submit blocked: payment element not ready");
          return;
        }

        if (!this._name.trim()) {
          this.errorMsg = "Please enter your full name.";
          return;
        }

        const chargeAmount = this.finalAmount !== null
          ? "$" + (this.finalAmount / 100).toFixed(2)
          : (this.cycle === "yearly" ? "$164.88" : "$14.99");
        devLog.log("[STRIPE CHECKOUT] Submit | cycle:", this.cycle, "| name:", this._name, "| email:", this._email, "| IMEI:", this._imei, "| charge:", chargeAmount, "| coupon:", this.couponApplied ? this.couponCode : "none", "| cardComplete:", this.cardComplete);

        this.loading = true;
        this.errorMsg = "";

        // Step 1: Validate the card via SetupIntent. No subscription created yet.
        devLog.log("[STRIPE CHECKOUT] Step 1: Confirming SetupIntent (validating card details)...");
        const { setupIntent, error: setupError } = await stripe.confirmSetup({
          elements,
          confirmParams: {
            return_url: `${window.location.origin}/manage/${this._imei}`,
            payment_method_data: { billing_details: { name: this._name.trim(), email: this._email } }
          },
          redirect: "if_required"
        });

        if (setupError) {
          devLog.log("[STRIPE CHECKOUT] Step 1 failed — SetupIntent rejected");
          devLog.log("[STRIPE CHECKOUT] Error code:", setupError.code);
          devLog.log("[STRIPE CHECKOUT] Error type:", setupError.type);
          devLog.log("[STRIPE CHECKOUT] Error message:", setupError.message);
          devLog.log("[STRIPE CHECKOUT] Decline code:", (setupError as any).decline_code ?? "none");
          devLog.log("[STRIPE CHECKOUT] Doc URL:", (setupError as any).doc_url ?? "none");
          devLog.log("[STRIPE CHECKOUT] Param:", (setupError as any).param ?? "none");
          const si = (setupError as any).setup_intent;
          if (si) {
            devLog.log("[STRIPE CHECKOUT] SetupIntent id:", si.id, "| status:", si.status, "| last_setup_error:", JSON.stringify(si.last_setup_error));
          }
          devLog.log("[STRIPE CHECKOUT] Full error:", JSON.stringify(setupError));

          // SetupIntent is in a terminal state (already used or cancelled).
          // Remount the form with a fresh SetupIntent so the user can retry.
          if (setupError.code === "setup_intent_unexpected_state") {
            devLog.log("[STRIPE CHECKOUT] Remounting form with fresh SetupIntent after unexpected state error");
            this.loading = false;
            await this._mountPaymentElement();
            this.errorMsg = "A temporary error occurred. Please try submitting again.";
            return;
          }

          this.errorMsg = setupError.message ?? "Card validation failed. Please try again.";
          this.loading = false;
          return;
        }

        const paymentMethodId = typeof setupIntent?.payment_method === "string"
          ? setupIntent.payment_method
          : (setupIntent?.payment_method as any)?.id as string | undefined;

        if (!paymentMethodId) {
          this.errorMsg = "Failed to save payment method. Please try again.";
          devLog.log("[STRIPE CHECKOUT] Submit blocked: no paymentMethodId returned after confirmSetup");
          this.loading = false;
          return;
        }
        devLog.log("[STRIPE CHECKOUT] Step 1 complete — card validated | paymentMethodId:", paymentMethodId);

        // Step 2: Create the subscription with the validated payment method.
        devLog.log("[STRIPE CHECKOUT] Step 2: Creating subscription...");
        let activationResult: { requiresAction: boolean; subscriptionId: string; paymentIntentClientSecret: string | null };
        try {
          const raw = await actions.stripe.activateSubscription.orThrow({
            customerId: this._customerId,
            customerEmail: this._email,
            customerName: this._name.trim(),
            deviceIMEI: this._imei,
            plan: this.cycle,
            paymentMethodId,
            ...(this.couponApplied && this.couponCode.trim() ? { promotionCode: this.couponCode.trim() } : {})
          });
          activationResult = { ...raw, paymentIntentClientSecret: raw.paymentIntentClientSecret ?? null };
          devLog.log("[STRIPE CHECKOUT] Step 2 complete | subscriptionId:", activationResult.subscriptionId, "| requiresAction:", activationResult.requiresAction);
        } catch (err: any) {
          devLog.log("[STRIPE CHECKOUT] Step 2 failed | message:", err?.message ?? err);
          this.errorMsg = err?.message ?? "Failed to activate subscription. Please try again.";
          this.loading = false;
          return;
        }

        // Step 3 (amount > $0 only): Confirm the PaymentIntent to charge the card.
        if (activationResult.requiresAction && activationResult.paymentIntentClientSecret) {
          devLog.log("[STRIPE CHECKOUT] Step 3: Confirming payment of", chargeAmount, "...");
          const { error: payError } = await stripe.confirmPayment({
            clientSecret: activationResult.paymentIntentClientSecret,
            confirmParams: {
              return_url: `${window.location.origin}/manage/${this._imei}`,
              payment_method: paymentMethodId
            },
            redirect: "if_required"
          });

          if (payError) {
            devLog.log("[STRIPE CHECKOUT] Step 3 failed | code:", payError.code, "| message:", payError.message);
            this.errorMsg = payError.message ?? "Payment failed. Please try again.";
            this.loading = false;
            return;
          }
          devLog.log("[STRIPE CHECKOUT] Step 3 complete — charged", chargeAmount);
        } else {
          devLog.log("[STRIPE CHECKOUT] Step 3 skipped — $0.00 due today, card saved for future billing");
        }

        devLog.log("[STRIPE CHECKOUT] All steps complete — redirecting to manage page");
        window.location.href = `/manage/${this._imei}`;
      }
    }));

    Alpine.data("dashboard", (initialData?: { userEmail?: string; newDevice?: { imei: string; phoneNumber: string; isCspire?: boolean } | null; testStripe?: boolean }) => ({
      activeLink: 'devices',
      showForm: false,
      isLoading: false,
      mobileMenuOpen: false,
      showAccountMenu: false,
      showActivateModal: false,
      showByocModal: false,
      showCspireModal: false,
      byocBillingCycle: 'yearly' as 'monthly' | 'yearly',
      byocSessionCycle: null as 'monthly' | 'yearly' | null,
      byocFromCspire: false,
      activeDeviceImei: null as string | null,
      activeDevicePhoneNumber: null as string | null,
      pollingSubscription: false,
      pollingInterval: null as ReturnType<typeof setTimeout> | null,
      shouldStartPolling: false,
      pollingImei: null as string | null,
      testStripe: initialData?.testStripe ?? false,
      stripeInitialCycle: 'yearly' as 'monthly' | 'yearly',
      isStripeLoaded: false,
      isStripeEmbedded: false,
      showStripeModal: false,
      stripeInstance: undefined as Stripe | undefined,
      embeddedCheckout: undefined as StripeEmbeddedCheckout | undefined,
      sessionClientSecret: undefined as string | undefined,
      stripeSessionId: undefined as string | undefined,
      customerEmail: initialData?.userEmail || "",
      imei1: "",
      imei2: "",
      phoneNumber: "",
      nickname: "",
      imeiMatch: false,
      hasBlurredImei: false,
      hasBlurredImeiVerification: false,
      isImeiValid: true,
      isMobile: false,
      checkMobile() {
        const wasMobile = this.isMobile;
        this.isMobile = window.innerWidth < 768;
        if (wasMobile !== this.isMobile) {
          // Mobile state changed
        }
      },
      validateImei() {
        this.imeiMatch = this.imei1 === this.imei2;

        if (this.imei1.length === 15) {
          this.isImeiValid = isValidIMEI(this.imei1);
        } else {
          this.isImeiValid = false;
        }
      },
      isFormValid() {
        return (
          this.isImeiValid &&
          this.imeiMatch &&
          this.phoneNumber.replace(/-/g, "").length === 10 &&
          this.nickname.trim().length > 0 &&
          this.nickname.length <= 64
        );
      },
      resetForm() {
        this.imei1 = "";
        this.imei2 = "";
        this.phoneNumber = "";
        this.nickname = "";
        this.imeiMatch = false;
        this.hasBlurredImei = false;
        this.hasBlurredImeiVerification = false;
        this.isImeiValid = true;
      },
      openActivateModal(imei: string | { imei?: string; phoneNumber?: string; isCspire?: boolean }) {
        const imeiValue = typeof imei === 'string' ? imei : (imei?.imei || '');
        const phoneNumber = typeof imei === 'object' ? (imei?.phoneNumber || null) : null;
        const isCspire = typeof imei === 'object' ? Boolean((imei as any)?.isCspire) : false;
        if (isCspire) {
          this.openCspireModal(imei);
          return;
        }
        this.activeDeviceImei = imeiValue;
        this.activeDevicePhoneNumber = phoneNumber;
        this.showActivateModal = true;
      },
      openCspireModal(imei?: string | { imei?: string; phoneNumber?: string; isCspire?: boolean }) {
        if (imei) {
          const imeiValue = typeof imei === 'string' ? imei : (imei?.imei || '');
          const phoneNumber = typeof imei === 'object' ? (imei?.phoneNumber || null) : null;
          this.activeDeviceImei = imeiValue;
          this.activeDevicePhoneNumber = phoneNumber;
        }
        this.showActivateModal = false;
        this.showByocModal = false;
        this.showCspireModal = true;
      },
      closeCspireModal() {
        this.showCspireModal = false;
        if (!this.pollingSubscription) {
          this.activeDeviceImei = null;
          this.activeDevicePhoneNumber = null;
        }
      },
      proceedToByocFromCspire() {
        this.showCspireModal = false;
        this.byocFromCspire = true;
        this.byocBillingCycle = 'yearly';
        this.showByocModal = true;
      },
      openByocModal(imei?: string | { imei?: string; phoneNumber?: string; isCspire?: boolean }) {
        if (imei) {
          const imeiValue = typeof imei === 'string' ? imei : (imei?.imei || '');
          const phoneNumber = typeof imei === 'object' ? (imei?.phoneNumber || null) : null;
          this.activeDeviceImei = imeiValue;
          this.activeDevicePhoneNumber = phoneNumber;
          this.byocFromCspire = typeof imei === 'object' && Boolean((imei as any)?.isCspire);
        } else {
          this.byocFromCspire = false;
        }
        this.byocBillingCycle = 'yearly';
        this.showActivateModal = false;
        this.showByocModal = true;
      },
      closeByocModal() {
        this.showByocModal = false;
        if (this.byocFromCspire) {
          this.showCspireModal = true;
        } else {
          this.showActivateModal = true;
        }
      },
      closeActivateModal() {
        this.showActivateModal = false;
        this.showByocModal = false;
        this.showCspireModal = false;
        // Don't clear activeDeviceImei if we're polling (user might have clicked X during activation)
        if (!this.pollingSubscription) {
          this.activeDeviceImei = null;
          this.activeDevicePhoneNumber = null;
        }
      },
      closeStripeModal() {
        this.showStripeModal = false;
        window.dispatchEvent(new CustomEvent('stripe-checkout-close'));
      },
      async initializeStripe() {
        try {
          const stripe = await loadStripe(STRIPE_PUBLIC_KEY);
          if (!stripe) {
            throw new Error("Stripe is not loaded");
          }
          this.stripeInstance = stripe;
          this.isStripeLoaded = true;
        } catch (error) {
          // Error initializing Stripe
        }
      },
      async handleStripeCheckout(cycle: 'monthly' | 'yearly' = 'monthly') {
        if (!this.activeDeviceImei || !this.customerEmail) return;

        // Custom PaymentElement form — StripeCheckout component handles everything
        if (this.testStripe) {
          this.stripeInitialCycle = cycle;
          this.showStripeModal = true;
          // Notify the checkout component (cross-component, window event is reliable)
          window.dispatchEvent(new CustomEvent('stripe-checkout-open'));
          return;
        }

        // Legacy embedded checkout
        try {
          // Reset session if billing cycle changed
          if (this.byocSessionCycle && this.byocSessionCycle !== cycle) {
            try { this.embeddedCheckout?.destroy(); } catch {}
            this.embeddedCheckout = undefined;
            const el = document.getElementById('stripe-subscription-element');
            if (el) el.innerHTML = '';
            this.sessionClientSecret = undefined;
            this.stripeSessionId = undefined;
            this.isStripeEmbedded = false;
          }

          // Create Stripe session if not already created
          if (!this.sessionClientSecret) {
            const imeiString = this.activeDeviceImei.replace(/[^0-9]/g, '').padEnd(15, '0');
            const data = await actions.stripe.createSubscriptionPage.orThrow({
              customerEmail: this.customerEmail,
              deviceIMEI: imeiString,
              plan: cycle
            });
            this.byocSessionCycle = cycle;
            this.sessionClientSecret = data.session.client_secret as string;
            this.stripeSessionId = data.session.id;
          }

          // Initialize embedded checkout if not already done
          if (!this.isStripeEmbedded && this.stripeInstance) {
            if (this.stripeSessionId) {
              const imeiString = this.activeDeviceImei?.replace(/[^0-9]/g, '').padEnd(15, '0') || '';
              sessionStorage.setItem('stripeCheckoutSessionId', this.stripeSessionId);
              sessionStorage.setItem('stripeCheckoutImei', imeiString);
            }
            this.embeddedCheckout = await this.stripeInstance.initEmbeddedCheckout({
              clientSecret: this.sessionClientSecret
            });
            this.embeddedCheckout?.mount("#stripe-subscription-element");
            this.isStripeEmbedded = true;
          }

          // Re-show dialog if already embedded
          if (this.isStripeEmbedded) {
            const dialog = this.$refs.stripeDialog as HTMLDialogElement;
            if (dialog) dialog.showModal();
          }
        } catch (error: any) {
          devLog.error("[BYOC] Stripe checkout error:", error);
          const msg = error?.message || error?.error?.message || JSON.stringify(error);
          alert("Failed to open checkout: " + msg);
        }
      },
      async checkSubscriptionStatus(imei: string, phoneNumber?: string | null): Promise<boolean> {
        try {
          let devicePhoneNumber = phoneNumber || this.activeDevicePhoneNumber;

          // If no phone number provided, try to find it from device cards
          if (!devicePhoneNumber) {
            const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');

            for (const card of Array.from(deviceCards)) {
              const cardData = (window as any).Alpine?.$data?.(card);
              if (cardData && cardData.imei === imei) {
                devLog.log("PAY DEBUG: [4.6] Found matching device card for IMEI:", imei);
                const phoneElement = card.querySelector('p.text-gray-500');
                if (phoneElement) {
                  const phoneText = phoneElement.textContent || '';
                  const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
                  if (phoneMatch) {
                    devicePhoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
                    devLog.log("PAY DEBUG: [4.7] Extracted phone number from DOM:", devicePhoneNumber);
                    break;
                  }
                }
              }
            }
          }

          if (!devicePhoneNumber) {
            devLog.error("PAY DEBUG: [4.8] ERROR - Could not find phone number for device");
            return false;
          }

          const normalizedImei = imei.replace(/[^0-9]/g, '');
          devLog.log("PAY DEBUG: [4.9] Calling validateIsUserSubscribed with:");
          devLog.log("PAY DEBUG: [4.10]   - IMEI (normalized):", normalizedImei);
          devLog.log("PAY DEBUG: [4.11]   - Phone number:", devicePhoneNumber);

          // Call the subscription validation action
          const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
            imei: normalizedImei,
            phoneNumber: devicePhoneNumber
          });

          devLog.log("PAY DEBUG: [4.12] validateIsUserSubscribed result:", result);
          devLog.log("PAY DEBUG: [4.13] isSubscribed:", result?.isSubscribed);

          return result?.isSubscribed === true;
        } catch (error) {
          devLog.error("PAY DEBUG: [4.14] ERROR checking subscription status:", error);
          return false;
        }
      },
      async startSubscriptionPolling(imei: string, phoneNumber?: string | null) {
        devLog.log("PAY DEBUG: [5] startSubscriptionPolling called");
        devLog.log("PAY DEBUG: [5.1] IMEI:", imei);
        devLog.log("PAY DEBUG: [5.2] Phone number:", phoneNumber);
        devLog.log("PAY DEBUG: [5.3] Already polling?", this.pollingSubscription);

        if (this.pollingSubscription) {
          devLog.log("PAY DEBUG: [5.4] Already polling, returning");
          return; // Already polling
        }

        this.pollingSubscription = true;
        this.isLoading = true; // Show loading bar
        const maxAttempts = 20; // Poll for up to 60 seconds (20 * 3s)
        let attempts = 0;
        devLog.log("PAY DEBUG: [5.5] Starting polling with maxAttempts:", maxAttempts);

        const poll = async () => {
          attempts++;
          devLog.log(`PAY DEBUG: [5.6] Polling subscription status (attempt ${attempts}/${maxAttempts})...`);

          const isSubscribed = await this.checkSubscriptionStatus(imei, phoneNumber);
          devLog.log("PAY DEBUG: [5.7] Poll result - isSubscribed:", isSubscribed);

          if (isSubscribed) {
            devLog.log("PAY DEBUG: [5.8] Subscription detected! Redirecting to device info page...");
            devLog.log("PAY DEBUG: [5.8.1] REDIRECT TRIGGER: Polling path - subscription detected via polling");
            devLog.log("PAY DEBUG: [5.8.2] REDIRECT REASON: Subscription status check returned true");
            devLog.log("PAY DEBUG: [5.8.3] REDIRECT SOURCE: Dashboard polling mechanism");
            devLog.log("PAY DEBUG: [5.8.4] REDIRECT DATA - IMEI:", imei);
            devLog.log("PAY DEBUG: [5.8.5] REDIRECT DATA - Phone Number:", phoneNumber);
            this.stopSubscriptionPolling();

            // Normal redirect to device info page (deeplink auto-trigger only happens in manage/imei page)
            const imeiString = imei.replace(/[^0-9]/g, '').padEnd(15, '0');
            const redirectPath = `/manage/${imeiString}`;
            devLog.log("PAY DEBUG: [5.9] Redirecting to device info page:", redirectPath);
            devLog.log("PAY DEBUG: [5.9.1] REDIRECT TARGET:", redirectPath);
            devLog.log("PAY DEBUG: [5.9.2] REDIRECT FULL URL:", window.location.origin + redirectPath);
            devLog.log("PAY DEBUG: [5.9.3] REDIRECT EXECUTING NOW...");
            window.location.href = redirectPath;
            return;
          }

          if (attempts >= maxAttempts) {
            devLog.log("PAY DEBUG: [5.13] Polling timeout reached. Device will show 'Activate Plan' button.");
            this.stopSubscriptionPolling();
            // Keep loading bar visible during reload
            // Refresh page to show updated status
            devLog.log("PAY DEBUG: [5.14] Reloading page due to timeout");
            window.location.reload();
            return;
          }

          // Continue polling
          devLog.log("PAY DEBUG: [5.15] Scheduling next poll in 3 seconds");
          this.pollingInterval = setTimeout(poll, 3000);
        };

        // Start polling immediately (no delay for first check)
        devLog.log("PAY DEBUG: [5.16] Starting first poll immediately");
        poll();
      },
      stopSubscriptionPolling() {
        if (this.pollingInterval !== null) {
          clearTimeout(this.pollingInterval);
          this.pollingInterval = null;
        }
        this.pollingSubscription = false;
        // Don't set isLoading to false here - let it stay true during redirect/reload
      },
      handleRemoveDevice(event: Event) {
        const form = event.target as HTMLFormElement;
        if (!this.activeDeviceImei) {
          devLog.error("No device IMEI selected");
          return;
        }
        if (confirm('Are you sure you want to remove this device from your account? You can re-add it later by selecting "Add Device" on the Devices page.')) {
          // Convert IMEI string to number for the form
          const imeiInput = form.querySelector('input[name="imei"]') as HTMLInputElement;
          if (imeiInput) {
            const imeiNumber = parseInt(this.activeDeviceImei.replace(/[^0-9]/g, ''), 10);
            imeiInput.value = imeiNumber.toString();
          }
          form.submit();
        }
      },
      /**
       * Update device card subscription status
       */
      updateDeviceCardSubscription(imei: string, isSubscribed: boolean): void {
        const normalizedImei = imei.replace(/[^0-9]/g, '').padEnd(15, '0');

        // Find device card element
        const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
        for (const card of Array.from(deviceCards)) {
          const cardData = (window as any).Alpine?.$data?.(card);
          if (cardData && cardData.imei === normalizedImei) {
            cardData.isSubscribed = isSubscribed;
            break;
          }
        }
      },

      /**
       * Initialize background polling for unsubscribed devices
       */
      initializeBackgroundPolling(): void {
        devLog.log("[POLL] initializeBackgroundPolling() called");

        // Initialize polling service immediately so it's available for addDevice() calls
        if (!subscriptionPollingService) {
          devLog.log("[POLL] Creating SubscriptionPollingService (pollInterval: 10s)");
          subscriptionPollingService = new SubscriptionPollingService({
            pollInterval: 10000, // 10 seconds
            checkSubscription: async (imei: string, phoneNumber: string) => {
              devLog.log("[POLL] Checking subscription status - IMEI:", imei, "Phone:", phoneNumber);
              try {
                const normalizedImei = imei.replace(/[^0-9]/g, '');
                const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
                  imei: normalizedImei,
                  phoneNumber: phoneNumber
                });
                devLog.log("[POLL] Subscription check result - IMEI:", imei, "isSubscribed:", result?.isSubscribed);
                return result?.isSubscribed === true;
              } catch (error) {
                devLog.error("[POLL] Subscription check failed - IMEI:", imei, "Error:", error);
                return false;
              }
            },
            onSubscriptionDetected: (device) => {
              devLog.log("[POLL] Subscription detected via callback - IMEI:", device.imei, "Phone:", device.phoneNumber);
              this.updateDeviceCardSubscription(device.imei, true);
            }
          });
          devLog.log("[POLL] SubscriptionPollingService created");
        } else {
          devLog.log("[POLL] SubscriptionPollingService already exists, reusing");
        }

        // Register event listener immediately so no subscription-detected events are missed
        window.addEventListener('subscription-detected', ((event: CustomEvent) => {
          const { imei } = event.detail;
          devLog.log("[POLL] subscription-detected window event received - IMEI:", imei);
          this.updateDeviceCardSubscription(imei, true);
        }) as EventListener);

        // Wait for Alpine to finish initializing device cards, then start polling
        setTimeout(() => {
          devLog.log("[POLL] 500ms timeout fired — scanning for unsubscribed device cards");
          const unsubscribedDevices: Device[] = [];

          const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
          devLog.log("[POLL] Total device cards found:", deviceCards.length);

          for (const card of Array.from(deviceCards)) {
            const cardData = (window as any).Alpine?.$data?.(card);
            if (!cardData) {
              devLog.warn("[POLL] Could not read Alpine data for card:", card);
              continue;
            }
            devLog.log("[POLL] Device card - IMEI:", cardData.imei, "isSubscribed:", cardData.isSubscribed, "phoneNumber:", cardData.phoneNumber || '(empty)');
            if (!cardData.isSubscribed && cardData.phoneNumber) {
              devLog.log("[POLL] Adding to polling list - IMEI:", cardData.imei);
              unsubscribedDevices.push({
                imei: cardData.imei,
                phoneNumber: cardData.phoneNumber
              });
            } else if (!cardData.isSubscribed && !cardData.phoneNumber) {
              devLog.warn("[POLL] Skipping unsubscribed device — no phone number - IMEI:", cardData.imei);
            }
          }

          devLog.log("[POLL] Unsubscribed devices to poll:", unsubscribedDevices.length, unsubscribedDevices);

          if (unsubscribedDevices.length > 0) {
            devLog.log("[POLL] Starting SubscriptionPollingService for", unsubscribedDevices.length, "device(s)");
            subscriptionPollingService!.startPolling(unsubscribedDevices);
          } else {
            devLog.log("[POLL] No unsubscribed devices with phone numbers found — polling not started");
          }
        }, 500);
      },

      async init() {
        devLog.log("[BYOC] Dashboard component initialized");
        devLog.log("[BYOC] Initial state - customerEmail:", this.customerEmail, "activeDeviceImei:", this.activeDeviceImei);

        // Always reset billing cycle to yearly whenever the BYOC modal opens
        this.$watch('showByocModal', (val: boolean) => {
          if (val) this.byocBillingCycle = 'yearly';
        });
        
        // Initialize mobile detection
        this.checkMobile();
        devLog.log("[BREAKPOINT 5] Mobile detection initialized:", {
          isMobile: this.isMobile,
          viewportWidth: window.innerWidth,
          userAgent: navigator.userAgent
        });
        
        // Listen for window resize
        window.addEventListener('resize', () => this.checkMobile());
        
        // Initialize Stripe
        await this.initializeStripe();
        devLog.log("[BYOC] After Stripe init - isStripeLoaded:", this.isStripeLoaded);

        // Initialize background polling for unsubscribed devices
        this.initializeBackgroundPolling();

        // Check if a new unsubscribed device was just added
        if (initialData?.newDevice?.imei) {
          devLog.log("New unsubscribed device detected, opening activate modal:", initialData.newDevice);
          // Wait a bit for Alpine to fully initialize
          await new Promise(resolve => setTimeout(resolve, 300));
          if (initialData.newDevice.isCspire) {
            this.openCspireModal(initialData.newDevice);
          } else {
            this.openActivateModal({
              imei: initialData.newDevice.imei,
              phoneNumber: initialData.newDevice.phoneNumber
            });
          }

          // Add device to polling service
          if (subscriptionPollingService && initialData.newDevice.phoneNumber) {
            subscriptionPollingService.addDevice({
              imei: initialData.newDevice.imei,
              phoneNumber: initialData.newDevice.phoneNumber
            });
          }
          return;
        }

        // Handle activation redirect on component initialization
        devLog.log("PAY DEBUG: [2] Dashboard init() - checking for activation redirect");
        const urlParams = new URLSearchParams(window.location.search);
        let activated = urlParams.get('activated');
        let imei = urlParams.get('imei');
        let sessionId = urlParams.get('session_id');

        // If session_id is missing or is the placeholder, try to get it from sessionStorage
        if ((!sessionId || sessionId === '{CHECKOUT_SESSION_ID}') && activated === 'true') {
          devLog.log("PAY DEBUG: [2.0.1] session_id missing or is placeholder, checking sessionStorage");
          const storedSessionId = sessionStorage.getItem('stripeCheckoutSessionId');
          const storedImei = sessionStorage.getItem('stripeCheckoutImei');

          if (storedSessionId && storedImei) {
            devLog.log("PAY DEBUG: [2.0.2] Found session ID in sessionStorage:", storedSessionId);
            devLog.log("PAY DEBUG: [2.0.3] Found IMEI in sessionStorage:", storedImei);

            // Use stored values
            sessionId = storedSessionId;
            if (!imei) {
              imei = storedImei;
            }

            // Update URL with actual session_id
            const url = new URL(window.location.href);
            url.searchParams.set('session_id', sessionId);
            if (!url.searchParams.has('imei')) {
              url.searchParams.set('imei', storedImei);
            }
            window.history.replaceState({}, '', url.toString());
            devLog.log("PAY DEBUG: [2.0.4] Updated URL with session_id from sessionStorage");
            devLog.log("PAY DEBUG: [2.0.5] Keeping sessionStorage for manage page fallback - will be cleared after validation");
          } else {
            devLog.log("PAY DEBUG: [2.0.5] No session ID found in sessionStorage either");
          }
        }

        devLog.log("PAY DEBUG: [2.1] URL params - activated:", activated, "imei:", imei, "session_id:", sessionId);

        if (activated === 'true' && imei) {
          devLog.log("PAY DEBUG: [2.2] Activation detected, showing loading bar");
          // Show loading bar immediately
          this.isLoading = true;

          // If we have a session_id, validate the Stripe subscription first
          if (sessionId) {
            devLog.log("PAY DEBUG: [2.3] session_id found, validating subscription");
            try {
              const imeiString = imei.replace(/[^0-9]/g, '').padEnd(15, '0');
              devLog.log("PAY DEBUG: [2.4] Calling validateSubscription with:");
              devLog.log("PAY DEBUG: [2.5]   - sessionId:", sessionId);
              devLog.log("PAY DEBUG: [2.6]   - imei (normalized):", imeiString);

              const validationResult = await actions.stripe.validateSubscription.orThrow({
                sessionId: sessionId,
                imei: imeiString
              });

              devLog.log("PAY DEBUG: [2.7] validateSubscription result:", validationResult);
              devLog.log("PAY DEBUG: [2.8] isSubscribed:", validationResult?.isSubscribed);

              if (validationResult?.isSubscribed) {
                devLog.log("PAY DEBUG: [2.9] Subscription validated successfully, redirecting to device page");
                devLog.log("PAY DEBUG: [2.9.0] REDIRECT TRIGGER: Direct validation path - session_id validation succeeded");
                devLog.log("PAY DEBUG: [2.9.0.1] REDIRECT REASON: Stripe subscription validation returned isSubscribed=true");
                devLog.log("PAY DEBUG: [2.9.0.2] REDIRECT SOURCE: Dashboard init() - All-in-One Plan activation");
                devLog.log("PAY DEBUG: [2.9.0.3] REDIRECT DATA - IMEI:", imeiString);
                devLog.log("PAY DEBUG: [2.9.0.4] REDIRECT DATA - Session ID:", sessionId);
                // Subscription is valid, redirect to device info page with session_id and validated flag
                // Don't clear sessionStorage here - let manage page clear it after validation
                const redirectUrl = new URL(`/manage/${imeiString}`, window.location.origin);
                redirectUrl.searchParams.set('session_id', sessionId);
                redirectUrl.searchParams.set('validated', 'true');
                devLog.log("PAY DEBUG: [2.9.1] Redirecting with session_id and validated flag:", redirectUrl.toString());
                devLog.log("PAY DEBUG: [2.9.1.1] REDIRECT TARGET:", redirectUrl.toString());
                devLog.log("PAY DEBUG: [2.9.1.2] REDIRECT URL PARAMS:", Object.fromEntries(redirectUrl.searchParams.entries()));
                devLog.log("PAY DEBUG: [2.9.1.3] REDIRECT EXECUTING NOW...");
                window.location.href = redirectUrl.toString();
                return;
              } else {
                devLog.log("PAY DEBUG: [2.10] Subscription validation returned false, will start polling");
              }
            } catch (error) {
              devLog.error("PAY DEBUG: [2.11] ERROR validating Stripe session:", error);
              // Continue with polling if validation fails
            }
          } else {
            devLog.log("PAY DEBUG: [2.3] No session_id in URL, skipping validation, will start polling");
          }

          // Clean up URL parameters
          devLog.log("PAY DEBUG: [3] Cleaning up URL parameters");
          const cleanUrl = new URL(window.location.href);
          cleanUrl.searchParams.delete('activated');
          cleanUrl.searchParams.delete('imei');
          cleanUrl.searchParams.delete('session_id');
          window.history.replaceState({}, '', cleanUrl.toString());
          devLog.log("PAY DEBUG: [3.1] URL cleaned, new URL:", cleanUrl.toString());

          this.pollingImei = imei;
          devLog.log("PAY DEBUG: [3.2] Set pollingImei to:", imei);

          // Try to get phone number from sessionStorage or device data
          const storedImei = sessionStorage.getItem('activatingDeviceImei');
          let phoneNumber = null;
          devLog.log("PAY DEBUG: [3.3] Stored IMEI from sessionStorage:", storedImei);

          // Wait a bit for Alpine to initialize all device cards
          devLog.log("PAY DEBUG: [3.4] Waiting 100ms for Alpine to initialize");
          await new Promise(resolve => setTimeout(resolve, 100));

          // Try to find phone number from device cards
          devLog.log("PAY DEBUG: [3.5] Searching for phone number in device cards");
          const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
          devLog.log("PAY DEBUG: [3.6] Found device cards:", deviceCards.length);

          for (const card of Array.from(deviceCards)) {
            const cardData = (window as any).Alpine?.$data?.(card);
            if (cardData && cardData.imei === imei) {
              devLog.log("PAY DEBUG: [3.7] Found matching device card");
              // Use phoneNumber from card data if available
              if (cardData.phoneNumber) {
                phoneNumber = cardData.phoneNumber;
                devLog.log("PAY DEBUG: [3.8] Found phone number from card data:", phoneNumber);
                break;
              }
              // Fallback: try to extract from DOM
              const phoneElement = card.querySelector('p.text-gray-500');
              if (phoneElement) {
                const phoneText = phoneElement.textContent || '';
                const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
                if (phoneMatch) {
                  phoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
                  devLog.log("PAY DEBUG: [3.9] Extracted phone number from DOM:", phoneNumber);
                  break;
                }
              }
            }
          }

          // Clean up sessionStorage
          if (storedImei) {
            devLog.log("PAY DEBUG: [3.10] Cleaning up sessionStorage");
            sessionStorage.removeItem('activatingDeviceImei');
            sessionStorage.removeItem('activationType');
          }

          // Start polling - loading bar will stay visible until redirect/reload
          devLog.log("PAY DEBUG: [3.11] Starting subscription polling with IMEI:", imei, "Phone:", phoneNumber);
          await this.startSubscriptionPolling(imei, phoneNumber);
        }
      }
    }));

    Alpine.data("deviceCard", (deviceData: { imei: string; isSubscribed: boolean; phoneNumber?: string; isCspire?: boolean }) => ({
      imei: deviceData.imei,
      isSubscribed: deviceData.isSubscribed,
      phoneNumber: deviceData.phoneNumber || '',
      isCspire: deviceData.isCspire || false,
      init() {
        devLog.log("Device card initialized:", { imei: this.imei, isSubscribed: this.isSubscribed, phoneNumber: this.phoneNumber });

        // Update subscription status if it changed
        this.$watch('isSubscribed', (value) => {
          if (value) {
            devLog.log(`Device ${this.imei} is now subscribed`);
            // Remove from polling service if it exists
            if (subscriptionPollingService) {
              subscriptionPollingService.removeDevice(this.imei);
            }
          }
        });

        // Listen for subscription detected events
        const handleSubscriptionDetected = ((event: CustomEvent) => {
          if (event.detail.imei === this.imei) {
            this.isSubscribed = true;
          }
        }) as EventListener;

        window.addEventListener('subscription-detected', handleSubscriptionDetected);

        // Cleanup listener on component destroy
        this.$el.addEventListener('alpine:destroyed', () => {
          window.removeEventListener('subscription-detected', handleSubscriptionDetected);
        });
      },
      openActivateModal() {
        devLog.log("Device card openActivateModal called for IMEI:", this.imei, "isSubscribed:", this.isSubscribed);
        const payload = { imei: this.imei, phoneNumber: this.phoneNumber, isCspire: this.isCspire };
        // Try to find the dashboard component
        const dashboardEl = document.querySelector('[x-data="dashboard"]');
        if (dashboardEl) {
          const dashboardData = (window as any).Alpine?.$data?.(dashboardEl);
          if (dashboardData && typeof dashboardData.openActivateModal === 'function') {
            devLog.log("Found dashboard, calling openActivateModal");
            dashboardData.openActivateModal(payload);
            return;
          }
        }
        // Fallback: dispatch event
        devLog.log("Dispatching activate-modal event");
        (this as any).$dispatch('activate-modal', payload);
      },
      async checkSubscriptionStatus() {
        // This can be called after user returns from activation
        try {
          // Get phone number from device card
          const phoneElement = this.$el.querySelector('p.text-gray-500');
          let phoneNumber = '';
          if (phoneElement) {
            const phoneText = phoneElement.textContent || '';
            const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
            if (phoneMatch) {
              phoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
            }
          }

          if (!phoneNumber) {
            devLog.error("Could not find phone number");
            window.location.reload();
            return;
          }

          const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
            imei: this.imei.replace(/[^0-9]/g, ''),
            phoneNumber: phoneNumber
          });

          if (result?.isSubscribed === true) {
            this.isSubscribed = true;

            // Normal redirect to device info page (deeplink auto-trigger only happens in manage/imei page)
            devLog.log("PAY DEBUG: [D1] Subscription confirmed, redirecting to manage page");
            devLog.log("PAY DEBUG: [D1.1] REDIRECT TRIGGER: Device card checkSubscriptionStatus - subscription confirmed");
            devLog.log("PAY DEBUG: [D1.2] REDIRECT REASON: validateIsUserSubscribed returned isSubscribed=true");
            devLog.log("PAY DEBUG: [D1.3] REDIRECT SOURCE: Dashboard device card subscription check");
            devLog.log("PAY DEBUG: [D1.4] REDIRECT DATA - IMEI:", this.imei);
            const redirectPath = `/manage/${this.imei}`;
            devLog.log("PAY DEBUG: [D1.5] REDIRECT TARGET:", redirectPath);
            devLog.log("PAY DEBUG: [D1.6] REDIRECT FULL URL:", window.location.origin + redirectPath);
            devLog.log("PAY DEBUG: [D1.7] REDIRECT EXECUTING NOW...");
            window.location.href = redirectPath;
          } else {
            // Refresh to show updated status
            window.location.reload();
          }
        } catch (error) {
          devLog.error("Error checking subscription:", error);
          window.location.reload();
        }
      }
    }));

    // Cleanup polling service on page unload
    window.addEventListener('beforeunload', () => {
      if (subscriptionPollingService) {
        subscriptionPollingService.destroy();
        subscriptionPollingService = null;
      }
    });

    // Also cleanup on page hide (when navigating away)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && subscriptionPollingService) {
        // Service will pause automatically via Page Visibility API
        // But we can also manually pause if needed
        subscriptionPollingService.pausePolling();
      }
    });
  });
</script>

</Layout>
