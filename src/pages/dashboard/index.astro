---
import { actions } from "astro:actions";
import { db, eq, Wisephone, BypassTechlessSubscription } from "astro:db";
import Icon from "astro-iconify";
import phoneImg from "@/assets/phone.png";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import AstroActionToastResponse from "@/components/AstroActionToastResponse.astro";
import WisephoneLogo from "@/components/WisephoneLogo.astro";
import DashboardSidebar from "@/components/DashboardSidebar.astro";
import IsAdmin from "@/components/server-islands/IsAdmin.astro";
import { SignOutButton } from "@clerk/astro/components";
import { validateIsSubscribed } from "@/libs/stripe";
import { devLog } from "@/libs/utils";

if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}

const user = await Astro.locals.currentUser();

if (!user) {
  return Astro.redirect("/");
}

const wisephones = await db.select().from(Wisephone).where(eq(Wisephone.userId, user.id));
devLog.log("Index.astro wisephones list",wisephones);
const derivedHasNoWisephone = wisephones.length === 0;
devLog.log(derivedHasNoWisephone);

// Check subscription status for each device
const wisephonesWithSubscription = await Promise.all(
  wisephones.map(async (wisephone) => {
    // Check for bypass subscription first
    const bypassTechlessSubscription = await db
      .select()
      .from(BypassTechlessSubscription)
      .where(eq(BypassTechlessSubscription.imei, Number(wisephone.imei)))
      .limit(1);

    let isSubscribed = bypassTechlessSubscription.length > 0;

    // If not bypassed, check actual subscription
    if (!isSubscribed && wisephone.phoneNumber) {
      try {
        isSubscribed = await validateIsSubscribed({
          imei: wisephone.imei.toString(),
          phoneNumber: `${wisephone.phoneNumber.replace(/[^0-9+]/g, "") || ""}`
        });
        devLog.log(`Device ${wisephone.imei} subscription status: ${isSubscribed}`);
      } catch (error) {
        devLog.error(`Error checking subscription for device ${wisephone.imei}:`, error);
        isSubscribed = false;
      }
    } else if (!wisephone.phoneNumber) {
      devLog.log(`Device ${wisephone.imei} has no phone number, defaulting to not subscribed`);
    }

    return {
      ...wisephone,
      isSubscribed
    };
  })
);

const actionResult = Astro.getActionResult(actions.wisephones.createWisephone);

// If a device was just added and it's subscribed, redirect to manage page
if (actionResult?.data?.isSubscribed && actionResult?.data?.wisephone?.[0]?.imei) {
  const imeiPadded = actionResult.data.wisephone[0].imei.toString().padEnd(15, "0");
  return Astro.redirect(`/manage/${imeiPadded}`);
}
