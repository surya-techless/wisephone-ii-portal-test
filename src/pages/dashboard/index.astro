---
import { actions } from "astro:actions";
import { db, eq, Wisephone } from "astro:db";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Icon from "astro-iconify";

if (!Astro.locals.auth().userId) {
  return Astro.redirect("/");
}

const user = await Astro.locals.currentUser();

if (!user) {
  return Astro.redirect("/");
}

const wisephones = await db.select().from(Wisephone).where(eq(Wisephone.userId, user.id));
const derivedHasNoWisephone = wisephones.length === 0;

const result = Astro.getActionResult(actions.wisephones.createWisephone);
---

<Layout title="Dashboard" description="Manage your Wisephone II devices.">
  <div
    class="container h-full p-6 mx-auto prose"
    x-data="{
      showForm: false,
    }"
    x-init={`
      toastErrorMessage = '${result?.error?.message || ""}' || toastErrorMessage;
      toastMessage = '${result?.data?.success || ""}' || toastMessage;
    `}
  >
    <Header activeTab="page" isProjectPublished={false} projectSlug={""} />

    <main class="flex flex-col gap-6 py-12">
      {
        derivedHasNoWisephone ? (
          <Fragment>
            <section
              class="flex flex-col items-center justify-center w-full p-6 bg-transparent border-2 rounded-2xl border-slate-200"
              x-show="!showForm"
            >
              <h1 class="text-3xl font-bold">Connect to your Wisephone.</h1>
              <p class="m-0 text-center">Connect your Wisephone II to manage your device's experience.</p>
              <button class="mt-8 btn btn-primary w-fit" @click="showForm = true">
                Get Started
              </button>
            </section>
          </Fragment>
        ) : (
          <Fragment>
            <h1 class="p-0 m-0 text-3xl font-bold">Your Devices</h1>
            <section class="flex flex-col items-center justify-center w-full bg-white shadow not-prose rounded-2xl">
              <ul class="flex flex-col items-center justify-center w-full p-0 m-0 rounded-2xl">
                {wisephones.map((wisephone) => (
                  <li class="w-full [&:not(:last-child)]:border-b border-slate-200">
                    <a
                      href={`/dashboard/device/${wisephone.imei}`}
                      class="no-underline m-0 p-0 py-4 px-6 w-full grid grid-cols-[1fr_auto] items-center justify-center [&:not(:last-child)]:border-b border-slate-200 hover:bg-slate-50 cursor-pointer active:scale-[98%] transition-all duration-150"
                    >
                      <div class="flex flex-col w-full">
                        <p class="p-0 m-0 font-semibold">{wisephone.nickname}</p>
                        <p class="p-0 m-0 text-slate-500">{wisephone.phoneNumber}</p>
                      </div>
                      <Icon name="lucide:chevron-right" class="w-6 h-6" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
            <button x-show="!showForm" @click="showForm = true" class="btn btn-ghost hover:bg-slate-200">
              <Icon name="lucide:plus" class="w-6 h-6" />
              Add Another Wisephone
            </button>
          </Fragment>
        )
      }

      <section
        class="flex flex-col items-start justify-center w-full p-6 bg-white shadow rounded-2xl"
        x-show="showForm"
        x-transition
        x-cloak
      >
        <div class="flex flex-row justify-between w-full gap-4">
          <h2 class="text-2xl font-bold">Setup</h2>

          <button @click="showForm = false" class="btn btn-sm btn-circle">
            <span class="sr-only">Close Settings</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
            >
          </button>
        </div>
        <form method="POST" action={actions.wisephones.createWisephone} class="flex flex-col w-full gap-4">
          <div class="w-full form-control">
            <label class="label">
              <span class="label-text">Wisephone IMEI (slot 1)</span>
              <span class="label-text-alt">Required</span>
            </label>
            <input
              type="text"
              name="imei"
              x-mask="999999999999999"
              placeholder="350XXXXXXXXXXXX"
              class="w-full input input-bordered"
              required
            />
            <label class="label">
              <span class="label-text w-fit text-slate-500 [&_strong]:text-slate-500">
                On the WiseOS home screen, tap <strong>"Settings"</strong> &gt; tap{" "}
                <strong>"Open System Settings"</strong> &gt; scroll to and tap <strong>"About phone"</strong> &gt; hold down
                on <strong>"IMEI (slot 1)"</strong> to copy the number.
              </span>
            </label>
          </div>

          <div class="w-full form-control">
            <label class="label">
              <span class="label-text">Wisephone Phone Number</span>
              <span class="label-text-alt">Required</span>
            </label>
            <input
              type="text"
              name="phoneNumber"
              x-mask="999-999-9999"
              placeholder="XXX-XXX-XXXX"
              class="w-full input input-bordered"
              required
            />
          </div>

          <div class="w-full form-control">
            <label class="label">
              <span class="label-text">Give this Wisephone a name or owner</span>
              <span class="label-text-alt">Required</span>
            </label>
            <input type="text" name="nickname" placeholder="John Doe" class="w-full input input-bordered" required />
          </div>

          <input type="hidden" name="userId" value={user?.id} />

          <button type="submit" class="mt-4 btn btn-primary"> Done </button>
        </form>
      </section>
    </main>
  </div>

  <div class="mb-12">
    <Footer showLogo={false} />
  </div>
</Layout>
