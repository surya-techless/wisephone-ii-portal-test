              :class="{ 'border-red-500': phoneNumber.length > 0 && phoneNumber.replace(/-/g, '').length !== 10 }"
              required
            />
          </div>

          <div>
            <label for="nickname" class="block text-sm font-medium text-gray-700 mb-1">
              Give this Wisephone a name or owner
              <span class="text-red-500">*</span>
            </label>
            <input
              id="nickname"
              x-model.trim="nickname"
              type="text"
              name="nickname"
              placeholder="John Doe"
              maxlength="64"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              :class="{ 'border-red-500': (nickname.length > 0 && nickname.trim().length === 0) || nickname.length > 64 }"
              required
            />
            <div x-show="nickname.length > 64">
              <p class="text-sm text-red-500 mt-1">
                Name must not exceed 64 characters
              </p>
            </div>
          </div>

          <input type="hidden" name="userId" value={user?.id} />

          <div class="flex justify-end gap-3 pt-4">
            <button type="button" @click="showForm = false; resetForm()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed" :disabled="!isFormValid()">
              Add Device
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  </Fragment>

  <!-- Activate Plan Modal -->
  <div
    x-show="showActivateModal"
    x-cloak
    x-transition.opacity
    class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
    @click.self="closeActivateModal()"
  >
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-gray-200 p-4 md:p-6 flex justify-between items-center">
        <h2 class="text-xl md:text-2xl font-semibold text-gray-800">Activate Plan</h2>
        <button @click="closeActivateModal()" class="text-gray-400 hover:text-gray-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-4 md:p-6">
        <p class="text-sm md:text-base text-gray-600 mb-6">
          Your Wisephone needs an active subscription. Choose your WiseOS plan:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          <!-- WiseOS with Data -->
          <div class="border border-gray-300 rounded-lg p-4 md:p-6 flex flex-col h-full">
            <h3 class="text-base md:text-lg font-semibold text-gray-900 mb-1">
              WiseOS with Data
            </h3>
            <p class="text-xs md:text-sm text-gray-500 mb-2">(All-in-One Subscription)</p>
            <p class="text-sm md:text-base text-gray-700 mb-3 leading-snug">
              Get everything in one place: WiseOS, talk, text, and data bundled together for a seamless, hassle-free experience.
              <a
                class="text-blue-600 underline text-xs md:text-sm"
                href="https://wisephone.com/pages/plans"
                target="_blank"
                rel="noopener noreferrer"
              >
                Learn more
              </a>
            </p>
            <div class="text-xs md:text-sm text-gray-600 mb-4">
              <p class="font-semibold mb-1">Includes:</p>
              <ul class="list-disc list-inside space-y-1">
                <li>WiseOS Subscription</li>
                <li>Carrier Service (Data, Talk, and Text)</li>
              </ul>
            </div>
            <a
              href="https://plans.techless.com/"
              target="_blank"
              rel="noopener noreferrer"
              @click="closeActivateModal()"
              class="flex items-center justify-center gap-1 w-full px-4 py-2 bg-[#C07F53] text-white rounded-md text-sm font-medium hover:bg-[#A06F43] transition-colors cursor-pointer mt-auto"
            >
              Activate All‑In‑One Plan
              <Icon name="lucide:external-link" class="w-4 h-4" />
            </a>
          </div>

          <!-- Bring Your Own Carrier -->
          <div class="border border-gray-300 rounded-lg p-4 md:p-6 flex flex-col h-full">
            <h3 class="text-base md:text-lg font-semibold text-gray-900 mb-1">
              Bring Your Own Carrier
            </h3>
            <p class="text-xs md:text-sm text-gray-500 mb-2">(WiseOS Subscription - no data included)</p>
            <p class="text-sm md:text-base text-gray-700 mb-3 leading-snug">
              Perfect if you already have a carrier you love. Enjoy all the features of WiseOS while keeping your existing mobile plan.
              <a
                class="text-blue-600 underline text-xs md:text-sm"
                href="https://wisephone.com/pages/plans"
                target="_blank"
                rel="noopener noreferrer"
              >
                Learn more
              </a>
            </p>
            <div class="text-xs md:text-sm text-gray-600 mb-4">
              <p class="font-semibold mb-1">Includes:</p>
              <ul class="list-disc list-inside space-y-1">
                <li>WiseOS Subscription</li>
                <li>No carrier service included — bring your own plan</li>
              </ul>
            </div>
            <button
              @click="handleStripeCheckout()"
              :disabled="!isStripeLoaded || !activeDeviceImei"
              class="flex items-center justify-center gap-1 w-full px-4 py-2 bg-[#C07F53] text-white rounded-md text-sm font-medium hover:bg-[#A06F43] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed mt-auto"
            >
              Activate BYOC Plan
            </button>
          </div>
        </div>

        <p class="text-xs md:text-sm text-gray-500 italic mt-2 mb-4">
          *Both subscription options are managed through third party portals.
        </p>

        <!-- Remove Device Button -->
        <div class="p-4 md:p-6">
          <form
            method="POST"
            action={actions.wisephones.deleteWisephone}
            @submit.prevent="handleRemoveDevice($event)"
          >
            <input type="hidden" name="imei" x-bind:value="activeDeviceImei ? parseInt(activeDeviceImei.replace(/[^0-9]/g, '')) : ''" />
            <button
              type="submit"
              class="w-full px-4 py-2 text-sm font-medium text-red-600 bg-white border border-red-300 rounded-md hover:bg-red-50 transition-colors"
            >
              Remove Device
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Stripe Checkout Dialog -->
  <dialog x-ref="stripeDialog" class="modal">
    <div style="background-color: rgb(247, 246, 242)" class="modal-box max-w-2xl">
      <div id="stripe-subscription-element"></div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

</main>

</div>

<script>
  import Alpine from "alpinejs";
  import { isValidIMEI, STRIPE_PUBLIC_KEY, updateUnreachableAlpineState, devLog } from "@/libs/utils";
  import { actions } from "astro:actions";
  import { loadStripe, type Stripe } from "@stripe/stripe-js";
  import { SubscriptionPollingService, type Device } from "@/services/SubscriptionPollingService";

  // Initialize subscription polling service
  let subscriptionPollingService: SubscriptionPollingService | null = null;

  document.addEventListener("alpine:init", () => {
    Alpine.data("dashboard", (initialData?: { userEmail?: string; newDevice?: { imei: string; phoneNumber: string } | null }) => ({
      showForm: false,
      isLoading: false,
      mobileMenuOpen: false,
      showAccountMenu: false,
      showActivateModal: false,
      activeDeviceImei: null as string | null,
      activeDevicePhoneNumber: null as string | null,
      pollingSubscription: false,
      pollingInterval: null as ReturnType<typeof setTimeout> | null,
      shouldStartPolling: false,
      pollingImei: null as string | null,
      isStripeLoaded: false,
      isStripeEmbedded: false,
      stripeInstance: undefined as Stripe | undefined,
      sessionClientSecret: undefined as string | undefined,
      stripeSessionId: undefined as string | undefined,
      customerEmail: initialData?.userEmail || "",
      imei1: "",
      imei2: "",
      phoneNumber: "",
      nickname: "",
      imeiMatch: false,
      hasBlurredImei: false,
      hasBlurredImeiVerification: false,
      isImeiValid: true,
      validateImei() {
        this.imeiMatch = this.imei1 === this.imei2;

        if (this.imei1.length === 15) {
          this.isImeiValid = isValidIMEI(this.imei1);
        } else {
          this.isImeiValid = false;
        }
      },
      isFormValid() {
        return (
          this.isImeiValid &&
          this.imeiMatch &&
          this.phoneNumber.replace(/-/g, "").length === 10 &&
          this.nickname.trim().length > 0 &&
          this.nickname.length <= 64
        );
      },
      resetForm() {
        this.imei1 = "";
        this.imei2 = "";
        this.phoneNumber = "";
        this.nickname = "";
        this.imeiMatch = false;
        this.hasBlurredImei = false;
        this.hasBlurredImeiVerification = false;
        this.isImeiValid = true;
      },
      openActivateModal(imei: string | { imei?: string; phoneNumber?: string }) {
        devLog.log("PAY DEBUG: [0] openActivateModal called");
        devLog.log("PAY DEBUG: [0.1] Parameter:", imei);
        // Handle both direct call and event detail
        const imeiValue = typeof imei === 'string' ? imei : (imei?.imei || '');
        const phoneNumber = typeof imei === 'object' ? (imei?.phoneNumber || null) : null;
        devLog.log("PAY DEBUG: [0.2] Opening activate modal for IMEI:", imeiValue, "Phone:", phoneNumber);
        this.activeDeviceImei = imeiValue;
        this.activeDevicePhoneNumber = phoneNumber;
        this.showActivateModal = true;
        devLog.log("PAY DEBUG: [0.3] Activate modal opened, activeDeviceImei set to:", this.activeDeviceImei);
      },
      closeActivateModal() {
        this.showActivateModal = false;
        // Don't clear activeDeviceImei if we're polling (user might have clicked X during activation)
        if (!this.pollingSubscription) {
          this.activeDeviceImei = null;
          this.activeDevicePhoneNumber = null;
        }
      },
      async initializeStripe() {
        try {
          const stripe = await loadStripe(STRIPE_PUBLIC_KEY);
          if (!stripe) {
            throw new Error("Stripe is not loaded");
          }
          this.stripeInstance = stripe;
          this.isStripeLoaded = true;
        } catch (error) {
          devLog.error("Error initializing Stripe:", error);
        }
      },
      async handleStripeCheckout() {
        devLog.log("PAY DEBUG: [1] handleStripeCheckout called");
        devLog.log("PAY DEBUG: [1.1] activeDeviceImei:", this.activeDeviceImei);
        devLog.log("PAY DEBUG: [1.2] customerEmail:", this.customerEmail);

        if (!this.activeDeviceImei || !this.customerEmail) {
          devLog.error("PAY DEBUG: [1.3] ERROR - Missing device IMEI or customer email");
          return;
        }

        try {
          // Create Stripe session if not already created
          if (!this.sessionClientSecret) {
            const imeiString = this.activeDeviceImei.replace(/[^0-9]/g, '').padEnd(15, '0');
            devLog.log("PAY DEBUG: [1.4] Creating Stripe checkout session with IMEI:", imeiString);

            const data = await actions.stripe.createSubscriptionPage.orThrow({
              customerEmail: this.customerEmail,
              deviceIMEI: imeiString
            });
            devLog.log("PAY DEBUG: [1.5] Stripe checkout session created, client_secret received");
            devLog.log("PAY DEBUG: [1.5.0] Session status at creation:", data.session.status);
            devLog.log("PAY DEBUG: [1.5.0.1] Session payment status:", data.session.payment_status);
            devLog.log("PAY DEBUG: [1.5.0.2] Session subscription:", data.session.subscription);
            this.sessionClientSecret = data.session.client_secret as string;
            this.stripeSessionId = data.session.id;
            devLog.log("PAY DEBUG: [1.5.1] Stored session ID:", this.stripeSessionId);
            devLog.log("PAY DEBUG: [1.5.2] NOTE: Session created but subscription NOT activated yet - user must complete checkout");
          } else {
            devLog.log("PAY DEBUG: [1.4] Using existing session client secret");
          }

          // Initialize embedded checkout if not already done
          if (!this.isStripeEmbedded && this.stripeInstance) {
            devLog.log("PAY DEBUG: [1.6] Initializing embedded Stripe checkout");

            // Store session ID in sessionStorage before mounting checkout
            // This way we can retrieve it after Stripe redirects (since return_url doesn't replace {CHECKOUT_SESSION_ID})
            if (this.stripeSessionId) {
              const imeiString = this.activeDeviceImei?.replace(/[^0-9]/g, '').padEnd(15, '0') || '';
              sessionStorage.setItem('stripeCheckoutSessionId', this.stripeSessionId);
              sessionStorage.setItem('stripeCheckoutImei', imeiString);
              devLog.log("PAY DEBUG: [1.6.0] Stored session ID in sessionStorage:", this.stripeSessionId);
              devLog.log("PAY DEBUG: [1.6.0.1] Stored IMEI in sessionStorage:", imeiString);
            }

            const checkout = await this.stripeInstance.initEmbeddedCheckout({
              clientSecret: this.sessionClientSecret
            });
            checkout?.mount("#stripe-subscription-element");

            // Note: Stripe embedded checkout doesn't have an 'on' method
            // Instead, it will redirect to the return_url when complete
            // The return_url has {CHECKOUT_SESSION_ID} placeholder which Stripe should replace
            // But if it doesn't, we'll retrieve the session ID from sessionStorage

            this.isStripeEmbedded = true;
            devLog.log("PAY DEBUG: [1.7] Embedded checkout mounted successfully");
            devLog.log("PAY DEBUG: [1.7.1] NOTE: When checkout completes, Stripe will redirect to return_url");
            devLog.log("PAY DEBUG: [1.7.2] Session ID stored in sessionStorage as fallback if return_url doesn't have it");
          } else {
            devLog.log("PAY DEBUG: [1.6] Embedded checkout already initialized");
          }

          // Show the dialog
          devLog.log("PAY DEBUG: [1.8] Opening Stripe checkout dialog");
          (this.$refs.stripeDialog as HTMLDialogElement)?.showModal();
          devLog.log("PAY DEBUG: [1.9] Stripe checkout dialog opened");
        } catch (error) {
          devLog.error("PAY DEBUG: [1.10] ERROR opening Stripe checkout:", error);
          alert("Failed to open checkout. Please try again.");
        }
      },
      async checkSubscriptionStatus(imei: string, phoneNumber?: string | null): Promise<boolean> {
        devLog.log("PAY DEBUG: [4] checkSubscriptionStatus called");
        devLog.log("PAY DEBUG: [4.1] IMEI:", imei);
        devLog.log("PAY DEBUG: [4.2] Phone number parameter:", phoneNumber);

        try {
          let devicePhoneNumber = phoneNumber || this.activeDevicePhoneNumber;
          devLog.log("PAY DEBUG: [4.3] Initial devicePhoneNumber:", devicePhoneNumber);

          // If no phone number provided, try to find it from device cards
          if (!devicePhoneNumber) {
            devLog.log("PAY DEBUG: [4.4] No phone number found, searching device cards");
            const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
            devLog.log("PAY DEBUG: [4.5] Found device cards:", deviceCards.length);

            for (const card of Array.from(deviceCards)) {
              const cardData = (window as any).Alpine?.$data?.(card);
              if (cardData && cardData.imei === imei) {
                devLog.log("PAY DEBUG: [4.6] Found matching device card for IMEI:", imei);
                const phoneElement = card.querySelector('p.text-gray-500');
                if (phoneElement) {
                  const phoneText = phoneElement.textContent || '';
                  const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
                  if (phoneMatch) {
                    devicePhoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
                    devLog.log("PAY DEBUG: [4.7] Extracted phone number from DOM:", devicePhoneNumber);
                    break;
                  }
                }
              }
            }
          }

          if (!devicePhoneNumber) {
            devLog.error("PAY DEBUG: [4.8] ERROR - Could not find phone number for device");
            return false;
          }

          const normalizedImei = imei.replace(/[^0-9]/g, '');
          devLog.log("PAY DEBUG: [4.9] Calling validateIsUserSubscribed with:");
          devLog.log("PAY DEBUG: [4.10]   - IMEI (normalized):", normalizedImei);
          devLog.log("PAY DEBUG: [4.11]   - Phone number:", devicePhoneNumber);

          // Call the subscription validation action
          const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
            imei: normalizedImei,
            phoneNumber: devicePhoneNumber
          });

          devLog.log("PAY DEBUG: [4.12] validateIsUserSubscribed result:", result);
          devLog.log("PAY DEBUG: [4.13] isSubscribed:", result?.isSubscribed);

          return result?.isSubscribed === true;
        } catch (error) {
          devLog.error("PAY DEBUG: [4.14] ERROR checking subscription status:", error);
          return false;
        }
      },
      async startSubscriptionPolling(imei: string, phoneNumber?: string | null) {
        devLog.log("PAY DEBUG: [5] startSubscriptionPolling called");
        devLog.log("PAY DEBUG: [5.1] IMEI:", imei);
        devLog.log("PAY DEBUG: [5.2] Phone number:", phoneNumber);
        devLog.log("PAY DEBUG: [5.3] Already polling?", this.pollingSubscription);

        if (this.pollingSubscription) {
          devLog.log("PAY DEBUG: [5.4] Already polling, returning");
          return; // Already polling
        }

        this.pollingSubscription = true;
        this.isLoading = true; // Show loading bar
        const maxAttempts = 20; // Poll for up to 60 seconds (20 * 3s)
        let attempts = 0;
        devLog.log("PAY DEBUG: [5.5] Starting polling with maxAttempts:", maxAttempts);

        const poll = async () => {
          attempts++;
          devLog.log(`PAY DEBUG: [5.6] Polling subscription status (attempt ${attempts}/${maxAttempts})...`);

          const isSubscribed = await this.checkSubscriptionStatus(imei, phoneNumber);
          devLog.log("PAY DEBUG: [5.7] Poll result - isSubscribed:", isSubscribed);

          if (isSubscribed) {
            devLog.log("PAY DEBUG: [5.8] Subscription detected! Redirecting to device info page...");
            devLog.log("PAY DEBUG: [5.8.1] REDIRECT TRIGGER: Polling path - subscription detected via polling");
            devLog.log("PAY DEBUG: [5.8.2] REDIRECT REASON: Subscription status check returned true");
            devLog.log("PAY DEBUG: [5.8.3] REDIRECT SOURCE: Dashboard polling mechanism");
            devLog.log("PAY DEBUG: [5.8.4] REDIRECT DATA - IMEI:", imei);
            devLog.log("PAY DEBUG: [5.8.5] REDIRECT DATA - Phone Number:", phoneNumber);
            this.stopSubscriptionPolling();

            // Normal redirect to device info page (deeplink auto-trigger only happens in manage/imei page)
            const imeiString = imei.replace(/[^0-9]/g, '').padEnd(15, '0');
            const redirectPath = `/manage/${imeiString}`;
            devLog.log("PAY DEBUG: [5.9] Redirecting to device info page:", redirectPath);
            devLog.log("PAY DEBUG: [5.9.1] REDIRECT TARGET:", redirectPath);
            devLog.log("PAY DEBUG: [5.9.2] REDIRECT FULL URL:", window.location.origin + redirectPath);
            devLog.log("PAY DEBUG: [5.9.3] REDIRECT EXECUTING NOW...");
            window.location.href = redirectPath;
            return;
          }

          if (attempts >= maxAttempts) {
            devLog.log("PAY DEBUG: [5.13] Polling timeout reached. Device will show 'Activate Plan' button.");
            this.stopSubscriptionPolling();
            // Keep loading bar visible during reload
            // Refresh page to show updated status
            devLog.log("PAY DEBUG: [5.14] Reloading page due to timeout");
            window.location.reload();
            return;
          }

          // Continue polling
          devLog.log("PAY DEBUG: [5.15] Scheduling next poll in 3 seconds");
          this.pollingInterval = setTimeout(poll, 3000);
        };

        // Start polling immediately (no delay for first check)
        devLog.log("PAY DEBUG: [5.16] Starting first poll immediately");
        poll();
      },
      stopSubscriptionPolling() {
        if (this.pollingInterval !== null) {
          clearTimeout(this.pollingInterval);
          this.pollingInterval = null;
        }
        this.pollingSubscription = false;
        // Don't set isLoading to false here - let it stay true during redirect/reload
      },
      handleRemoveDevice(event: Event) {
        const form = event.target as HTMLFormElement;
        if (!this.activeDeviceImei) {
          devLog.error("No device IMEI selected");
          return;
        }
        if (confirm('Are you sure you want to remove this device from your account? You can re-add it later by selecting "Add Device" on the Devices page.')) {
          // Convert IMEI string to number for the form
          const imeiInput = form.querySelector('input[name="imei"]') as HTMLInputElement;
          if (imeiInput) {
            const imeiNumber = parseInt(this.activeDeviceImei.replace(/[^0-9]/g, ''), 10);
            imeiInput.value = imeiNumber.toString();
          }
          form.submit();
        }
      },
      /**
       * Update device card subscription status
       */
      updateDeviceCardSubscription(imei: string, isSubscribed: boolean): void {
        const normalizedImei = imei.replace(/[^0-9]/g, '').padEnd(15, '0');

        // Find device card element
        const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
        for (const card of Array.from(deviceCards)) {
          const cardData = (window as any).Alpine?.$data?.(card);
          if (cardData && cardData.imei === normalizedImei) {
            cardData.isSubscribed = isSubscribed;
            break;
          }
        }
      },

      /**
       * Initialize background polling for unsubscribed devices
       */
      initializeBackgroundPolling(): void {
        // Wait for device cards to be initialized
        setTimeout(() => {
          const unsubscribedDevices: Device[] = [];

          // Find all unsubscribed device cards
          const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
          for (const card of Array.from(deviceCards)) {
            const cardData = (window as any).Alpine?.$data?.(card);
            if (cardData && !cardData.isSubscribed && cardData.phoneNumber) {
              unsubscribedDevices.push({
                imei: cardData.imei,
                phoneNumber: cardData.phoneNumber
              });
            }
          }

          if (unsubscribedDevices.length > 0) {
            // Initialize polling service if not already initialized
            if (!subscriptionPollingService) {
              subscriptionPollingService = new SubscriptionPollingService({
                pollInterval: 10000, // 10 seconds
                checkSubscription: async (imei: string, phoneNumber: string) => {
                  try {
                    const normalizedImei = imei.replace(/[^0-9]/g, '');
                    const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
                      imei: normalizedImei,
                      phoneNumber: phoneNumber
                    });
                    return result?.isSubscribed === true;
                  } catch (error) {
                    return false;
                  }
                },
                onSubscriptionDetected: (device) => {
                  // Update device card state
                  this.updateDeviceCardSubscription(device.imei, true);
                }
              });
            }

            // Start polling
            subscriptionPollingService.startPolling(unsubscribedDevices);

            // Listen for subscription detected events (from service)
            window.addEventListener('subscription-detected', ((event: CustomEvent) => {
              const { imei } = event.detail;
              this.updateDeviceCardSubscription(imei, true);
            }) as EventListener);
          }
        }, 500); // Wait 500ms for Alpine to fully initialize device cards
      },

      async init() {
        // Initialize Stripe
        await this.initializeStripe();

        // Initialize background polling for unsubscribed devices
        this.initializeBackgroundPolling();

        // Check if a new unsubscribed device was just added
        if (initialData?.newDevice?.imei) {
          devLog.log("New unsubscribed device detected, opening activate modal:", initialData.newDevice);
          // Wait a bit for Alpine to fully initialize
          await new Promise(resolve => setTimeout(resolve, 300));
          this.openActivateModal({
            imei: initialData.newDevice.imei,
            phoneNumber: initialData.newDevice.phoneNumber
          });

          // Add device to polling service
          if (subscriptionPollingService && initialData.newDevice.phoneNumber) {
            subscriptionPollingService.addDevice({
              imei: initialData.newDevice.imei,
              phoneNumber: initialData.newDevice.phoneNumber
            });
          }
          return;
        }

        // Handle activation redirect on component initialization
        devLog.log("PAY DEBUG: [2] Dashboard init() - checking for activation redirect");
        const urlParams = new URLSearchParams(window.location.search);
        let activated = urlParams.get('activated');
        let imei = urlParams.get('imei');
        let sessionId = urlParams.get('session_id');

        // If session_id is missing or is the placeholder, try to get it from sessionStorage
        if ((!sessionId || sessionId === '{CHECKOUT_SESSION_ID}') && activated === 'true') {
          devLog.log("PAY DEBUG: [2.0.1] session_id missing or is placeholder, checking sessionStorage");
          const storedSessionId = sessionStorage.getItem('stripeCheckoutSessionId');
          const storedImei = sessionStorage.getItem('stripeCheckoutImei');

          if (storedSessionId && storedImei) {
            devLog.log("PAY DEBUG: [2.0.2] Found session ID in sessionStorage:", storedSessionId);
            devLog.log("PAY DEBUG: [2.0.3] Found IMEI in sessionStorage:", storedImei);

            // Use stored values
            sessionId = storedSessionId;
            if (!imei) {
              imei = storedImei;
            }

            // Update URL with actual session_id
            const url = new URL(window.location.href);
            url.searchParams.set('session_id', sessionId);
            if (!url.searchParams.has('imei')) {
              url.searchParams.set('imei', storedImei);
            }
            window.history.replaceState({}, '', url.toString());
            devLog.log("PAY DEBUG: [2.0.4] Updated URL with session_id from sessionStorage");
            devLog.log("PAY DEBUG: [2.0.5] Keeping sessionStorage for manage page fallback - will be cleared after validation");
          } else {
            devLog.log("PAY DEBUG: [2.0.5] No session ID found in sessionStorage either");
          }
        }

        devLog.log("PAY DEBUG: [2.1] URL params - activated:", activated, "imei:", imei, "session_id:", sessionId);

        if (activated === 'true' && imei) {
          devLog.log("PAY DEBUG: [2.2] Activation detected, showing loading bar");
          // Show loading bar immediately
          this.isLoading = true;

          // If we have a session_id, validate the Stripe subscription first
          if (sessionId) {
            devLog.log("PAY DEBUG: [2.3] session_id found, validating subscription");
            try {
              const imeiString = imei.replace(/[^0-9]/g, '').padEnd(15, '0');
              devLog.log("PAY DEBUG: [2.4] Calling validateSubscription with:");
              devLog.log("PAY DEBUG: [2.5]   - sessionId:", sessionId);
              devLog.log("PAY DEBUG: [2.6]   - imei (normalized):", imeiString);

              const validationResult = await actions.stripe.validateSubscription.orThrow({
                sessionId: sessionId,
                imei: imeiString
              });

              devLog.log("PAY DEBUG: [2.7] validateSubscription result:", validationResult);
              devLog.log("PAY DEBUG: [2.8] isSubscribed:", validationResult?.isSubscribed);

              if (validationResult?.isSubscribed) {
                devLog.log("PAY DEBUG: [2.9] Subscription validated successfully, redirecting to device page");
                devLog.log("PAY DEBUG: [2.9.0] REDIRECT TRIGGER: Direct validation path - session_id validation succeeded");
                devLog.log("PAY DEBUG: [2.9.0.1] REDIRECT REASON: Stripe subscription validation returned isSubscribed=true");
                devLog.log("PAY DEBUG: [2.9.0.2] REDIRECT SOURCE: Dashboard init() - All-in-One Plan activation");
                devLog.log("PAY DEBUG: [2.9.0.3] REDIRECT DATA - IMEI:", imeiString);
                devLog.log("PAY DEBUG: [2.9.0.4] REDIRECT DATA - Session ID:", sessionId);
                // Subscription is valid, redirect to device info page with session_id and validated flag
                // Don't clear sessionStorage here - let manage page clear it after validation
                const redirectUrl = new URL(`/manage/${imeiString}`, window.location.origin);
                redirectUrl.searchParams.set('session_id', sessionId);
                redirectUrl.searchParams.set('validated', 'true');
                devLog.log("PAY DEBUG: [2.9.1] Redirecting with session_id and validated flag:", redirectUrl.toString());
                devLog.log("PAY DEBUG: [2.9.1.1] REDIRECT TARGET:", redirectUrl.toString());
                devLog.log("PAY DEBUG: [2.9.1.2] REDIRECT URL PARAMS:", Object.fromEntries(redirectUrl.searchParams.entries()));
                devLog.log("PAY DEBUG: [2.9.1.3] REDIRECT EXECUTING NOW...");
                window.location.href = redirectUrl.toString();
                return;
              } else {
                devLog.log("PAY DEBUG: [2.10] Subscription validation returned false, will start polling");
              }
            } catch (error) {
              devLog.error("PAY DEBUG: [2.11] ERROR validating Stripe session:", error);
              // Continue with polling if validation fails
            }
          } else {
            devLog.log("PAY DEBUG: [2.3] No session_id in URL, skipping validation, will start polling");
          }

          // Clean up URL parameters
          devLog.log("PAY DEBUG: [3] Cleaning up URL parameters");
          const cleanUrl = new URL(window.location.href);
          cleanUrl.searchParams.delete('activated');
          cleanUrl.searchParams.delete('imei');
          cleanUrl.searchParams.delete('session_id');
          window.history.replaceState({}, '', cleanUrl.toString());
          devLog.log("PAY DEBUG: [3.1] URL cleaned, new URL:", cleanUrl.toString());

          this.pollingImei = imei;
          devLog.log("PAY DEBUG: [3.2] Set pollingImei to:", imei);

          // Try to get phone number from sessionStorage or device data
          const storedImei = sessionStorage.getItem('activatingDeviceImei');
          let phoneNumber = null;
          devLog.log("PAY DEBUG: [3.3] Stored IMEI from sessionStorage:", storedImei);

          // Wait a bit for Alpine to initialize all device cards
          devLog.log("PAY DEBUG: [3.4] Waiting 100ms for Alpine to initialize");
          await new Promise(resolve => setTimeout(resolve, 100));

          // Try to find phone number from device cards
          devLog.log("PAY DEBUG: [3.5] Searching for phone number in device cards");
          const deviceCards = document.querySelectorAll('[x-data*="deviceCard"]');
          devLog.log("PAY DEBUG: [3.6] Found device cards:", deviceCards.length);

          for (const card of Array.from(deviceCards)) {
            const cardData = (window as any).Alpine?.$data?.(card);
            if (cardData && cardData.imei === imei) {
              devLog.log("PAY DEBUG: [3.7] Found matching device card");
              // Use phoneNumber from card data if available
              if (cardData.phoneNumber) {
                phoneNumber = cardData.phoneNumber;
                devLog.log("PAY DEBUG: [3.8] Found phone number from card data:", phoneNumber);
                break;
              }
              // Fallback: try to extract from DOM
              const phoneElement = card.querySelector('p.text-gray-500');
              if (phoneElement) {
                const phoneText = phoneElement.textContent || '';
                const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
                if (phoneMatch) {
                  phoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
                  devLog.log("PAY DEBUG: [3.9] Extracted phone number from DOM:", phoneNumber);
                  break;
                }
              }
            }
          }

          // Clean up sessionStorage
          if (storedImei) {
            devLog.log("PAY DEBUG: [3.10] Cleaning up sessionStorage");
            sessionStorage.removeItem('activatingDeviceImei');
            sessionStorage.removeItem('activationType');
          }

          // Start polling - loading bar will stay visible until redirect/reload
          devLog.log("PAY DEBUG: [3.11] Starting subscription polling with IMEI:", imei, "Phone:", phoneNumber);
          await this.startSubscriptionPolling(imei, phoneNumber);
        }
      }
    }));

    Alpine.data("deviceCard", (deviceData: { imei: string; isSubscribed: boolean; phoneNumber?: string }) => ({
      imei: deviceData.imei,
      isSubscribed: deviceData.isSubscribed,
      phoneNumber: deviceData.phoneNumber || '',
      init() {
        devLog.log("Device card initialized:", { imei: this.imei, isSubscribed: this.isSubscribed, phoneNumber: this.phoneNumber });

        // Update subscription status if it changed
        this.$watch('isSubscribed', (value) => {
          if (value) {
            devLog.log(`Device ${this.imei} is now subscribed`);
            // Remove from polling service if it exists
            if (subscriptionPollingService) {
              subscriptionPollingService.removeDevice(this.imei);
            }
          }
        });

        // Listen for subscription detected events
        const handleSubscriptionDetected = ((event: CustomEvent) => {
          if (event.detail.imei === this.imei) {
            this.isSubscribed = true;
          }
        }) as EventListener;

        window.addEventListener('subscription-detected', handleSubscriptionDetected);

        // Cleanup listener on component destroy
        this.$el.addEventListener('alpine:destroyed', () => {
          window.removeEventListener('subscription-detected', handleSubscriptionDetected);
        });
      },
      openActivateModal() {
        devLog.log("Device card openActivateModal called for IMEI:", this.imei, "isSubscribed:", this.isSubscribed);
        // Try to find the dashboard component
        const dashboardEl = document.querySelector('[x-data="dashboard"]');
        if (dashboardEl) {
          // Use Alpine's $data to get the dashboard component data
          const dashboardData = (window as any).Alpine?.$data?.(dashboardEl);
          if (dashboardData && typeof dashboardData.openActivateModal === 'function') {
            devLog.log("Found dashboard, calling openActivateModal");
            dashboardData.openActivateModal({ imei: this.imei, phoneNumber: this.phoneNumber });
            return;
          }
        }
        // Fallback: dispatch event
        devLog.log("Dispatching activate-modal event");
        (this as any).$dispatch('activate-modal', { imei: this.imei, phoneNumber: this.phoneNumber });
      },
      async checkSubscriptionStatus() {
        // This can be called after user returns from activation
        try {
          // Get phone number from device card
          const phoneElement = this.$el.querySelector('p.text-gray-500');
          let phoneNumber = '';
          if (phoneElement) {
            const phoneText = phoneElement.textContent || '';
            const phoneMatch = phoneText.match(/(\d{3})[-\s]?(\d{3})[-\s]?(\d{4})/);
            if (phoneMatch) {
              phoneNumber = `${phoneMatch[1]}-${phoneMatch[2]}-${phoneMatch[3]}`;
            }
          }

          if (!phoneNumber) {
            devLog.error("Could not find phone number");
            window.location.reload();
            return;
          }

          const result = await actions.wisephones.validateIsUserSubscribed.orThrow({
            imei: this.imei.replace(/[^0-9]/g, ''),
            phoneNumber: phoneNumber
          });

          if (result?.isSubscribed === true) {
            this.isSubscribed = true;

            // Normal redirect to device info page (deeplink auto-trigger only happens in manage/imei page)
            devLog.log("PAY DEBUG: [D1] Subscription confirmed, redirecting to manage page");
            devLog.log("PAY DEBUG: [D1.1] REDIRECT TRIGGER: Device card checkSubscriptionStatus - subscription confirmed");
            devLog.log("PAY DEBUG: [D1.2] REDIRECT REASON: validateIsUserSubscribed returned isSubscribed=true");
            devLog.log("PAY DEBUG: [D1.3] REDIRECT SOURCE: Dashboard device card subscription check");
            devLog.log("PAY DEBUG: [D1.4] REDIRECT DATA - IMEI:", this.imei);
            const redirectPath = `/manage/${this.imei}`;
            devLog.log("PAY DEBUG: [D1.5] REDIRECT TARGET:", redirectPath);
            devLog.log("PAY DEBUG: [D1.6] REDIRECT FULL URL:", window.location.origin + redirectPath);
            devLog.log("PAY DEBUG: [D1.7] REDIRECT EXECUTING NOW...");
            window.location.href = redirectPath;
          } else {
            // Refresh to show updated status
            window.location.reload();
          }
        } catch (error) {
          devLog.error("Error checking subscription:", error);
          window.location.reload();
        }
      }
    }));

    // Cleanup polling service on page unload
    window.addEventListener('beforeunload', () => {
      if (subscriptionPollingService) {
        subscriptionPollingService.destroy();
        subscriptionPollingService = null;
      }
    });

    // Also cleanup on page hide (when navigating away)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && subscriptionPollingService) {
        // Service will pause automatically via Page Visibility API
        // But we can also manually pause if needed
        subscriptionPollingService.pausePolling();
      }
    });
  });
</script>
</Layout>
