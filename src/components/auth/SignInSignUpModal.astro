---
/**
 * Custom Sign In / Sign Up modal component.
 * UI is fully custom; auth and API calls use Clerk via the client script.
 *
 * Usage: Wrap in a container that controls open state, e.g.:
 *   <div x-data="{ authModalOpen: false }">
 *     <button @click="authModalOpen = true">Sign in</button>
 *     <SignInSignUpModal openBinding="authModalOpen" redirectUrl="/dashboard" />
 *   </div>
 *
 * Open from outside: document.getElementById('auth-modal')?.showModal()
 */
interface Props {
  /** Redirect URL after successful sign in or sign up. Default: /dashboard */
  redirectUrl?: string;
  /** Publishable key for Clerk (client). Pass from server so the script can load Clerk. */
  publishableKey: string;
  /** URL for Terms of Service (linked from sign-up checkbox). */
  termsUrl?: string;
  /** URL for Privacy Policy (linked from sign-up checkbox). */
  privacyUrl?: string;
}

const { redirectUrl = "/dashboard", publishableKey, termsUrl = "https://wisephone.com/policies/terms-of-service", privacyUrl = "https://wisephone.com/policies/privacy-policy" } = Astro.props;
const isProd = import.meta.env.PROD;

// Mirrors the Clerk dashboard's allowed phone-number countries.
// Keep in sync with the Clerk dashboard config if that list changes.
interface PhoneCountry {
  name: string;
  code: string;
}
const PHONE_COUNTRIES: PhoneCountry[] = [
  { name: "Albania", code: "+355" },
  { name: "Angola", code: "+244" },
  { name: "Antigua & Barbuda", code: "+1" },
  { name: "Argentina", code: "+54" },
  { name: "Australia", code: "+61" },
  { name: "Austria", code: "+43" },
  { name: "Bahamas", code: "+1" },
  { name: "Bahrain", code: "+973" },
  { name: "Bosnia & Herzegovina", code: "+387" },
  { name: "Botswana", code: "+267" },
  { name: "Brazil", code: "+55" },
  { name: "Brunei", code: "+673" },
  { name: "Canada", code: "+1" },
  { name: "Chile", code: "+56" },
  { name: "China", code: "+86" },
  { name: "Colombia", code: "+57" },
  { name: "Costa Rica", code: "+506" },
  { name: "Croatia", code: "+385" },
  { name: "Cuba", code: "+53" },
  { name: "Cyprus", code: "+357" },
  { name: "Czechia", code: "+420" },
  { name: "Denmark", code: "+45" },
  { name: "Dominican Republic", code: "+1" },
  { name: "El Salvador", code: "+503" },
  { name: "Estonia", code: "+372" },
  { name: "Eswatini", code: "+268" },
  { name: "Faroe Islands", code: "+298" },
  { name: "Finland", code: "+358" },
  { name: "France", code: "+33" },
  { name: "Germany", code: "+49" },
  { name: "Greece", code: "+30" },
  { name: "Greenland", code: "+299" },
  { name: "Guam", code: "+1" },
  { name: "Guernsey", code: "+44" },
  { name: "Honduras", code: "+504" },
  { name: "Hong Kong", code: "+852" },
  { name: "Hungary", code: "+36" },
  { name: "Iceland", code: "+354" },
  { name: "India", code: "+91" },
  { name: "Ireland", code: "+353" },
  { name: "Isle of Man", code: "+44" },
  { name: "Italy", code: "+39" },
  { name: "Japan", code: "+81" },
  { name: "Jersey", code: "+44" },
  { name: "Laos", code: "+856" },
  { name: "Latvia", code: "+371" },
  { name: "Liberia", code: "+231" },
  { name: "Liechtenstein", code: "+423" },
  { name: "Lithuania", code: "+370" },
  { name: "Luxembourg", code: "+352" },
  { name: "Macao", code: "+853" },
  { name: "Malaysia", code: "+60" },
  { name: "Maldives", code: "+960" },
  { name: "Malta", code: "+356" },
  { name: "Micronesia", code: "+691" },
  { name: "Moldova", code: "+373" },
  { name: "Montenegro", code: "+382" },
  { name: "Namibia", code: "+264" },
  { name: "Netherlands", code: "+31" },
  { name: "Nicaragua", code: "+505" },
  { name: "Norfolk Island", code: "+672" },
  { name: "North Macedonia", code: "+389" },
  { name: "Norway", code: "+47" },
  { name: "Palau", code: "+680" },
  { name: "Paraguay", code: "+595" },
  { name: "Peru", code: "+51" },
  { name: "Poland", code: "+48" },
  { name: "Portugal", code: "+351" },
  { name: "Puerto Rico", code: "+1" },
  { name: "Qatar", code: "+974" },
  { name: "Romania", code: "+40" },
  { name: "Saudi Arabia", code: "+966" },
  { name: "Seychelles", code: "+248" },
  { name: "Singapore", code: "+65" },
  { name: "Slovakia", code: "+421" },
  { name: "Solomon Islands", code: "+677" },
  { name: "South Africa", code: "+27" },
  { name: "South Korea", code: "+82" },
  { name: "Spain", code: "+34" },
  { name: "Sweden", code: "+46" },
  { name: "Switzerland", code: "+41" },
  { name: "Taiwan", code: "+886" },
  { name: "Thailand", code: "+66" },
  { name: "Türkiye", code: "+90" },
  { name: "Turks & Caicos Islands", code: "+1" },
  { name: "United Kingdom", code: "+44" },
  { name: "Uruguay", code: "+598" },
  { name: "U.S. Virgin Islands", code: "+1" },
  { name: "Venezuela", code: "+58" },
  // Listed last so it matches (and is shown selected for) the default `phoneCountryCode` ("+1")
  // when the modal opens — the select shows the last option matching the bound value.
  { name: "United States", code: "+1" }
];
---

<dialog
  id="auth-modal"
  class="modal items-start md:items-center overflow-x-hidden"
  x-data={`authModal({
    redirectUrl: ${JSON.stringify(redirectUrl)},
    publishableKey: ${JSON.stringify(publishableKey)},
    isProd: ${JSON.stringify(isProd)}
  })`}
  x-init="init()"
>
  <div class="modal-box max-w-md w-[calc(100%-2rem)] mx-4 mt-10 md:mt-0 relative overflow-x-hidden">

<form method="dialog" class="absolute right-4 top-4">
      <button type="submit" class="btn btn-ghost btn-sm btn-circle" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </form>

    <h3 class="text-lg font-bold mb-2 pr-8" x-text="tab === 'signin' ? (signInCodeStep ? 'Verify your identity' : 'Sign in to Wisephone Portal') : (signUpPhoneStep ? 'Verify your phone' : 'Create your account')"></h3>
    <p class="text-sm text-[var(--text-secondary)] mb-4" x-show="tab === 'signin' && !signInCodeStep" x-cloak>Welcome back! Please sign in to continue.</p>
    <p class="text-sm text-[var(--text-secondary)] mb-2" x-show="tab === 'signup' && !signUpPhoneStep" x-cloak>Welcome! Please fill in the details to get started.</p>
    <p class="text-sm text-[var(--text-secondary)] mb-4" x-show="tab === 'signup' && signUpPhoneStep" x-cloak>We sent a verification code to your phone number. Enter it below.</p>


    <!-- Sign In: Step 1 – Email or Phone -->
    <form
      x-show="tab === 'signin' && !signInCodeStep"
      x-cloak
      class="space-y-2"
      @submit.prevent="handleSignInContinue()"
    >
      <div class="flex gap-4 mb-1">
        <button type="button" class="pb-1 text-sm font-medium transition-colors" :class="signInMethod === 'phone' ? 'text-[var(--primary)] border-b-2 border-[var(--primary)]' : 'text-gray-500 hover:text-gray-700'" @click="signInMethod = 'phone'">Phone number</button>
        <button type="button" class="pb-1 text-sm font-medium transition-colors" :class="signInMethod === 'email' ? 'text-[var(--primary)] border-b-2 border-[var(--primary)]' : 'text-gray-500 hover:text-gray-700'" @click="signInMethod = 'email'">Email address</button>
      </div>
      <div class="form-control" x-show="signInMethod === 'email'">
        <label class="label py-1" for="auth-email-signin"><span class="label-text">Email address</span></label>
        <input
          id="auth-email-signin"
          type="email"
          class="input input-bordered input-sm w-full h-10"
          placeholder="Enter your email address"
          x-model="email"
          autocomplete="email"
        />
      </div>
      <div class="form-control" x-show="signInMethod === 'phone'" x-cloak>
        <label class="label py-1" for="auth-phone-signin"><span class="label-text">Phone number</span></label>
        <div class="flex gap-2">
          <select class="select select-bordered select-sm w-36 sm:w-44 shrink-0 h-10 truncate" x-model="phoneCountryCode" aria-label="Country code">
            {PHONE_COUNTRIES.map((c) => (
              <option value={c.code}>{c.name} {c.code}</option>
            ))}
          </select>
          <input
            id="auth-phone-signin"
            type="tel"
            inputmode="numeric"
            class="input input-bordered input-sm flex-1 min-w-0 h-10"
            placeholder="Enter your phone number"
            x-model="phoneNumber"
            @keydown="if(!/[0-9]/.test($event.key) && !['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes($event.key) && !$event.metaKey && !$event.ctrlKey) $event.preventDefault()"
            autocomplete="tel"
          />
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-full" :disabled="loading" x-bind:disabled="loading">
        <span x-show="!loading">Continue</span>
        <span x-show="loading" x-cloak>Sending code…</span>
      </button>
      <p class="text-sm text-center text-[var(--text-secondary)]">Don't have an account? <button type="button" class="link link-primary font-semibold" @click="tab = 'signup'; errorMessage = ''; email = ''; phoneNumber = ''">Sign up</button></p>
    </form>

    <!-- Sign In: Step 2 – Verification code -->
    <form
      x-show="tab === 'signin' && signInCodeStep"
      x-cloak
      class="space-y-2"
      @submit.prevent="handleSignInVerify()"
    >
      <div class="form-control">
        <label class="label py-1"><span class="label-text">Verification code</span></label>
        <input
          type="text"
          class="input input-bordered input-sm w-full h-10"
          placeholder="Enter the code we sent"
          x-model="verificationCode"
          autocomplete="one-time-code"
        />
      </div>
      <button type="submit" class="btn btn-primary w-full" :disabled="loading" x-bind:disabled="loading">
        <span x-show="!loading">Verify</span>
        <span x-show="loading" x-cloak>Verifying…</span>
      </button>
      <button type="button" class="btn btn-ghost btn-sm w-full" @click="signInCodeStep = false; errorMessage = ''">Use a different email or phone</button>
    </form>

    <!-- Sign Up: Step 2 – Phone verification code -->
    <form
      x-show="tab === 'signup' && signUpPhoneStep"
      x-cloak
      class="space-y-2"
      @submit.prevent="handleSignUpPhoneVerify()"
    >
      <div class="form-control">
        <label class="label py-1"><span class="label-text">Phone verification code</span></label>
        <input
          type="text"
          class="input input-bordered input-sm w-full h-10"
          placeholder="Enter the code we sent to your phone"
          x-model="phoneVerificationCode"
          autocomplete="one-time-code"
        />
      </div>
      <button type="submit" class="btn btn-primary w-full" :disabled="loading" x-bind:disabled="loading">
        <span x-show="!loading">Verify phone</span>
        <span x-show="loading" x-cloak>Verifying…</span>
      </button>
      <button type="button" class="btn btn-ghost btn-sm w-full" @click="signUpPhoneStep = false; errorMessage = ''">Use a different number</button>
    </form>

    <!-- Sign Up: Step 1 – Create account form -->
    <form
      x-show="tab === 'signup' && !signUpPhoneStep"
      x-cloak
      class="space-y-2"
      @submit.prevent="handleSignUp()"
    >
      <div class="flex gap-3">
        <div class="form-control flex-1">
          <label class="label py-1" for="auth-firstname"><span class="label-text">First name <span class="text-[var(--text-secondary)] font-normal">(optional)</span></span></label>
          <input id="auth-firstname" type="text" class="input input-bordered input-sm w-full h-10" placeholder="First name" x-model="firstName" autocomplete="given-name" />
        </div>
        <div class="form-control flex-1">
          <label class="label py-1" for="auth-lastname"><span class="label-text">Last name <span class="text-[var(--text-secondary)] font-normal">(optional)</span></span></label>
          <input id="auth-lastname" type="text" class="input input-bordered input-sm w-full h-10" placeholder="Last name" x-model="lastName" autocomplete="family-name" />
        </div>
      </div>
      <div class="form-control">
        <label class="label py-1" for="auth-email-signup"><span class="label-text">Email address</span></label>
        <input
          id="auth-email-signup"
          type="email"
          class="input input-bordered input-sm w-full h-10"
          placeholder="Enter your email address"
          x-model="email"
          required
          autocomplete="email"
        />
      </div>
      <div class="form-control">
        <label class="label py-1" for="auth-phone-signup"><span class="label-text">Phone number</span></label>
        <div class="flex gap-2">
          <select class="select select-bordered select-sm w-36 sm:w-44 shrink-0 h-10 truncate" x-model="phoneCountryCode" aria-label="Country code">
            {PHONE_COUNTRIES.map((c) => (
              <option value={c.code}>{c.name} {c.code}</option>
            ))}
          </select>
          <input
            id="auth-phone-signup"
            type="tel"
            inputmode="numeric"
            class="input input-bordered input-sm flex-1 min-w-0 h-10"
            placeholder="Enter your phone number"
            x-model="phoneNumber"
            @keydown="if(!/[0-9]/.test($event.key) && !['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes($event.key) && !$event.metaKey && !$event.ctrlKey) $event.preventDefault()"
            required
            autocomplete="tel"
          />
        </div>
      </div>

      <!-- Clerk bot protection: required for custom sign-up when Attack Protection is enabled (https://clerk.com/docs/custom-flows/bot-sign-up-protection) -->
      <div id="clerk-captcha" data-cl-theme="light" data-cl-size="normal" class="my-1" aria-hidden="false"></div>
      <div class="flex items-center justify-between gap-2 mt-2">
        <label class="flex items-center gap-2 cursor-pointer min-w-0">
          <input type="checkbox" class="checkbox checkbox-primary checkbox-sm border-2 border-[var(--surface-tertiary)] shrink-0" x-model="termsAgreed" />
          <span class="text-xs leading-tight">I agree to the <a href={termsUrl} target="_blank" rel="noopener noreferrer" class="link link-primary underline">Terms</a> and <a href={privacyUrl} target="_blank" rel="noopener noreferrer" class="link link-primary underline">Privacy Policy</a>.</span>
        </label>
        <button
          type="submit"
          class="btn btn-primary btn-sm px-2 shrink-0 ml-auto"
          :disabled="loading"
          x-bind:disabled="loading || !termsAgreed"
        >
          <span x-show="!loading">Sign up</span>
          <span x-show="loading" x-cloak>Creating…</span>
        </button>
      </div>
      <p class="text-sm text-center text-[var(--text-secondary)]">Already have an account? <button type="button" class="link link-primary font-semibold" @click="tab = 'signin'; signInCodeStep = false; errorMessage = ''; email = ''; phoneNumber = ''">Sign in</button></p>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop bg-black/50">
    <button type="submit">close</button>
  </form>
</dialog>

<script>
  // @ts-nocheck - Alpine/Clerk are runtime globals; @clerk/clerk-js is dynamically imported
  import { devLog } from "@/libs/utils";
  document.addEventListener("alpine:init", () => {
    const Alpine = window.Alpine;
    Alpine.data("authModal", (config) => ({
      redirectUrl: config?.redirectUrl ?? "/dashboard",
      publishableKey: config?.publishableKey ?? "",
      isProd: config?.isProd ?? false,
      tab: "signin",
      email: "",
      password: "",
      firstName: "",
      lastName: "",
      phoneCountryCode: "+1",
      phoneNumber: "",
      termsAgreed: false,
      signInMethod: "phone",
      signInCodeStep: false,
      signUpPhoneStep: false,
      verificationCode: "",
      phoneVerificationCode: "",
      loading: false,
      errorMessage: "",
      clerk: null,

      resetForm() {
        this.email = "";
        this.firstName = "";
        this.lastName = "";
        this.phoneNumber = "";
        this.phoneCountryCode = "+1";
        this.termsAgreed = false;
        this.signInMethod = "phone";
        this.signInCodeStep = false;
        this.signUpPhoneStep = false;
        this.verificationCode = "";
        this.phoneVerificationCode = "";
        this.loading = false;
      },

      async init() {
        devLog.log("[AuthModal] init() started");
        const dialog = this.$el;

        // Reset all form data whenever the modal is closed
        dialog.addEventListener("close", () => {
          this.resetForm();
        });

        window.addEventListener("auth-modal-open", (e) => {
          this.tab = e.detail?.tab ?? "signin";
          this.errorMessage = "";
          this.signInCodeStep = false;
            this.signUpPhoneStep = false;
          if (dialog && typeof dialog.showModal === "function") dialog.showModal();
          devLog.log("[AuthModal] modal opened, tab:", this.tab, "clerk ready:", !!this.clerk);
        });

        try {
          // Use the Clerk instance already initialized by @clerk/astro to avoid
          // dual-instance state conflicts (which corrupt signUp between OTP send/verify).
          devLog.log("[AuthModal] Waiting for window.Clerk from @clerk/astro...");
          await new Promise((resolve, reject) => {
            const timeout = setTimeout(() => reject(new Error("Clerk load timeout")), 10000);
            const check = () => {
              if (window.Clerk?.client) {
                clearTimeout(timeout);
                resolve();
              } else {
                setTimeout(check, 50);
              }
            };
            check();
          });
          this.clerk = window.Clerk;
          devLog.log("[AuthModal] Clerk ready. client:", !!this.clerk?.client, "signIn:", typeof this.clerk?.client?.signIn, "signUp:", typeof this.clerk?.client?.signUp);
        } catch (e) {
          devLog.error("[AuthModal] Clerk load failed:", e);
          this.setError("Unable to load sign-in. Please refresh the page.");
        }
      },

      setError(msg) {
        this.loading = false;
        const message = msg || "Something went wrong. Please try again.";
        window.dispatchEvent(new CustomEvent("auth-modal-error", { detail: { message } }));
      },

      getSignInIdentifier() {
        if (this.signInMethod === "phone") {
          const digits = (this.phoneNumber || "").replace(/\D/g, "");
          return this.phoneCountryCode + digits;
        }
        return this.email;
      },

      async handleSignInContinue() {
        const clerk = this.clerk;
        const signIn = clerk?.client?.signIn;
        if (!signIn) {
          this.setError("Sign-in is not ready. Please refresh.");
          return;
        }
        const identifier = this.getSignInIdentifier();
        if (!identifier || (this.signInMethod === "phone" && !this.phoneNumber)) {
          this.setError(this.signInMethod === "email" ? "Enter your email address." : "Enter your phone number.");
          return;
        }
        this.loading = true;
        this.errorMessage = "";
        try {
          await signIn.create({ identifier });
          const strategy = this.signInMethod === "email" ? "email_code" : "phone_code";
          const factor = signIn.supportedFirstFactors?.find((f) => f.strategy === strategy);
          if (!factor) {
            this.setError("This sign-in method is not available for this account.");
            this.loading = false;
            return;
          }
          const prepareParams = { strategy };
          if (strategy === "email_code" && factor.emailAddressId) prepareParams.emailAddressId = factor.emailAddressId;
          if (strategy === "phone_code" && factor.phoneNumberId) prepareParams.phoneNumberId = factor.phoneNumberId;
          await signIn.prepareFirstFactor(prepareParams);
          this.signInCodeStep = true;
          this.verificationCode = "";
          this.loading = false;
        } catch (e) {
          const err = (e && typeof e === "object" && "errors" in e && Array.isArray((e).errors) ? (e).errors[0] : e);
          const rawMessage = err?.longMessage ?? err?.message ?? "";
          const isInvalidIdentifier = rawMessage.toLowerCase().includes("identifier is invalid");
          const friendlyMessage = isInvalidIdentifier
            ? (this.signInMethod === "phone" ? "Phone number is invalid." : "Email is invalid.")
            : rawMessage || "Could not send verification code.";
          this.setError(friendlyMessage);
        }
      },

      async handleSignInVerify() {
        const clerk = this.clerk;
        const signIn = clerk?.client?.signIn;
        if (!signIn || !this.verificationCode) {
          this.setError("Enter the verification code.");
          return;
        }
        this.loading = true;
        this.errorMessage = "";
        try {
          const strategy = this.signInMethod === "email" ? "email_code" : "phone_code";
          const result = await signIn.attemptFirstFactor({ strategy, code: this.verificationCode });
          if (result.status === "complete") {
            const sessionId = result.createdSessionId ?? signIn.createdSessionId;
            if (sessionId && clerk.setActive) await clerk.setActive({ session: sessionId });
            window.location.href = this.redirectUrl;
            return;
          }
          const err = result?.firstFactorVerification?.error ?? result?.error;
          this.setError(err?.longMessage ?? err?.message ?? "Verification failed.");
        } catch (e) {
          const err = (e && typeof e === "object" && "errors" in e && Array.isArray((e).errors) ? (e).errors[0] : e);
          this.setError(err?.longMessage ?? err?.message ?? "Verification failed.");
        }
      },

      async handleSignUp() {
        if (!this.termsAgreed) {
          this.setError("You must agree to the Terms of Service and Privacy Policy to sign up.");
          return;
        }
        const clerk = this.clerk;
        const signUp = clerk?.client?.signUp;
        if (!signUp) {
          this.setError("Sign-up is not ready. Please refresh.");
          return;
        }
        this.loading = true;
        this.errorMessage = "";
        try {
          const payload = { emailAddress: this.email, legalAccepted: true };
          if (this.firstName) payload.firstName = this.firstName;
          if (this.lastName) payload.lastName = this.lastName;
          const phone = this.phoneNumber ? this.phoneCountryCode + this.phoneNumber.replace(/\D/g, "") : null;
          if (phone) payload.phoneNumber = phone;
          await signUp.create(payload);
          if (signUp.status === "complete" && signUp.createdSessionId && clerk.setActive) {
            await clerk.setActive({ session: signUp.createdSessionId });
            window.location.href = this.redirectUrl;
            return;
          }
          // Always verify via phone OTP only — no email verification step
          await signUp.preparePhoneNumberVerification({ strategy: "phone_code" });
          this.phoneVerificationCode = "";
          this.signUpPhoneStep = true;
          this.errorMessage = "";
          this.loading = false;
        } catch (e) {
          const err = (e && typeof e === "object" && "errors" in e && Array.isArray((e).errors) ? (e).errors[0] : e);
          const rawMessage = err?.longMessage ?? err?.message ?? "";
          const friendlyMessage = rawMessage.toLowerCase().includes("valid email") || rawMessage.toLowerCase().includes("email address must")
            ? "Email is invalid."
            : rawMessage.toLowerCase().includes("valid phone") || rawMessage.toLowerCase().includes("phone number must")
            ? "Phone number is invalid."
            : rawMessage || "Sign-up failed.";
          this.setError(friendlyMessage);
        }
      },

      async handleSignUpPhoneVerify() {
        const clerk = this.clerk;
        const signUp = clerk?.client?.signUp;
        if (!signUp || !this.phoneVerificationCode?.trim()) {
          this.setError("Enter the verification code from your phone.");
          return;
        }
        this.loading = true;
        this.errorMessage = "";
        try {
          await signUp.attemptPhoneNumberVerification({ code: this.phoneVerificationCode.trim() });
          devLog.log("[AuthModal] signUp after phone verify — status:", signUp.status, "missingFields:", signUp.missingFields, "unverifiedFields:", signUp.unverifiedFields);
          if (signUp.status === "complete" && signUp.createdSessionId && clerk?.setActive) {
            await clerk.setActive({ session: signUp.createdSessionId });
            window.location.href = this.redirectUrl;
            return;
          }
          if (signUp.status === "missing_requirements") {
            const missing = signUp.missingFields ?? [];
            const unverified = signUp.unverifiedFields ?? [];
            devLog.error("[AuthModal] missing_requirements — missingFields:", missing, "unverifiedFields:", unverified);
            if (missing.length === 1 && missing[0] === "legal_accepted") {
              await signUp.update({ legalAccepted: true });
              if (signUp.status === "complete" && signUp.createdSessionId && clerk?.setActive) {
                await clerk.setActive({ session: signUp.createdSessionId });
                window.location.href = this.redirectUrl;
                return;
              }
            }
            this.setError(`Sign-up incomplete. Missing: ${[...missing, ...unverified].join(", ") || "unknown requirement"}. Check browser console for details.`);
            return;
          }
          const err = signUp?.verifications?.phoneNumber?.error;
          this.setError(err?.longMessage ?? err?.message ?? "Phone verification failed. Check the code and try again.");
        } catch (e) {
          const err = (e && typeof e === "object" && "errors" in e && Array.isArray((e).errors) ? (e).errors[0] : e);
          this.setError(err?.longMessage ?? err?.message ?? "Phone verification failed.");
        } finally {
          this.loading = false;
        }
      }
    }));
  });
</script>
