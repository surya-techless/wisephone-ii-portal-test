---
// src/components/ScreenTimeStats.astro
interface Props {
  imei: string;
  screenTimeData?: Array<{
    id: number;
    imei: string;
    weekStartDate: Date | string;
    weekEndDate: Date | string;
    totalScreenTimeMs: number;
    dailyAverageMs: number;
    syncedAt: Date | string;
    deviceName?: string | null;
    deviceManufacturer?: string | null;
    apps: Array<{
      id: number;
      screenTimeId: number;
      imei: string;
      packageName: string;
      appName: string;
      totalTimeMs: number;
      dailyAverageMs: number;
      weekStartDate: Date | string;
      iconUrl?: string | null; // from the App table, when the app has one
    }>;
    days?: Array<{
      id: number;
      date: Date | string;
      totalScreenTimeMs: number;
      apps: Array<{
        id: number;
        packageName: string;
        appName: string;
        totalTimeMs: number;
        iconUrl?: string | null;
      }>;
    }>;
  }>;
}

const { imei, screenTimeData = [] } = Astro.props;

// Serialize dates for JSON - handle both Date objects and strings
const serializedData = screenTimeData.map((week) => {
  // Handle weekStartDate
  let weekStartDate = week.weekStartDate;
  if (weekStartDate instanceof Date) {
    weekStartDate = weekStartDate.toISOString();
  } else if (typeof weekStartDate === "string") {
    // Already a string, keep it
  } else if (weekStartDate) {
    // Try to convert if it's a different format
    weekStartDate = new Date(weekStartDate).toISOString();
  }

  // Handle weekEndDate
  let weekEndDate = week.weekEndDate;
  if (weekEndDate instanceof Date) {
    weekEndDate = weekEndDate.toISOString();
  } else if (typeof weekEndDate === "string") {
    // Already a string
  } else if (weekEndDate) {
    weekEndDate = new Date(weekEndDate).toISOString();
  }

  // Handle syncedAt
  let syncedAt = week.syncedAt;
  if (syncedAt instanceof Date) {
    syncedAt = syncedAt.toISOString();
  } else if (typeof syncedAt === "string") {
    // Already a string
  } else if (syncedAt) {
    syncedAt = new Date(syncedAt).toISOString();
  }

  return {
    ...week,
    weekStartDate,
    weekEndDate,
    syncedAt,
    apps: (week.apps || [])
      .filter((app) => (app.totalTimeMs || 0) >= 60 * 1000) // only show apps with >= 1 minute
      .map((app) => {
        let appWeekStartDate = app.weekStartDate;
        if (appWeekStartDate instanceof Date) {
          appWeekStartDate = appWeekStartDate.toISOString();
        } else if (typeof appWeekStartDate === "string") {
          // Already a string
        } else if (appWeekStartDate) {
          appWeekStartDate = new Date(appWeekStartDate).toISOString();
        }
        return {
          ...app,
          weekStartDate: appWeekStartDate
        };
      }),
    days: (week.days || []).map((day) => {
      let dayDate = day.date;
      if (dayDate instanceof Date) {
        dayDate = dayDate.toISOString();
      } else if (typeof dayDate === "string") {
        // Already a string
      } else if (dayDate) {
        dayDate = new Date(dayDate).toISOString();
      }
      return {
        ...day,
        date: dayDate,
        apps: (day.apps || []).filter((app) => (app.totalTimeMs || 0) >= 60 * 1000) // only show apps with >= 1 minute
      };
    })
  };
});
---

<div
  class="bg-[#F6F5F2] rounded-lg p-6 w-full"
  x-data={`{
    currentWeekIndex: 0,
    selectedDayIndex: 6,
    showAllApps: false,
    screenTimeData: ${JSON.stringify(serializedData)},
    isLoading: ${serializedData.length === 0},
    imei: ${JSON.stringify(imei)},
    async init() {
      // Device stats API call disabled — data comes from the page
      this.isLoading = false;
      this.selectDefaultDay();
    },
    // Week and day dates are stored as UTC midnight, so read them in UTC
    toIsoDate(value) {
      return new Date(value).toISOString().slice(0, 10);
    },
    formatDuration(ms) {
      if (!ms || ms <= 0) return "0m";
      const totalMinutes = Math.round(ms / 60000);
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      if (hours > 0) return hours + "h" + (minutes > 0 ? " " + minutes + "m" : "");
      return minutes + "m";
    },
    formatShortDate(value) {
      return new Date(value).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
    },
    get currentWeek() {
      if (!this.screenTimeData || this.screenTimeData.length === 0) return null;
      return this.screenTimeData[this.currentWeekIndex] || null;
    },
    get weekLabel() {
      if (!this.currentWeek) return "";
      return this.formatShortDate(this.currentWeek.weekStartDate) + " – " + this.formatShortDate(this.currentWeek.weekEndDate);
    },
    get weekDates() {
      if (!this.currentWeek) return [];
      const start = new Date(this.toIsoDate(this.currentWeek.weekStartDate) + "T00:00:00.000Z");
      return Array.from({ length: 7 }, (_, i) => {
        const date = new Date(start);
        date.setUTCDate(start.getUTCDate() + i);
        return date;
      });
    },
    get dayLabels() {
      const labels = ["S", "M", "T", "W", "T", "F", "S"];
      return this.weekDates.map((date) => labels[date.getUTCDay()]);
    },
    get dailyTimes() {
      if (!this.currentWeek) return [];
      const days = this.currentWeek.days || [];
      if (days.length > 0) {
        const byDate = new Map(days.map((day) => [this.toIsoDate(day.date), day.totalScreenTimeMs || 0]));
        return this.weekDates.map((date) => byDate.get(date.toISOString().slice(0, 10)) || 0);
      }
      // No daily breakdown: fall back to the average for every day
      if (!this.currentWeek.dailyAverageMs) return [];
      return Array(7).fill(this.currentWeek.dailyAverageMs);
    },
    get maxTime() {
      if (this.dailyTimes.length === 0) return 0;
      return Math.max(...this.dailyTimes, this.currentWeek?.dailyAverageMs || 0);
    },
    get hasChartData() {
      return this.dailyTimes.length > 0 && this.maxTime > 0;
    },
    get averagePercent() {
      if (!this.hasChartData || !this.currentWeek?.dailyAverageMs) return null;
      return (this.currentWeek.dailyAverageMs / this.maxTime) * 100;
    },
    barPercent(time) {
      return this.maxTime > 0 ? (time / this.maxTime) * 100 : 0;
    },
    get dailyAverageFormatted() {
      return this.formatDuration(this.currentWeek?.dailyAverageMs || 0);
    },
    // Select the most recent day that has usage (falls back to the last day)
    selectDefaultDay() {
      const times = this.dailyTimes;
      let index = times.length - 1;
      while (index > 0 && !times[index]) index--;
      this.selectedDayIndex = Math.max(index, 0);
    },
    get weekApps() {
      if (!this.currentWeek || !this.currentWeek.apps) return [];
      return this.currentWeek.apps
        .filter((app) => (app.totalTimeMs || 0) > 0)
        .sort((a, b) => (b.totalTimeMs || 0) - (a.totalTimeMs || 0));
    },
    get visibleApps() {
      return this.showAllApps ? this.weekApps : this.weekApps.slice(0, 4);
    },
    appBarPercent(app) {
      const top = this.weekApps.length > 0 ? this.weekApps[0].totalTimeMs || 0 : 0;
      return top > 0 ? ((app.totalTimeMs || 0) / top) * 100 : 0;
    },
    appInitial(app) {
      return ((app.appName || app.packageName || "?").trim().charAt(0) || "?").toUpperCase();
    },
    changeWeek(index) {
      this.currentWeekIndex = index;
      this.showAllApps = false;
      this.selectDefaultDay();
    },
    prevWeek() {
      if (this.currentWeekIndex < this.screenTimeData.length - 1) this.changeWeek(this.currentWeekIndex + 1);
    },
    nextWeek() {
      if (this.currentWeekIndex > 0) this.changeWeek(this.currentWeekIndex - 1);
    }
  }`}
  x-show="!isLoading"
  x-cloak
>
  <!-- Content - only visible when there is data -->
  <template x-if="screenTimeData.length > 0">
    <div class="bg-white rounded-lg border border-gray-200 p-6 w-full">
      <!-- Header: title + week caption, week navigation -->
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 leading-tight">Screen Time</h3>
          <p class="text-sm text-gray-500 mt-0.5">
            Week <span x-text="screenTimeData.length - currentWeekIndex"></span> of
            <span x-text="screenTimeData.length"></span>
          </p>
        </div>
        <div class="flex items-center gap-1">
          <button
            type="button"
            class="p-1.5 rounded text-gray-600 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
            aria-label="Previous week"
            @click="prevWeek()"
            :disabled="currentWeekIndex >= screenTimeData.length - 1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <span class="text-sm text-gray-700 whitespace-nowrap px-1" x-text="weekLabel"></span>
          <button
            type="button"
            class="p-1.5 rounded text-gray-600 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
            aria-label="Next week"
            @click="nextWeek()"
            :disabled="currentWeekIndex <= 0"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Daily average -->
      <div class="mt-5">
        <p class="text-3xl font-bold text-gray-900 tracking-tight" x-text="dailyAverageFormatted"></p>
        <div class="flex items-center gap-2 mt-1">
          <span class="w-4 border-t-2 border-dashed border-[#C17F59]" aria-hidden="true"></span>
          <span class="text-sm text-gray-500">Daily average</span>
        </div>
      </div>

      <!-- Daily bar chart -->
      <div class="mt-6">
        <div class="relative h-48 pt-6 border-b border-gray-200">
          <!-- No data message -->
          <div class="absolute inset-0 flex items-center justify-center" x-show="!hasChartData">
            <p class="text-sm text-gray-500">No app usage data available</p>
          </div>

          <div class="relative h-full" x-show="hasChartData">
            <!-- Daily average line -->
            <div
              class="absolute left-0 right-0 border-t-2 border-dashed border-[#C17F59] z-20 pointer-events-none"
              x-show="averagePercent !== null"
              :style="`bottom: ${averagePercent}%;`"
            ></div>

            <!-- Bars -->
            <div class="absolute inset-0 flex items-end gap-1.5">
              <template x-for="(time, index) in dailyTimes" :key="index">
                <button
                  type="button"
                  class="relative flex-1 h-full flex items-end focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-t"
                  :aria-label="`${dayLabels[index]}: ${formatDuration(time)}`"
                  :aria-pressed="selectedDayIndex === index"
                  @click="selectedDayIndex = index"
                >
                  <!-- Every day's total, floating above its bar; the selected day is emphasised -->
                  <span
                    class="absolute left-1/2 -translate-x-1/2 mb-1 text-[11px] sm:text-xs whitespace-nowrap z-30"
                    :class="selectedDayIndex === index ? 'font-semibold text-gray-900' : 'font-medium text-gray-500'"
                    :style="`bottom: ${barPercent(time)}%;`"
                    x-text="formatDuration(time)"
                  ></span>
                  <div
                    class="w-full rounded-t-md bg-[#17B8A6] transition-opacity"
                    :class="selectedDayIndex === index ? 'opacity-100' : 'opacity-30 hover:opacity-50'"
                    :style="`height: ${barPercent(time)}%; min-height: ${time > 0 ? '2px' : '0'};`"
                  ></div>
                </button>
              </template>
            </div>
          </div>
        </div>

        <!-- Day letters -->
        <div class="flex gap-1.5 mt-2" x-show="hasChartData">
          <template x-for="(label, index) in dayLabels" :key="index">
            <span
              class="flex-1 text-center text-xs"
              :class="selectedDayIndex === index ? 'font-bold text-gray-900' : 'text-gray-500'"
              x-text="label"
            ></span>
          </template>
        </div>
      </div>

      <!-- Weekly app usage -->
      <div class="mt-6">
        <div class="flex items-baseline justify-between mb-3">
          <h4 class="text-sm font-semibold text-gray-900">Weekly App Usage</h4>
          <span
            class="text-xs text-gray-500"
            x-show="weekApps.length > 0"
            x-text="weekApps.length + (weekApps.length === 1 ? ' app' : ' apps')"
          ></span>
        </div>

        <p class="text-sm text-gray-500" x-show="weekApps.length === 0">No app usage this week</p>

        <div class="space-y-3">
          <template x-for="app in visibleApps" :key="app.packageName || app.appName">
            <div class="grid grid-cols-[2rem_1fr] gap-x-3 items-center">
              <div
                class="w-8 h-8 rounded-md flex items-center justify-center overflow-hidden row-span-2"
                :class="app.iconUrl ? 'bg-transparent' : 'bg-gray-200'"
              >
                <img
                  x-show="app.iconUrl"
                  :src="app.iconUrl"
                  :alt="app.appName"
                  class="w-8 h-8 object-cover"
                  loading="lazy"
                  @error="app.iconUrl = null"
                />
                <span
                  x-show="!app.iconUrl"
                  class="text-sm font-semibold text-gray-600"
                  x-text="appInitial(app)"
                ></span>
              </div>
              <div class="flex items-baseline justify-between gap-3 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate" x-text="app.appName"></p>
                <span class="text-sm text-gray-600 whitespace-nowrap" x-text="formatDuration(app.totalTimeMs)"></span>
              </div>
              <div class="mt-1 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                <div class="h-full bg-gray-400 rounded-full" :style="`width: ${appBarPercent(app)}%`"></div>
              </div>
            </div>
          </template>
        </div>

        <button
          type="button"
          class="mt-4 text-sm font-semibold text-[#17B8A6] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded"
          x-show="weekApps.length > 4"
          @click="showAllApps = !showAllApps"
          x-text="showAllApps ? 'Show less' : 'Show all ' + weekApps.length"
        ></button>
      </div>
    </div>
  </template>

  <!-- Empty State - only visible when not loading and no data -->
  <template x-if="screenTimeData.length === 0">
    <div class="bg-white rounded-lg border border-gray-200 p-6 w-full">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Screen Time</h3>
      <div class="text-center py-16 min-h-[400px] flex flex-col items-center justify-center">
        <p class="text-sm text-gray-500">Screen time data is not available yet</p>
      </div>
    </div>
  </template>
</div>

<script>
  import { devLog } from "@/libs/utils";
  // Make devLog available globally for Alpine.js inline expressions
  if (typeof window !== "undefined") {
    (window as any).devLog = devLog;
  }
</script>
