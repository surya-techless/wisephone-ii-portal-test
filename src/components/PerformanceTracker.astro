---
// src/components/PerformanceTracker.astro
// Tracks and logs page load performance metrics
---

<script>
  if (typeof window !== 'undefined') {
    // Wait for page to fully load
    window.addEventListener('load', () => {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming;
      const paint = performance.getEntriesByType('paint') as PerformancePaintTiming[];

      const fcp = paint.find((p) => p.name === 'first-contentful-paint');

      const metrics = {
        // Core Web Vitals
        'First Contentful Paint (FCP)': fcp ? `${Math.round(fcp.startTime)}ms` : 'N/A',
        'Time to First Byte (TTFB)': `${Math.round(navigation.responseStart - navigation.requestStart)}ms`,
        'DOM Content Loaded': `${Math.round(navigation.domContentLoadedEventEnd - navigation.fetchStart)}ms`,
        'Page Load': `${Math.round(navigation.loadEventEnd - navigation.fetchStart)}ms`,

        // Timing Breakdown
        'DNS Lookup': `${Math.round(navigation.domainLookupEnd - navigation.domainLookupStart)}ms`,
        'TCP Connection': `${Math.round(navigation.connectEnd - navigation.connectStart)}ms`,
        'TLS Handshake':
          navigation.secureConnectionStart > 0
            ? `${Math.round(navigation.connectEnd - navigation.secureConnectionStart)}ms`
            : 'N/A',
        'Server Response': `${Math.round(navigation.responseEnd - navigation.requestStart)}ms`,
        'DOM Processing': `${Math.round(navigation.domComplete - navigation.domInteractive)}ms`,

        // Total
        'Total Load Time': `${Math.round(navigation.loadEventEnd - navigation.navigationStart)}ms`
      };

      // Log metrics in a readable format
      console.group('📊 Page Performance Metrics');
      console.table(metrics);
      console.groupEnd();

      // Warn if page load is slow (> 3 seconds)
      const totalTime = navigation.loadEventEnd - navigation.navigationStart;
      if (totalTime > 3000) {
        console.warn(`⚠️ Slow page load detected: ${Math.round(totalTime)}ms (> 3s threshold)`);
      }

      // Check for slow resources
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const slowResources = resources
        .filter((r) => r.duration > 1000)
        .map((r) => ({
          name: r.name.split('/').pop() || r.name,
          duration: `${Math.round(r.duration)}ms`,
          size: r.transferSize ? `${Math.round(r.transferSize / 1024)}KB` : 'N/A'
        }));

      if (slowResources.length > 0) {
        console.group('⚠️ Slow Loading Resources (>1s)');
        console.table(slowResources);
        console.groupEnd();
      }

      // Optional: Send to analytics (uncomment if you have analytics)
      // if (window.gtag) {
      //   gtag('event', 'page_load_time', {
      //     value: Math.round(totalTime),
      //     event_category: 'Performance'
      //   });
      // }
    });
  }
</script>

