---
import { UserButton } from "@clerk/astro/components";
import IsAdmin from "@/components/server-islands/IsAdmin.astro";
import WisephoneLogo from "@/components/WisephoneLogo.astro";
import Icon from "astro-iconify";
---

<header class="flex flex-col w-full gap-6 not-prose">
  <div class="grid grid-cols-2">
    <a href="/dashboard">
      <WisephoneLogo class="h-8 text-[var(--charcoal)]" />
    </a>

    <div class="flex items-center self-center gap-2 justify-self-end">
      <IsAdmin server:defer>
        <a href="/dashboard/admin" class="btn btn-sm btn-ghost btn-circle">
          <Icon name="lucide:shield-ellipsis" class="w-5 h-5" />
        </a>
      </IsAdmin>
      <div class="relative w-8 h-8 rounded-full bg-slate-200">
        <div
          x-cloak
          x-show="visible"
          x-data="{ visible: false }"
          x-init="setTimeout(() => visible = true, 250)"
          x-transition.opacity
          x-transition.duration.500ms
          class="absolute top-[2px] left-[2px] right-[2px] bottom-[2px]"
        >
          <UserButton />
        </div>
      </div>
    </div>
  </div>
</header>
