---
import type { ActionError } from "astro:actions";

const { actionResult } = Astro.props;

const errorMessage = [actionResult?.error || ""].filter(Boolean).join("\n");
const successMessage = [actionResult?.data?.success || ""].filter(Boolean).join("\n");
---

<div
  x-data={`{
    init() {
      if (${Boolean(errorMessage)}) {
        toastErrorMessage = \`${(errorMessage || "").replace(/"/g, '\\"')}\`;
      }

      if (${Boolean(successMessage)}) {
        toastMessage = \`${(successMessage || "").replace(/"/g, '\\"')}\`;
      }

      $el.remove();
    }
  }`}
>
</div>
