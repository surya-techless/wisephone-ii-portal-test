---
import Logo from "@/components/Logo.astro";
import { Icon } from "astro-iconify";
interface Props {
  showLogo?: boolean;
}

const { showLogo = true } = Astro.props as Props;
---

<footer class="not-prose text-center text-sm py-0 my-0 flex flex-col gap-2">
  {
    showLogo ? (
      <a href="/" class="flex justify-center">
        <Logo classList="opacity-20 hover:opacity-100 transition-opacity duration-500" />
      </a>
    ) : null
  }

  <ul class="list-none p-0 m-0 flex items-center gap-0 justify-center">
    <li>
      <a class="btn btn-xs btn-ghost" href="https://getwisephone.com/my-subscription" target="_blank">
        Subscription
        <Icon name="lucide:external-link" class="w-3 h-3 opacity-50" />
      </a>
    </li>
    <li>
      <a class="btn btn-xs text-slate-800 btn-ghost" href="https://plans.techless.com/" target="_blank">
        Carrier Plan
        <Icon name="lucide:external-link" class="w-3 h-3 opacity-50" />
      </a>
    </li>
    <li>
      <a class="btn btn-xs text-slate-800 btn-ghost" href="https://getwisephone.com/start">
        Activation Guide
        <Icon name="lucide:external-link" class="w-3 h-3 opacity-50" />
      </a>
    </li>
  </ul>

  <p class="py-0 mb-0 opacity-50">
    Wisephone, by Techless LLC © <span x-text="new Date().getFullYear()">2025</span>
  </p>
  <ul class="list-none opacity-50 p-0 m-0 flex gap-3 flex-wrap justify-center">
    <li>
      <a class="text-inherit font-normal" href="https://wisephone.com/policies/terms-of-service" target="_blank"
        >Terms</a
      >
    </li>
    <li>
      <a class="text-inherit font-normal" href="https://wisephone.com/policies/privacy-policy" target="_blank"
        >Privacy</a
      >
    </li>
    <li>
      <a class="text-inherit font-normal" href="https://techless.notion.site" target="_blank">Help Docs</a>
    </li>
    <li>
      <a class="text-inherit font-normal" href="https://techless.zendesk.com/hc/en-us/requests/new" target="_blank"
        >Support</a
      >
    </li>
    <li>
      <a class="text-inherit font-normal" href="https://getwisephone.com/updates" target="_blank">What's New</a>
    </li>
  </ul>
</footer>
