---
import { SEO } from "astro-seo";
import Icon from "astro-iconify";
import "@/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClasses?: string;
  canonicalUrl?: string;
  faviconUrl?: string;
  ogImageUrl?: string;
}

const message = Astro.url.searchParams.get("message") || Astro.url.searchParams.get("success") || "";
const error = Astro.url.searchParams.get("error") || "";

const {
  title,
  description = "Equipping believers with technology to help them live their God-given calling every single day, together",
  bodyClasses,
  canonicalUrl,
  faviconUrl,
  ogImageUrl = "/og-image.png"
} = Astro.props;
---

<!doctype html>
<html
  x-data={`{
    toastMessage: \`${message}\`,
    toastErrorMessage: \`${error}\`,
    init() {
      if (this.toastMessage || this.toastErrorMessage) {
        history.replaceState({}, '', window.location.pathname);
      }
    }
  }`}
  lang="en"
  class="min-h-screen bg-[var(--surface-secondary)]"
>
  <!-- "For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life." John 3:16 NIV -->
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || title} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <slot name="head" />

    <SEO
      charset="utf-8"
      title={title}
      description={description}
      canonical={canonicalUrl || Astro.url}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: ogImageUrl
        },
        optional: {
          description: description
        }
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: ogImageUrl,
        site: canonicalUrl || Astro.url.href,
        imageAlt: description
      }}
      extend={{
        link: [
          {
            rel: "icon",
            href: faviconUrl || "/favicon.svg",
            type: faviconUrl ? "image/png" : "image/svg+xml"
          }
          // {
          //   rel: "apple-touch-icon",
          //   href: "/apple-touch-icon.png"
          // }
        ]
      }}
    />
  </head>

  <body class={`!max-w-[100vw] h-full w-full ${bodyClasses}`}>
    <div
      x-data={`{
        backupOfToastMessage: '',
        init() {
          if (toastMessage) {
            this.backupOfToastMessage = toastMessage;
            setTimeout(() => toastMessage = '', 5000);
          }

          $watch('toastMessage', () => {
            if (toastMessage) {
              this.backupOfToastMessage = toastMessage;
              setTimeout(() => toastMessage = '', 5000);
            }
          })
        }
      }`}
      x-cloak
      x-show="toastMessage"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform -translate-y-2"
      x-transition:enter-end="opacity-100 transform translate-y-0"
      x-transition:leave="transition ease-in duration-300"
      x-transition:leave-start="opacity-100 transform translate-y-0"
      x-transition:leave-end="opacity-0 transform -translate-y-2"
      class="z-50 w-full max-w-sm toast toast-top toast-center"
    >
      <div
        role="alert"
        class="max-w-sm w-full shadow-lg alert alert-info bg-white border-[#5EA59A] text-[var(--charcoal)]"
        style="border-width: 2px;"
      >
        <Icon pack="lucide" name="check-circle" height={20} width={20} class="shrink-0" />
        <span class="inline-block w-full p-0 m-0 text-wrap" x-text="backupOfToastMessage || '-'"></span>
      </div>
    </div>

    <div
      x-data={`{
        backupOfToastErrorMessage: '',
        init() {
          if (toastErrorMessage) {
            this.backupOfToastErrorMessage = toastErrorMessage;
            setTimeout(() => toastErrorMessage = '', 5000);
          }

          $watch('toastErrorMessage', () => {
            if (toastErrorMessage) {
              this.backupOfToastErrorMessage = toastErrorMessage;
              setTimeout(() => toastErrorMessage = '', 5000);
            }
          })
        }
      }`}
      x-cloak
      x-show="toastErrorMessage"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform -translate-y-2"
      x-transition:enter-end="opacity-100 transform translate-y-0"
      x-transition:leave="transition ease-in duration-300"
      x-transition:leave-start="opacity-100 transform translate-y-0"
      x-transition:leave-end="opacity-0 transform -translate-y-2"
      class="z-50 w-full max-w-sm toast toast-top toast-center"
    >
      <div
        role="alert"
        class="max-w-sm w-full grid grid-cols-[auto_1fr] gap-2 shadow-lg alert alert-error bg-red-100 border-red-200 text-red-900"
      >
        <Icon pack="lucide" name="octagon-alert" height={20} width={20} class="shrink-0" />
        <p class="inline-block w-full p-0 m-0 text-wrap" x-text="backupOfToastErrorMessage || '-'" class="w-full"></p>
      </div>
    </div>

    <div class="h-full">
      <slot />
    </div>

  </body>
</html>

<script>
  import Alpine from "alpinejs";
  // @ts-ignore - Has no associated types.
  import intersect from "@alpinejs/intersect";
  // @ts-ignore - Has no associated types.
  import persist from "@alpinejs/persist";
  // @ts-ignore - Has no associated types.
  import collapse from "@alpinejs/collapse";
  // @ts-ignore - Has no associated types.
  import mask from "@alpinejs/mask";
  // @ts-ignore - Has no associated types.
  import focus from "@alpinejs/focus";

  Alpine.plugin(intersect);
  Alpine.plugin(persist);
  Alpine.plugin(collapse);
  Alpine.plugin(mask);
  Alpine.plugin(focus);

  window.Alpine = Alpine;
  // Defer start so page-level Alpine.data() registrations (e.g. dashboard) run first
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => Alpine.start());
  } else {
    setTimeout(() => Alpine.start(), 0);
  }

  // Auth error popup — injected into .modal-box (the white card) so it overlays the form.
  // Not embedded in SignInSignUpModal.astro; driven by the auth-modal-error custom event.
  let _authErrorTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener("auth-modal-error", (e: Event) => {
    const message = (e as CustomEvent<{ message: string }>).detail?.message || "Something went wrong.";
    const dialog = document.getElementById("auth-modal") as HTMLDialogElement | null;
    if (!dialog) return;
    // Target the white card so position:absolute covers it, not the flex dialog shell
    const modalBox = dialog.querySelector<HTMLElement>(".modal-box") ?? dialog;

    let popup = modalBox.querySelector<HTMLElement>("#auth-error-overlay");
    if (!popup) {
      // Ensure the card is a positioning context
      if (getComputedStyle(modalBox).position === "static") modalBox.style.position = "relative";

      popup = document.createElement("div");
      popup.id = "auth-error-overlay";
      popup.style.cssText = [
        "position:absolute",
        "inset:0",
        "display:flex",
        "align-items:center",
        "justify-content:center",
        "pointer-events:none",
        "z-index:50",
        "border-radius:inherit",
        "background:rgba(255,255,255,0.55)",
        "backdrop-filter:blur(2px)",
      ].join(";");
      popup.innerHTML = `
        <div style="pointer-events:auto;display:flex;align-items:center;gap:12px;
          background:#fff1f2;border:1.5px solid #fca5a5;color:#7f1d1d;
          border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.18);
          padding:14px 20px;max-width:320px;width:calc(100% - 48px);
          font-size:14px;font-weight:500;line-height:1.4;">
          <svg xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;color:#ef4444" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 100 18A9 9 0 0012 3z"/>
          </svg>
          <span id="auth-error-overlay-text"></span>
        </div>`;
      modalBox.appendChild(popup);
    }

    const textEl = popup.querySelector<HTMLElement>("#auth-error-overlay-text");
    if (textEl) textEl.textContent = message;

    popup.style.opacity = "0";
    popup.style.transition = "opacity 0.15s ease";
    requestAnimationFrame(() => { popup!.style.opacity = "1"; });

    if (_authErrorTimer) clearTimeout(_authErrorTimer);
    _authErrorTimer = setTimeout(() => {
      if (popup) {
        popup.style.opacity = "0";
        setTimeout(() => popup?.remove(), 160);
      }
      _authErrorTimer = null;
    }, 3000);
  });
</script>
